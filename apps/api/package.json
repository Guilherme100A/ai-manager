{
  "name": "@wsm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/index.ts src/server.ts --format esm --target node20 --platform node --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@wsm/core": "workspace:*",
    "@wsm/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "4.13.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
