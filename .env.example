# Copie para .env e preencha. Nunca versione valores reais.

# PostgreSQL / Redis (valores de desenvolvimento local)
DATABASE_URL=postgres://wsm:wsm@127.0.0.1:5432/wsm
REDIS_URL=redis://127.0.0.1:6379

# Token Bearer da API (gere um valor aleatório longo)
API_TOKEN=change-me
# Chave de cifragem das credenciais do WhatsApp: 32 bytes em base64 (ex.: openssl rand -base64 32)
CREDENTIALS_KEY=change-me-32-bytes-base64

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# IA (opcional)
AI_PROVIDER_API_KEY=
AI_MODEL_SMALL=claude-haiku-4-5-20251001
AI_MODEL_LARGE=claude-sonnet-5

# Alertas por e-mail (opcional), ex.: smtp://user:pass@smtp.example.com:587
SMTP_URL=

# T10 — cronograma de warm-up (defaults do baileys-antiban)
WARMUP_DAYS=7
WARMUP_DAY1_LIMIT=20
WARMUP_GROWTH_FACTOR=1.8

# T11 — janela de deduplicação de alertas por (evento, sessão), em ms (default 10 min)
ALERT_DEDUP_MS=600000

# T09 — antiban (baileys-antiban). ANTIBAN_MODE=real (default) | passthrough (SOMENTE testes).
# ANTIBAN_PRESET=conservative (default) | moderate | aggressive | high-volume.
ANTIBAN_MODE=real
ANTIBAN_PRESET=conservative

# T13 — roteador da IA: large só quando a confiança do small < limiar; limite de tokens e timeout por chamada
AI_CONFIDENCE_THRESHOLD=0.6
AI_MAX_TOKENS=512
AI_TIMEOUT_MS=10000

# T16 — ponte API ↔ worker (rede interna do compose) e transporte do worker
INTERNAL_TOKEN=change-me-internal
WORKER_INTERNAL_URL=http://localhost:9465
# baileys (produção) | fake (somente testes; expõe /internal/fake/*)
WA_TRANSPORT=baileys
WORKER_HEALTH_PORT=9464
WORKER_INTERNAL_PORT=9465

# T17 — login de administrador do painel. Defina ADMIN_PASSWORD e AUTH_SECRET em produção.
# Sem ADMIN_PASSWORD vale a senha padrão (nimda); sem AUTH_SECRET os tokens de login caem a cada restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 32+ bytes aleatórios, ex.: openssl rand -base64 32
AUTH_SECRET=
# Validade do token de login (ms). Default: 12 h.
AUTH_SESSION_TTL_MS=43200000
# Confiar em X-Forwarded-For para o IP do limite de tentativas de login. Só use true se a API estiver atrás de
# um proxy reverso que SOBRESCREVE o header (o nginx do dashboard faz isso) e não for acessível diretamente.
TRUST_PROXY=false

# T19 — configurações do LLM pelo painel (tabela ai_settings; o banco vence o ambiente campo a campo).
# AI_ENABLED=false desliga as chamadas ao provedor (só o fallback determinístico).
AI_ENABLED=true
# Validade (ms) da configuração lida pelo worker; mudanças no painel valem sem restart. 0 = relê a cada mensagem.
AI_SETTINGS_REFRESH_MS=5000

# Conversas entre contas: contas sem configuração salva entram sozinhas no rodízio automático.
# false = só participam as contas ativadas manualmente no painel.
CONVERSATIONS_AUTO_ROTATE=true
# Grupos: false (padrão) = entrada automática só quando ativada no painel; true = contas novas já vêm ativas.
GROUP_AUTOMATION_AUTO_ENABLE=false
