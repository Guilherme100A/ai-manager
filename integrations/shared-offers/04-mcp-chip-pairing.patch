@@ -0,0 +1,194 @@
+/* eslint-disable @typescript-eslint/no-explicit-any -- protocol responses */
+import { randomBytes } from 'node:crypto'
+import { and, eq } from 'drizzle-orm'
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest'
+import { auditLogs, connections, createDb, type Database } from '@crm/db'
+import { createTempDatabase, type TempDatabase } from '@crm/db/testing'
+import { createCipher, createLogger, generateCredentialsKey, MemoryMailer, redisConnection } from '@crm/node-kit'
+import { FakeWaGateway } from '@crm/wa-port/testing'
+import { createApp, type RedisClient } from '../../app'
+
+let temp: TempDatabase, db: Database, redis: RedisClient, app: ReturnType<typeof createApp>
+const gateway = new FakeWaGateway()
+const H = { 'content-type': 'application/json', 'x-requested-with': 'crm' }
+const rnd = () => randomBytes(6).toString('hex')
+type Session = { cookie: string; companyId: string }
+let seq = 0
+beforeAll(async () => {
+  temp = await createTempDatabase({ migrate: true })
+  db = createDb(temp.url, { max: 8 })
+  redis = redisConnection({ url: process.env.REDIS_URL ?? 'redis://127.0.0.1:6379/1' })
+  app = createApp({ db, redis, waGateway: gateway, waProfile: 'ai-manager', mailer: new MemoryMailer(), trustProxy: true, logger: createLogger({ level: 'silent' }), credentialsCipher: createCipher({ key: generateCredentialsKey() }), mcpEnv: { API_PUBLIC_URL: 'https://api.example.test' } })
+}, 120000)
+afterAll(async () => { gateway.reset(); redis?.disconnect(); await db?.$client.end(); await temp?.drop() })
+async function tenant(): Promise<Session> {
+  const email = `chip-${rnd()}@example.test`, ip = { 'x-forwarded-for': `10.91.${Math.floor(Math.random() * 250)}.${Math.floor(Math.random() * 250)}` }
+  const reg = await app.request('/api/auth/register', { method: 'POST', headers: { ...H, ...ip }, body: JSON.stringify({ name: 'Chip owner', email, password: '12345678', password_confirmation: '12345678' }) })
+  expect(reg.status).toBe(201)
+  const data = await reg.json() as any
+  const login = await app.request('/api/auth/login', { method: 'POST', headers: { ...H, ...ip }, body: JSON.stringify({ email, password: '12345678' }) })
+  expect(login.status).toBe(200)
+  return { cookie: /crm_session=[^;]+/.exec(login.headers.get('set-cookie') ?? '')![0], companyId: data.user.last_company_id }
+}
+async function call(s: Session, method: string, path: string, body?: unknown) {
+  const r = await app.request(path, { method, headers: { ...H, cookie: s.cookie }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) })
+  return { status: r.status, data: await r.json() as any }
+}
+async function credential(s: Session, access: 'read' | 'write') {
+  const r = await call(s, 'POST', '/api/mcp_credentials', { name: 'chip tests', access })
+  expect(r.status).toBe(201)
+  return r.data as { token: string; mcp_credential: { id: string } }
+}
+async function rpc(token: string, method: string, params: unknown = {}) {
+  const r = await app.request('/api/mcp', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json, text/event-stream', 'mcp-protocol-version': '2025-06-18', authorization: 'Bearer ' + token }, body: JSON.stringify({ jsonrpc: '2.0', id: ++seq, method, params }) })
+  return { status: r.status, data: await r.json() as any }
+}
+const invoke = async (token: string, name: string, args: unknown) => (await rpc(token, 'tools/call', { name, arguments: args })).data
+const failed = (body: any) => !!body.error || body.result?.isError === true
+const metadata = (body: any) => JSON.parse(body.result.content[0].text)
+
+describe('MCP chip pairing through real authenticated API with fake gateway', () => {
+  it('write token initializes, creates chip with proxy and returns a PNG image; retry reuses it', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    expect((await rpc(c.token, 'initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'chip-test', version: '1' } })).status).toBe(200)
+    const args = { name: 'Chip MCP', proxy: 'proxy.example:10001:operator:proxy-password-secret', wait_seconds: 0 }
+    const result = await invoke(c.token, 'connect_chip', args)
+    expect(failed(result)).toBe(false)
+    expect(result.result.content[1]).toMatchObject({ type: 'image', mimeType: 'image/png' })
+    const info = metadata(result)
+    expect(info).toMatchObject({ status: 'qr_ready', created: true, pairing_only: true })
+    expect(info).not.toHaveProperty('qr_code')
+    expect(JSON.stringify(result)).not.toContain('proxy-password-secret')
+    const again = await invoke(c.token, 'connect_chip', args)
+    expect(failed(again)).toBe(false)
+    expect(metadata(again)).toMatchObject({ connection_id: info.connection_id, created: false })
+    const rows = await db.select().from(connections).where(eq(connections.companyId, s.companyId))
+    expect(rows).toHaveLength(1)
+    expect(rows[0]).toMatchObject({ proxyHost: 'proxy.example', proxyPort: 10001, requiresRestart: false })
+    expect(rows[0]!.proxyPasswordEnc).toBeTruthy()
+    expect(JSON.stringify(rows)).not.toContain('proxy-password-secret')
+    expect(JSON.stringify(await db.select().from(auditLogs).where(eq(auditLogs.companyId, s.companyId)))).not.toContain('proxy-password-secret')
+    const qr = await invoke(c.token, 'get_chip_qr', { connection_id: info.connection_id })
+    expect(failed(qr)).toBe(false)
+    expect(qr.result.content[1].type).toBe('image')
+  })
+  it('read token cannot see/call pairing or obtain the QR', async () => {
+    const s = await tenant(), c = await credential(s, 'read')
+    const list = await rpc(c.token, 'tools/list')
+    expect(list.data.result.tools.some((t: any) => ['connect_chip', 'get_chip_qr'].includes(t.name))).toBe(false)
+    expect(failed(await invoke(c.token, 'connect_chip', { name: 'Denied chip', direct: true }))).toBe(true)
+    expect(await db.select().from(connections).where(eq(connections.companyId, s.companyId))).toHaveLength(0)
+  })
+  it('foreign connection id is denied without gateway changes', async () => {
+    const a = await tenant(), b = await tenant()
+    const ca = await credential(a, 'write'), cb = await credential(b, 'write')
+    const made = await invoke(ca.token, 'connect_chip', { name: 'Private chip', direct: true, wait_seconds: 0 })
+    const id = metadata(made).connection_id
+    const spy = vi.spyOn(gateway.sessions, 'preparePairing')
+    expect(failed(await invoke(cb.token, 'connect_chip', { name: 'Private chip', connection_id: id }))).toBe(true)
+    expect(failed(await invoke(cb.token, 'get_chip_qr', { connection_id: id }))).toBe(true)
+    expect(spy).not.toHaveBeenCalled()
+    spy.mockRestore()
+  })
+  it('invalid proxy is redacted and does not create a session binding', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    const r = await invoke(c.token, 'connect_chip', { name: 'Bad proxy', proxy: 'ftp://u:secret-in-bad-proxy@proxy.example:21' })
+    expect(failed(r)).toBe(true)
+    expect(JSON.stringify(r)).not.toContain('secret-in-bad-proxy')
+    expect(await db.select().from(connections).where(eq(connections.companyId, s.companyId))).toHaveLength(0)
+  })
+  it('pending QR returns an id, then can be refreshed without another create', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    const spy = vi.spyOn(gateway.sessions, 'getQr').mockResolvedValue({ qr: null, generatedAt: null })
+    const r = await invoke(c.token, 'connect_chip', { name: 'Slow chip', direct: true, wait_seconds: 0 })
+    expect(metadata(r)).toMatchObject({ status: 'pending' })
+    expect(r.result.content).toHaveLength(1)
+    spy.mockRestore()
+    const qr = await invoke(c.token, 'get_chip_qr', { connection_id: metadata(r).connection_id })
+    expect(qr.result.content[1].type).toBe('image')
+  })
+  it('repeated callers do not duplicate the company connection', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    const results = await Promise.all([invoke(c.token, 'connect_chip', { name: 'One chip', direct: true, wait_seconds: 0 }), invoke(c.token, 'connect_chip', { name: 'One chip', direct: true, wait_seconds: 0 })])
+    expect(results.some(r => !failed(r))).toBe(true)
+    expect(await db.select().from(connections).where(and(eq(connections.companyId, s.companyId), eq(connections.name, 'One chip')))).toHaveLength(1)
+  })
+  it('a connected chip is never logged out or reconfigured and stale QR is not exposed', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    const made = metadata(await invoke(c.token, 'connect_chip', { name: 'Linked chip', direct: true, wait_seconds: 0 }))
+    await gateway.connect(made.session_id)
+    const prepare = vi.spyOn(gateway.sessions, 'preparePairing'), logout = vi.spyOn(gateway.sessions, 'logout')
+    const changed = await invoke(c.token, 'connect_chip', { name: 'Linked chip', proxy: 'http://proxy.example:8080', wait_seconds: 0 })
+    expect(failed(changed)).toBe(true)
+    const same = await invoke(c.token, 'connect_chip', { name: 'Linked chip', wait_seconds: 0 })
+    expect(metadata(same)).toMatchObject({ status: 'not_pairable', session_state: 'WARMING' })
+    expect(same.result.content).toHaveLength(1)
+    const qr = await invoke(c.token, 'get_chip_qr', { connection_id: made.connection_id })
+    expect(metadata(qr).status).toBe('not_pairable')
+    expect(qr.result.content).toHaveLength(1)
+    expect(prepare).not.toHaveBeenCalled()
+    expect(logout).not.toHaveBeenCalled()
+    prepare.mockRestore(); logout.mockRestore()
+  })
+  it('a preparation failure keeps the binding for a safe retry and redacts upstream errors', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    const spy = vi.spyOn(gateway.sessions, 'preparePairing').mockRejectedValueOnce(new Error('proxy-secret-must-never-escape'))
+    const args = { name: 'Retry chip', direct: true, wait_seconds: 0 }
+    const first = await invoke(c.token, 'connect_chip', args)
+    expect(failed(first)).toBe(true)
+    expect(JSON.stringify(first)).not.toContain('proxy-secret-must-never-escape')
+    const rows = await db.select().from(connections).where(eq(connections.companyId, s.companyId))
+    expect(rows).toHaveLength(1)
+    spy.mockRestore()
+    const retry = await invoke(c.token, 'connect_chip', args)
+    expect(metadata(retry)).toMatchObject({ connection_id: rows[0]!.id, created: false, status: 'qr_ready' })
+  })
+  it('restarts pairing on a disconnected chip without creating another connection', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    const args = { name: 'Reconnect chip', direct: true, wait_seconds: 0 }
+    const first = metadata(await invoke(c.token, 'connect_chip', args))
+    await gateway.setSessionState(first.session_id, 'DISCONNECTED')
+    const retry = metadata(await invoke(c.token, 'connect_chip', args))
+    expect(retry).toMatchObject({ connection_id: first.connection_id, status: 'qr_ready', created: false })
+  })
+  it('revocation prevents further MCP operation', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    expect((await call(s, 'DELETE', '/api/mcp_credentials/' + c.mcp_credential.id)).status).toBe(200)
+    expect((await rpc(c.token, 'tools/list')).status).toBe(401)
+  })
+  it('panel-only name collision is rejected without adoption, duplication or interrupting an active chip; explicit import reuses its exact session', async () => {
+    const s = await tenant(), c = await credential(s, 'write')
+    const panel = await gateway.sessions.create({ name: 'Panel-only unique chip' })
+    await gateway.connect(panel.id)
+    const before = await gateway.sessions.get(panel.id)
+    const create = vi.spyOn(gateway.sessions, 'create'), prepare = vi.spyOn(gateway.sessions, 'preparePairing'), logout = vi.spyOn(gateway.sessions, 'logout')
+    const collision = await invoke(c.token, 'connect_chip', { name: 'panel-ONLY UNIQUE chip', direct: true, wait_seconds: 0 })
+    expect(failed(collision)).toBe(true)
+    expect(JSON.stringify(collision)).toContain('CONFLICT')
+    expect(create).not.toHaveBeenCalled()
+    expect(prepare).not.toHaveBeenCalled()
+    expect(logout).not.toHaveBeenCalled()
+    expect(await db.select().from(connections).where(eq(connections.companyId, s.companyId))).toHaveLength(0)
+    expect(await gateway.sessions.get(panel.id)).toEqual(before)
+    const reader = await credential(s, 'read')
+    const available = await invoke(reader.token, 'list_importable_chips', {})
+    expect(metadata(available).items.some((i: any) => i.session_id === panel.id)).toBe(true)
+    expect(failed(await invoke(reader.token, 'import_panel_chips', { session_ids: [panel.id] }))).toBe(true)
+    expect(await db.select().from(connections).where(eq(connections.companyId, s.companyId))).toHaveLength(0)
+    const imported = await invoke(c.token, 'import_panel_chips', { session_ids: [panel.id] })
+    expect(failed(imported)).toBe(false)
+    expect(metadata(imported).items).toHaveLength(1)
+    const bound = metadata(imported).items[0]
+    expect(bound.session_id).toBe(panel.id)
+    const reused = await invoke(c.token, 'connect_chip', { name: bound.name, connection_id: bound.id, wait_seconds: 0 })
+    expect(metadata(reused)).toMatchObject({ connection_id: bound.id, session_id: panel.id, status: 'not_pairable' })
+    expect(create).not.toHaveBeenCalled()
+    expect(prepare).not.toHaveBeenCalled()
+    expect(logout).not.toHaveBeenCalled()
+    expect(await gateway.sessions.get(panel.id)).toEqual(before)
+    const other = await tenant(), outsider = await credential(other, 'write')
+    expect(failed(await invoke(outsider.token, 'import_panel_chips', { session_ids: [panel.id] }))).toBe(true)
+    expect(await db.select().from(connections).where(eq(connections.companyId, other.companyId))).toHaveLength(0)
+    create.mockRestore(); prepare.mockRestore(); logout.mockRestore()
+  })
+})
