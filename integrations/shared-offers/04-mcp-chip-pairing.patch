+import { describe, expect, it, vi } from 'vitest'
+import { parsePairingProxy } from '../../connections/pairing'
+import { connectionsTools, pairingResult } from './connections'
+import { registerApiTools, type McpApi } from './shared'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+
+const connectionId = '10000000-0000-4000-8000-000000000001'
+const png = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9ZV5sAAAAASUVORK5CYII='
+const ready = { connection_id: connectionId, session_id: 'session-1', name: 'Chip MCP', status: 'qr_ready', session_state: 'NEW', generated_at: '2026-11-17T12:00:00Z', qr_code: 'data:image/png;base64,' + png }
+
+describe('chip MCP: proxy and image contract', () => {
+  it.each(['http://operator:private-password@proxy.example:10001', 'proxy.example:10001:operator:private-password'])('parses supported proxy without logging credentials', input => {
+    expect(parsePairingProxy(input)).toEqual({ protocol: 'http', host: 'proxy.example', port: 10001, username: 'operator', password: 'private-password' })
+  })
+  it('supports socks5 and encoded password characters', () => {
+    expect(parsePairingProxy('socks5://u:p%40ss%3Aword@proxy.example:1080')).toMatchObject({ protocol: 'socks5', password: 'p@ss:word' })
+  })
+  it.each(['ftp://u:secret-value@proxy.example:21', 'http://u:secret-value@proxy.example:8080/path', 'host:99999:u:secret-value', 'http://host:80/?password=secret-value', 'host:80\nsecret-value'])('rejects invalid proxy with a redacted error', input => {
+    expect(() => parsePairingProxy(input)).toThrow()
+    try { parsePairingProxy(input) } catch (e) { expect(String(e)).not.toContain('secret-value') }
+  })
+  it('image content is returned separately; text and structured metadata exclude the QR', () => {
+    const result = pairingResult({ status: 200, body: ready })
+    expect(result.content[1]).toEqual({ type: 'image', data: png, mimeType: 'image/png' })
+    expect(result.content[0].text).not.toContain(png)
+    expect(JSON.stringify(result.structuredContent)).not.toContain(png)
+    expect(result.structuredContent).toMatchObject({ connection_id: connectionId, status: 'qr_ready' })
+  })
+  it('pending preserves the connection id without pretending an image exists', () => {
+    const result = pairingResult({ status: 200, body: { ...ready, status: 'pending', qr_code: null } })
+    expect(result.content).toHaveLength(1)
+    expect(result.structuredContent).toMatchObject({ connection_id: connectionId, status: 'pending' })
+  })
+  it('rejects malformed PNG without echoing data', () => {
+    const result = pairingResult({ status: 200, body: { ...ready, qr_code: 'data:image/png;base64,c2VjcmV0' } })
+    expect(result.isError).toBe(true)
+    expect(JSON.stringify(result)).not.toContain('c2VjcmV0')
+  })
+  it('API errors remain errors', () => expect(pairingResult({ status: 403, body: { error: { code: 'FORBIDDEN' } } }).isError).toBe(true))
+  it('read credentials only list importable chips; users without edit permission cannot register these tools', () => {
+    for (const [access, perms] of [['read', ['connections.edit']], ['write', ['connections.view']]] as const) {
+      const registerTool = vi.fn()
+      const api = { request: vi.fn() } as unknown as McpApi
+      const expected = access === 'read' ? ['list_importable_chips'] : []
+      expect(registerApiTools({ registerTool } as unknown as McpServer, { api, access, perms: new Set(perms) }, connectionsTools)).toEqual(expected)
+      expect(registerTool).toHaveBeenCalledTimes(expected.length)
+    }
+  })
+  it('write owner receives import and pairing tools with correct network annotation', () => {
+    const registerTool = vi.fn()
+    expect(registerApiTools({ registerTool } as unknown as McpServer, { api: { request: vi.fn() } as unknown as McpApi, access: 'write', perms: new Set(['connections.edit']) }, connectionsTools)).toEqual(['list_importable_chips', 'import_panel_chips', 'connect_chip', 'get_chip_qr'])
+    expect(registerTool.mock.calls.find(c => c[0] === 'connect_chip')?.[1].annotations).toMatchObject({ readOnlyHint: false, destructiveHint: false, openWorldHint: true })
+  })
+  it('explicit import forwards only selected session ids through the existing authenticated API', async () => {
+    const request = vi.fn(async () => ({ status: 201, body: { items: [{ id: connectionId, session_id: 'panel-a' }] } }))
+    const tool = connectionsTools.find(t => t.name === 'import_panel_chips')!
+    await tool.run({ session_ids: ['panel-a'] }, { request })
+    expect(request).toHaveBeenCalledExactlyOnceWith('POST', '/api/connections/import', { body: { session_ids: ['panel-a'] }, write: true })
+  })
+})
