+import { connections, type Database } from '@crm/db'
+import { getCredentialsCipher, serializeEncrypted } from '@crm/node-kit'
+import type { InlineProxyInput, SessionState } from '@crm/wa-port'
+import { and, eq, isNull, sql } from 'drizzle-orm'
+import { z } from 'zod'
+import { ConnectionsError } from './errors'
+import { ConnectionsService, type ConnectionsServiceOptions } from './service'
+
+const proxyObject = z.object({
+  protocol: z.enum(['http', 'https', 'socks5']),
+  host: z.string().trim().min(1).max(253).regex(/^[^\s/@?#]+$/),
+  port: z.number().int().min(1).max(65535),
+  username: z.string().max(255).nullable().optional(),
+  password: z.string().max(1024).nullable().optional(),
+}).strict()
+export const pairChipSchema = z.object({
+  name: z.string().trim().min(2).max(100),
+  connection_id: z.uuid().optional(),
+  proxy: z.union([z.string().trim().min(1).max(4096), proxyObject]).optional(),
+  direct: z.boolean().optional(),
+  wait_seconds: z.number().int().min(0).max(20).default(15),
+}).strict()
+export const chipQrWaitSchema = z.object({ wait_seconds: z.coerce.number().int().min(0).max(20).default(0) }).strict()
+type PairInput = z.infer<typeof pairChipSchema>
+const invalidProxy = () => new ConnectionsError('validation', 'Proxy inválida. Use URL http/https/socks5, host:porta:usuario:senha ou os campos estruturados; credenciais não são exibidas.')
+
+/** Parse credentials without ever including the input in errors or output. */
+export function parsePairingProxy(input: NonNullable<PairInput['proxy']>): InlineProxyInput {
+  try {
+    if (typeof input !== 'string') {
+      const p = proxyObject.parse(input)
+      return { ...p, username: p.username ?? null, password: p.password ?? null }
+    }
+    if ([...input].some(c => c.charCodeAt(0) < 32 || c.charCodeAt(0) === 127)) throw invalidProxy()
+    let value = input.trim()
+    if (!value.includes('://')) {
+      const [host, port, username, ...password] = value.split(':')
+      if (!host || !/^\d+$/.test(port ?? '') || (username !== undefined && password.length === 0)) throw invalidProxy()
+      const auth = username === undefined ? '' : `${encodeURIComponent(username)}:${encodeURIComponent(password.join(':'))}@`
+      value = `http://${auth}${host}:${port}`
+    }
+    const u = new URL(value)
+    if (u.pathname && u.pathname !== '/' || u.search || u.hash) throw invalidProxy()
+    return proxyObject.parse({ protocol: u.protocol.slice(0, -1), host: u.hostname, port: Number(u.port || (u.protocol === 'https:' ? 443 : u.protocol === 'http:' ? 80 : 1080)), username: u.username ? decodeURIComponent(u.username) : null, password: u.password ? decodeURIComponent(u.password) : null })
+  } catch { throw invalidProxy() }
+}
+
+export interface ChipPairingResult {
+  connection_id: string
+  session_id: string
+  name: string
+  status: 'qr_ready' | 'pending' | 'not_pairable' | 'disconnected'
+  session_state: SessionState
+  generated_at: string | null
+  qr_code: string | null
+  created?: boolean
+  pairing_only?: boolean
+}
+
+/** Company-bound connection setup. The gateway owns sockets, proxy encryption and persisted device profile. */
+export class ChipPairingService {
+  constructor(private readonly opts: ConnectionsServiceOptions) {}
+
+  async connect(companyId: string, raw: unknown, actorUserId: string | null): Promise<ChipPairingResult> {
+    const parsed = pairChipSchema.safeParse(raw)
+    if (!parsed.success) throw new ConnectionsError('validation', 'Nome, proxy ou opções de pareamento inválidos.')
+    const input = parsed.data
+    if (input.proxy !== undefined && input.direct) throw new ConnectionsError('validation', 'Informe proxy ou conexão direta, não ambos.')
+    const proxy = input.proxy !== undefined ? parsePairingProxy(input.proxy) : input.direct ? null : undefined
+    const prepare = this.opts.gateway.sessions.preparePairing?.bind(this.opts.gateway.sessions)
+    if (!prepare) throw new ConnectionsError('not_supported', 'O gateway não oferece preparação segura de pareamento.')
+
+    // One company-level transaction lock prevents duplicate names/limit races between MCP callers.
+    const setup = await this.opts.db.transaction(async tx => {
+      const lock = await tx.execute(sql`select pg_try_advisory_xact_lock(hashtextextended(${`mcp-chip-pairing:${companyId}`}, 0)) as locked`)
+      if (lock.rows[0]?.locked !== true) throw new ConnectionsError('conflict', 'Outro pareamento está sendo preparado nesta empresa; tente novamente.')
+      const db = tx as unknown as Database
+      const svc = new ConnectionsService({ ...this.opts, db })
+      const rows = await db.select().from(connections).where(and(eq(connections.companyId, companyId), isNull(connections.unlinkedAt), input.connection_id ? eq(connections.id, input.connection_id) : sql`lower(${connections.name}) = lower(${input.name})`))
+      if (input.connection_id && rows.length === 0) throw new ConnectionsError('not_found', 'Conexão não encontrada.')
+      if (rows.length > 1) throw new ConnectionsError('conflict', 'Há mais de um chip com esse nome; informe connection_id.')
+      if (rows[0] && rows[0].name.toLowerCase() !== input.name.toLowerCase()) throw new ConnectionsError('validation', 'O nome não corresponde à conexão informada.')
+      if (rows[0]?.scheduledForDeletionAt) throw new ConnectionsError('conflict', 'A conexão está agendada para exclusão.')
+      let row = rows[0]
+      const created = !row
+      if (!row) {
+        if (proxy === undefined) throw new ConnectionsError('validation', 'Informe a proxy ou direct:true para criar um chip.')
+        // A panel session is not a CRM connection: never adopt it by name or silently create a duplicate.
+        let panelSessions
+        try { panelSessions = await this.opts.gateway.sessions.list() }
+        catch { throw new ConnectionsError('upstream', 'Não foi possível verificar os chips existentes. Nenhuma sessão foi criada.') }
+        if (panelSessions.some(s => s.name.trim().toLowerCase() === input.name.toLowerCase())) {
+          throw new ConnectionsError('conflict', 'Já existe um chip com esse nome no painel. Use a importação explícita da sessão na empresa autorizada ou escolha outro nome; nenhuma sessão foi criada ou adotada.')
+        }
+        const made = await svc.create(companyId, { name: input.name }, actorUserId)
+        ;[row] = await db.select().from(connections).where(and(eq(connections.id, made.id), eq(connections.companyId, companyId)))
+      }
+      if (!row) throw new ConnectionsError('upstream', 'Não foi possível registrar a conexão.')
+      const metadata = { connection_id: row.id, session_id: row.sessionId, name: row.name, created }
+      // Catch gateway failures inside the transaction so the binding remains available for safe retry by name/id.
+      try {
+        const current = await this.opts.gateway.sessions.get(row.sessionId)
+        if (!['NEW', 'DISCONNECTED'].includes(current.status)) {
+          return { ...metadata, state: current.status, already: true as const }
+        }
+        const proxySet = proxy === undefined ? {} : proxy === null
+          ? { proxyProtocol: null, proxyHost: null, proxyPort: null, proxyUsername: null, proxyPasswordEnc: null }
+          : { proxyProtocol: proxy.protocol, proxyHost: proxy.host, proxyPort: proxy.port, proxyUsername: proxy.username ?? null,
+              proxyPasswordEnc: proxy.password ? serializeEncrypted((this.opts.cipher ?? getCredentialsCipher()).encrypt(proxy.password, `connection/${row.id}/proxy`)) : null }
+        await prepare(row.sessionId, proxy === undefined ? {} : { proxy })
+        await db.update(connections).set({ ...proxySet, requiresRestart: false, qrRequestedAt: new Date(), updatedAt: new Date() }).where(and(eq(connections.companyId, companyId), eq(connections.id, row.id)))
+        const started = await this.opts.gateway.sessions.startQr(row.sessionId)
+        return { ...metadata, state: started.status, already: false as const }
+      } catch (error) {
+        const code = (error as { code?: unknown })?.code
+        return { ...metadata, failed: true as const, code: typeof code === 'string' && /^[A-Z_]{1,64}$/.test(code) ? code : 'UPSTREAM_ERROR' }
+      }
+    })
+    if ('failed' in setup) throw new ConnectionsError('upstream', 'Não foi possível preparar o QR. Confira o estado, a proxy e possíveis envios pendentes antes de tentar novamente.', { connection_id: setup.connection_id, session_id: setup.session_id, reason_code: setup.code })
+    if (setup.already) {
+      if (proxy !== undefined) throw new ConnectionsError('invalid_transition', 'O chip já está conectado ou pausado. A proxy não foi alterada.', { connection_id: setup.connection_id })
+      return { ...setup, status: 'not_pairable', session_state: setup.state, generated_at: null, qr_code: null }
+    }
+    const qr = await this.read(companyId, setup.connection_id, input.wait_seconds)
+    return { ...qr, created: setup.created, pairing_only: true }
+  }
+
+  async read(companyId: string, id: string, waitSeconds = 0): Promise<ChipPairingResult> {
+    if (!Number.isInteger(waitSeconds) || waitSeconds < 0 || waitSeconds > 20) throw new ConnectionsError('validation', 'Espera entre 0 e 20 segundos.')
+    if (!z.uuid().safeParse(id).success) throw new ConnectionsError('not_found', 'Conexão não encontrada.')
+    const [connection] = await this.opts.db.select().from(connections).where(and(eq(connections.id, id), eq(connections.companyId, companyId), isNull(connections.unlinkedAt)))
+    if (!connection) throw new ConnectionsError('not_found', 'Conexão não encontrada.')
+    const until = Date.now() + waitSeconds * 1000
+    for (;;) {
+      try {
+        const current = await this.opts.gateway.sessions.get(connection.sessionId)
+        const metadata = { connection_id: connection.id, session_id: connection.sessionId, name: connection.name, session_state: current.status }
+        if (current.status !== 'NEW') return { ...metadata, status: current.status === 'DISCONNECTED' ? 'disconnected' : 'not_pairable', generated_at: null, qr_code: null }
+        const qr = await this.opts.gateway.sessions.getQr(connection.sessionId)
+        if (qr.qr) return { ...metadata, status: 'qr_ready', generated_at: qr.generatedAt, qr_code: qr.qr }
+        if (Date.now() >= until) return { ...metadata, status: 'pending', generated_at: null, qr_code: null }
+      } catch {
+        throw new ConnectionsError('upstream', 'Não foi possível consultar o QR atual. Tente novamente com este connection_id.', { connection_id: connection.id })
+      }
+      await new Promise(resolve => setTimeout(resolve, Math.min(500, until - Date.now())))
+    }
+  }
+}
