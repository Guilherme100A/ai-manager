+import { z } from 'zod'
+import { pairChipSchema, type ChipPairingResult } from '../../connections/pairing'
+import { fail, fromApi, tool, UUID, type CallResult, type McpApiResponse } from './shared'
+
+/** QR is returned as an MCP image, never as JSON/base64 text or a public URL. */
+export function pairingResult(response: McpApiResponse): CallResult {
+  if (response.status < 200 || response.status >= 300) return fromApi(response)
+  const result = response.body as ChipPairingResult
+  if (!result || typeof result.connection_id !== 'string') return fail({ error: { code: 'UPSTREAM_ERROR', message: 'Resposta de pareamento inválida.' } })
+  const info = { connection_id: result.connection_id, session_id: result.session_id, name: result.name, status: result.status,
+    session_state: result.session_state, generated_at: result.generated_at, created: result.created, pairing_only: result.pairing_only,
+    instruction: result.status === 'qr_ready' ? 'Escaneie a imagem no WhatsApp > Aparelhos conectados. O QR expira; use get_chip_qr para atualizar. Gerar QR não confirma pareamento.'
+      : result.status === 'pending' ? 'QR ainda em preparação. Chame get_chip_qr com este connection_id; não crie outra conexão.'
+      : 'Nenhum QR disponível neste estado. A sessão não foi deslogada nem substituída.' }
+  const content: CallResult['content'] = [{ type: 'text', text: JSON.stringify(info) }]
+  if (result.status === 'qr_ready') {
+    const encoded = result.qr_code?.match(/^data:image\/png;base64,([A-Za-z0-9+/]+={0,2})$/)?.[1]
+    if (!encoded || encoded.length > 1024 * 1024 || Buffer.from(encoded, 'base64').subarray(0, 8).toString('hex') !== '89504e470d0a1a0a') {
+      return fail({ error: { code: 'UPSTREAM_ERROR', message: 'O gateway não retornou uma imagem PNG de QR válida.' }, connection_id: result.connection_id })
+    }
+    content.push({ type: 'image', data: encoded, mimeType: 'image/png' })
+  }
+  return { content, structuredContent: info }
+}
+
+export const connectionsTools = [
+  tool({ name: 'list_importable_chips', title: 'Listar chips disponíveis do painel', kind: 'read', perm: 'connections.edit',
+    description: 'Lista chips existentes no painel ai-manager que ainda não têm vínculo em nenhuma empresa CRM. Mostra session_id, nome e estado para seleção explícita. Não importa, não gera QR, não troca proxy nem envia mensagens. Exige connections.edit, como a listagem de importação do painel CRM; disponível somente no perfil ai-manager.',
+    input: {},
+    run: async (_args, api) => fromApi(await api.request('GET', '/api/connections/importable')),
+  }),
+  tool({ name: 'import_panel_chips', title: 'Usar chips do painel no CRM', kind: 'write', perm: 'connections.edit',
+    description: 'Vincula à empresa CRM somente os session_ids selecionados explicitamente após list_importable_chips. Reutiliza as mesmas sessões, proxy, perfil de aparelho e conexão WhatsApp do painel. Não cria chip, não gera QR, não reinicia/desloga e não envia mensagens. Sessão já vinculada a qualquer empresa é recusada. Exige credencial de escrita e connections.edit; somente perfil ai-manager. Não importe outros chips por coincidência de nome.',
+    input: { session_ids: z.array(z.string().trim().min(1).max(200)).min(1).max(50) },
+    run: async (args, api) => fromApi(await api.request('POST', '/api/connections/import', { body: { session_ids: args.session_ids }, write: true })),
+  }),
+  tool({ name: 'connect_chip', title: 'Conectar chip e mostrar QR', kind: 'write', perm: 'connections.edit', openWorld: true,
+    description: 'Cria ou reutiliza uma conexão CRM da empresa e devolve QR em imagem PNG. Recebe nome e proxy (URL http/https/socks5, host:porta:usuario:senha com HTTP por padrão, ou objeto). Repetições usam o mesmo nome/connection_id; nomes CRM duplicados exigem id. Chip existente só no painel exige importação explícita: colisão de nome bloqueia a criação, sem adoção automática. Chip novo sem proxy exige direct:true. Proxy omitida em conexão existente é preservada. Não desloga chip conectado e não ativa rodízio, autoresposta ou grupos; fila pendente bloqueia a preparação. Senha não é devolvida. Exige escrita e connections.edit. Gerar QR não confirma conexão.',
+    input: pairChipSchema.shape,
+    run: async (args, api) => pairingResult(await api.request('POST', '/api/connections/pairing', { body: args, write: true })),
+  }),
+  tool({ name: 'get_chip_qr', title: 'Atualizar QR de um chip', kind: 'write', perm: 'connections.edit',
+    description: 'Obtém o QR atual como imagem PNG de uma conexão da empresa, sem criar outra sessão nem deslogar. Use após connect_chip retornar pending ou quando a imagem expirar. Exige escrita porque QR é uma credencial de pareamento. Não confirma que o celular escaneou.',
+    input: { connection_id: UUID, wait_seconds: z.number().int().min(0).max(20).default(0) },
+    run: async (args, api) => pairingResult(await api.request('GET', `/api/connections/${args.connection_id}/pairing-qr`, { query: { wait_seconds: args.wait_seconds }, write: true })),
+  }),
+] as const
