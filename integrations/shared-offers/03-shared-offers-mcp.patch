@@ -0,0 +1,93 @@
+import { Client } from '@modelcontextprotocol/sdk/client/index.js'
+import { InMemoryTransport } from '@modelcontextprotocol/sdk/inMemory.js'
+import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { PermissionKey } from '@crm/shared'
+import type { Database } from '@crm/db'
+import { createMcpServer } from '../server'
+import { offersTools } from './offers'
+import { registerApiTools, type McpApiRequest } from './shared'
+
+const ID = '3f1b2c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d'
+const OTHER = '4f1b2c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d'
+const config = { owner_user_id: ID, product_id: ID, currency: 'BRL', flow_id: ID, connection_ids: [ID], integration_id: ID, ad_account_id: ID, pixel_id: ID, origins: [{ type: 'source_id', value: 'AD-A' }] }
+const closers: (() => Promise<void>)[] = []
+afterEach(async () => { await Promise.all(closers.splice(0).map(close => close())); vi.unstubAllEnvs() })
+async function connect(access: 'read' | 'write' = 'write', perms: PermissionKey[] = ['settings.products.view', 'settings.products.edit', 'chat.view'], reply = { status: 200, body: { ok: true } as unknown }) {
+  const calls: { method: string; path: string; req?: McpApiRequest }[] = []
+  const server = new McpServer({ name: 'test', version: '1' })
+  const names = registerApiTools(server, { access, perms: new Set(perms), api: { request: async (method, path, req) => { calls.push({ method, path, req }); return reply } } }, offersTools)
+  const client = await link(server)
+  return { client, calls, names, call: (name: string, args: Record<string, unknown> = {}) => client.callTool({ name, arguments: args }) }
+}
+async function link(server: McpServer) {
+  const client = new Client({ name: 'client', version: '1' }), [a, b] = InMemoryTransport.createLinkedPair()
+  await Promise.all([server.connect(a), client.connect(b)])
+  closers.push(async () => { await client.close(); await server.close() })
+  return client
+}
+describe('shared Offers MCP', () => {
+  it('maps all eight tools to authenticated routes with the exact body/query', async () => {
+    const { call, calls } = await connect()
+    await call('list_offers'); await call('get_offer', { id: ID }); await call('get_offer_resources')
+    await call('get_offer_results', { owner_user_id: ID, offer_id: OTHER })
+    await call('create_offer', { name: 'Oferta', config })
+    await call('update_offer', { id: ID, name: 'Oferta nova', active: true, config })
+    await call('set_offer_connection_mode', { connection_id: ID, enabled: false })
+    await call('list_conversation_offer_opportunities', { conversation_id: ID })
+    expect(calls.map(c => [c.method, c.path])).toEqual([
+      ['GET', '/api/offers'], ['GET', `/api/offers/${ID}`], ['GET', '/api/offers/resources'], ['GET', '/api/offers/results'],
+      ['POST', '/api/offers'], ['PUT', `/api/offers/${ID}`], ['PUT', `/api/offers/chips/${ID}`], ['GET', `/api/chats/${ID}/offers`],
+    ])
+    expect(calls[3]!.req).toEqual({ query: { owner: ID, offer: OTHER }, write: false })
+    expect(calls[4]!.req).toEqual({ body: { name: 'Oferta', config, active: false }, write: true })
+    expect(calls[5]!.req).toEqual({ body: { name: 'Oferta nova', config, active: true }, write: true })
+    expect(calls[6]!.req).toEqual({ body: { enabled: false }, write: true })
+    expect(calls.filter(c => c.req?.write).length).toBe(3)
+  })
+  it('read credentials expose five reads and cannot call writes', async () => {
+    const { client, call, calls } = await connect('read')
+    const tools = (await client.listTools()).tools
+    expect(tools.map(t => t.name).sort()).toEqual(['get_offer', 'get_offer_resources', 'get_offer_results', 'list_conversation_offer_opportunities', 'list_offers'])
+    expect(tools.every(t => t.annotations?.readOnlyHint === true)).toBe(true)
+    expect((await call('set_offer_connection_mode', { connection_id: ID, enabled: true })).isError).toBe(true)
+    expect(calls).toHaveLength(0)
+  })
+  it('permissions filter product reads, writes and conversation history separately', async () => {
+    const { client } = await connect('write', ['chat.view'])
+    expect((await client.listTools()).tools.map(t => t.name)).toEqual(['list_conversation_offer_opportunities'])
+    const none = await connect('write', [])
+    expect(none.names).toEqual([])
+    expect(none.client.getServerCapabilities()?.tools).toBeUndefined()
+    await expect(none.client.listTools()).rejects.toMatchObject({ code: -32601 })
+  })
+  it.each([
+    ['get_offer', { id: '../other' }],
+    ['create_offer', { name: 'O', config: { ...config, connection_ids: [] } }],
+    ['create_offer', { name: 'O', config: { ...config, currency: 'brl' } }],
+    ['create_offer', { name: 'O', config: { ...config, access_token: 'do-not-store' } }],
+    ['update_offer', { id: ID, name: 'O', config }],
+    ['set_offer_connection_mode', { connection_id: ID, enabled: 'true' }],
+  ])('rejects invalid input for %s before calling the API', async (name, args) => {
+    const { call, calls } = await connect()
+    expect((await call(name as string, args as Record<string, unknown>)).isError).toBe(true)
+    expect(calls).toHaveLength(0)
+  })
+  it('preserves API denial instead of presenting success', async () => {
+    const { call } = await connect('write', ['settings.products.view'], { status: 404, body: { error: { code: 'NOT_FOUND', message: 'Recurso não encontrado' } } })
+    const result = await call('list_offers')
+    expect(result.isError).toBe(true)
+    expect(JSON.parse((result.content as { text: string }[])[0]!.text)).toMatchObject({ status: 404, error: { code: 'NOT_FOUND' } })
+  })
+  it('actual server catalog hides Offers outside the pinned company, with empty/invalid gate or without an actor', async () => {
+    const api = { access: 'write' as const, perms: new Set<PermissionKey>(['settings.products.view', 'settings.products.edit']), api: { request: async () => ({ status: 200, body: {} }) } }
+    for (const gate of ['', 'invalid', OTHER, ID]) {
+      vi.stubEnv('SHARED_OFFERS_COMPANY_ID', gate)
+      const client = await link(createMcpServer({ db: {} as Database, companyId: ID, api }))
+      expect((await client.listTools()).tools.some(t => t.name === 'list_offers')).toBe(gate === ID)
+    }
+    vi.stubEnv('SHARED_OFFERS_COMPANY_ID', ID)
+    const client = await link(createMcpServer({ db: {} as Database, companyId: ID }))
+    expect((await client.listTools()).tools.some(t => t.name === 'list_offers')).toBe(false)
+  })
+})
