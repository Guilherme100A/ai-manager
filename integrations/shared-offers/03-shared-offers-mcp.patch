+// Disposable PostgreSQL/Redis and fake providers, executed on CI only.
+import { randomUUID } from 'node:crypto'
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { connectMeta, salesPixel, startSystem, tenant, type System, type Tenant } from './setup'
+let sys: System, t: Tenant, other: Tenant, writer: string, reader: string, credentialId: string, config: Record<string, unknown>, offer: any
+const priorGate = process.env.SHARED_OFFERS_COMPANY_ID
+let sequence = 0
+async function rpc(token: string, method: string, params: Record<string, unknown> = {}) {
+  const response = await sys.app.request('/api/mcp', { method: 'POST', headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json', accept: 'application/json, text/event-stream', 'mcp-protocol-version': '2025-06-18' }, body: JSON.stringify({ jsonrpc: '2.0', id: ++sequence, method, params }) })
+  return { status: response.status, body: await response.json() as any }
+}
+async function invoke(token: string, name: string, args: Record<string, unknown> = {}) {
+  const response = await rpc(token, 'tools/call', { name, arguments: args })
+  const result = response.body.result
+  let data: any = result?.content?.[0]?.text ?? null
+  if (typeof data === 'string') { try { data = JSON.parse(data) } catch { /* Protocol validation errors may be plain text. */ } }
+  return { ...response, error: Boolean(response.body.error || result?.isError), data }
+}
+const names = async (token: string) => (await rpc(token, 'tools/list')).body.result.tools.map((tool: any) => tool.name)
+beforeAll(async () => {
+  sys = await startSystem(); t = await tenant(sys); other = await tenant(sys)
+  process.env.SHARED_OFFERS_COMPANY_ID = t.companyId
+  const account = (await connectMeta(sys, t, 1))[0]!.localId, pixel = await salesPixel(sys, t)
+  const product = await t.c.post('/api/products', { name: 'MCP product', currency: 'BRL', price_min_cents: 100, price_max_cents: 100, price_fallback_cents: 100 })
+  expect(product.status).toBe(201)
+  const integration = await t.c.post('/api/payment-integrations', { label: 'MCP fake XPag', gateway: 'xpag', client_id: 'fake-mcp-offers', client_secret: 'synthetic-never-contact-provider' })
+  expect(integration.status).toBe(201)
+  // Resource fixture only: no run is ever started by these tests.
+  const [flow] = await sys.q("insert into crm.flows(company_id,name,status,published_version) values($1,'MCP fixture published flow','active',1) returning id", [t.companyId])
+  const userId = (await t.c.get('/api/auth/profile')).body.user.id
+  config = { owner_user_id: userId, product_id: product.body.product.id, currency: 'BRL', flow_id: flow.id, connection_ids: [t.connectionId], integration_id: integration.body.integration.id, ad_account_id: account, pixel_id: pixel.id, origins: [] }
+  const write = await t.c.post('/api/mcp_credentials', { name: 'MCP Offers writer', access: 'write' })
+  const read = await t.c.post('/api/mcp_credentials', { name: 'MCP Offers reader', access: 'read' })
+  expect(write.status).toBe(201); expect(read.status).toBe(201)
+  writer = write.body.token; reader = read.body.token; credentialId = write.body.mcp_credential.id
+}, 180_000)
+afterAll(async () => {
+  if (priorGate === undefined) delete process.env.SHARED_OFFERS_COMPANY_ID
+  else process.env.SHARED_OFFERS_COMPANY_ID = priorGate
+  await sys?.close()
+}, 120_000)
+
+it('connects through MCP and lists permitted resources without secrets', async () => {
+  expect((await rpc(reader, 'initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'offers-test', version: '1' } })).status).toBe(200)
+  expect(await names(reader)).toContain('list_offers')
