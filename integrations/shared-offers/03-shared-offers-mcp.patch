+// Reuse the authenticated API: tenant gate, permissions, validation and audit remain authoritative.
+import { z } from 'zod'
+import { compact, fromApi, tool, UUID, type ToolSpec } from './shared'
+import type { ZodRawShape } from 'zod'
+
+const VIEW = 'settings.products.view' as const
+const EDIT = 'settings.products.edit' as const
+const config = z.object({
+  owner_user_id: UUID.describe('Responsável cadastrado na empresa; use get_offer_resources.'),
+  product_id: UUID,
+  currency: z.string().regex(/^[A-Z]{3}$/).describe('Moeda ISO do produto, por exemplo BRL.'),
+  flow_id: UUID.describe('Fluxo ativo com versão publicada.'),
+  connection_ids: z.array(UUID).min(1).describe('Chips permitidos; o mesmo chip pode atender diversas ofertas.'),
+  integration_id: UUID.describe('Integração XPag cadastrada, sem informar segredos.'),
+  ad_account_id: UUID,
+  pixel_id: UUID,
+  origins: z.array(z.object({ type: z.enum(['source_id', 'link']), value: z.string().trim().min(1).max(200) })),
+  cost_cents: z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER).nullable().optional(),
+  cost_label: z.string().optional().describe('Identificação obrigatória quando informar custo.'),
+}).strict()
+const offer = {
+  name: z.string().trim().min(1).max(120),
+  active: z.boolean().optional().describe('Ativação explícita. Omitido cria ou mantém a oferta inativa nesta gravação.'),
+  config,
+}
+
+export const offersTools: readonly ToolSpec<ZodRawShape>[] = [
+  tool({ name: 'list_offers', title: 'Listar ofertas compartilhadas', perm: VIEW,
+    description: 'Ofertas comerciais do CRM da empresa habilitada, com configuração e versão. Não são ofertas capturadas pela Sonda.',
+    run: async (_, api) => fromApi(await api.request('GET', '/api/offers')) }),
+  tool({ name: 'get_offer', title: 'Consultar oferta compartilhada', perm: VIEW,
+    description: 'Leia a configuração atual antes de editar uma oferta. Retorna apenas oferta desta empresa.', input: { id: UUID },
+    run: async ({ id }, api) => fromApi(await api.request('GET', `/api/offers/${id}`)) }),
+  tool({ name: 'get_offer_resources', title: 'Consultar recursos de Ofertas', perm: VIEW,
+    description: 'IDs reais de responsáveis, produtos, fluxos publicados, chips, integrações XPag, contas, pixels e links da empresa. Sem tokens ou senhas. Use estes IDs ao configurar ofertas.',
+    run: async (_, api) => fromApi(await api.request('GET', '/api/offers/resources')) }),
+  tool({ name: 'get_offer_results', title: 'Consultar resultados de Ofertas', perm: VIEW,
+    description: 'Vendas, receita e lucro estimado por oferta, responsável histórico e moeda. Custos incompletos continuam indicados; não soma moedas distintas.',
+    input: { owner_user_id: UUID.optional(), offer_id: UUID.optional() },
+    run: async ({ owner_user_id, offer_id }, api) => fromApi(await api.request('GET', '/api/offers/results', { query: compact({ owner: owner_user_id, offer: offer_id }) })) }),
+  tool({ name: 'create_offer', title: 'Criar oferta compartilhada', perm: EDIT, kind: 'write',
+    description: 'Cria uma oferta comercial. Consulte get_offer_resources antes. Inativa por padrão; active=true habilita sua resolução em chips já geridos. Não inicia execução ou envia mensagem nesta chamada.', input: offer,
+    run: async (args, api) => fromApi(await api.request('POST', '/api/offers', { body: { ...args, active: args.active ?? false } })) }),
+  tool({ name: 'update_offer', title: 'Atualizar oferta compartilhada', perm: EDIT, kind: 'write',
+    description: 'Substitui a configuração inteira e incrementa a versão. Leia get_offer antes e informe todos os recursos, origens e active explicitamente. Não modifica snapshots de oportunidades anteriores.',
+    input: { id: UUID, ...offer, active: z.boolean() },
+    run: async ({ id, ...args }, api) => fromApi(await api.request('PUT', `/api/offers/${id}`, { body: args })) }),
+  tool({ name: 'set_offer_connection_mode', title: 'Configurar modalidade de ofertas do chip', perm: EDIT, kind: 'write',
+    description: 'Ativa ou desativa a modalidade de ofertas em um chip desta empresa. Ativar altera o tratamento de novas mensagens e suprime gatilhos legados; exige pedido explícito. Não pareia, reinicia ou envia mensagem pelo chip.',
+    input: { connection_id: UUID, enabled: z.boolean() },
+    run: async ({ connection_id, enabled }, api) => fromApi(await api.request('PUT', `/api/offers/chips/${connection_id}`, { body: { enabled } })) }),
+  tool({ name: 'list_conversation_offer_opportunities', title: 'Consultar ofertas da conversa', perm: 'chat.view',
+    description: 'Histórico de oportunidades e evidências congeladas desta conversa. Consulta apenas; não seleciona oferta nem inicia fluxo.', input: { conversation_id: UUID },
+    run: async ({ conversation_id }, api) => fromApi(await api.request('GET', `/api/chats/${conversation_id}/offers`)) }),
+]
