+  /** Resolve a identidade e abre somente o chat da conexao explicita; nunca envia ou inicia automacoes. */
+  async openByPhone(actor: ChatActor, input: { connection_id: string; phone: string; name?: string }) {
+    for (const permission of ['chat.view', 'contacts.edit'])
+      if (!actor.perms.has(permission)) throw new ChatsError('forbidden', 'Permissao insuficiente', { permission })
+    if (!UUID_RE.test(input.connection_id ?? '')) throw chatInvalid('connection_id', 'Conexao invalida')
+    // DDI explicito; formato E.164 do cadastro, sem adivinhar pais ou adicionar nono digito.
+    // Abertura local nao comprova que o numero possui WhatsApp.
+    const raw = input.phone?.trim() ?? ''
+    const phone = raw.replace(/[\s().-]/g, '')
+    if (!/^[+\d\s().-]+$/.test(raw) || !isE164(phone)) throw chatInvalid('phone', 'Informe telefone internacional com +DDI (E.164, 8 a 15 digitos)')
+    const scope = await actorScope(this.db, actor)
+    const result = await this.db.transaction(async (tx) => {
+      const [connection] = await tx.select({ id: connections.id }).from(connections)
+        .where(and(eq(connections.companyId, actor.companyId), eq(connections.id, input.connection_id), isNull(connections.unlinkedAt), isNull(connections.scheduledForDeletionAt)))
+        .limit(1).for('share')
+      if (!connection) throw chatInvalid('connection_id', 'Conexao nao encontrada ou indisponivel')
+      assertInScope(scope, { connectionId: connection.id, departmentId: null })
+      const [createdContact] = await tx.insert(contacts)
+        .values({ companyId: actor.companyId, phoneE164: phone, name: input.name?.trim() || phone, origin: 'manual' })
+        .onConflictDoNothing({ target: [contacts.companyId, contacts.phoneE164], where: sql`${contacts.phoneE164} is not null` }).returning({ id: contacts.id })
+      const contact = createdContact ?? (await tx.select({ id: contacts.id }).from(contacts)
+        .where(and(eq(contacts.companyId, actor.companyId), eq(contacts.phoneE164, phone))).limit(1))[0]!
+      // Mesmo ciclo de vida da API existente, dentro da transacao e sem realtime antes do commit.
+      const opened = await new ChatLifecycleService({ db: tx as unknown as Database }).open(actor, { contact_id: contact.id, connection_id: connection.id })
+      const [row] = await tx.select().from(chats).where(eq(chats.id, opened.chat.id))
+      return { ...opened, row: row!, contactCreated: !!createdContact }
+    })
+    if (result.created) await this.publish(result.row, 'chat.created', { chat_id: result.chat.id, chat: result.chat })
+    return { chat_id: result.chat.id, connection_id: result.chat.connection_id, contact_id: result.chat.contact.id,
+      phone_e164: phone, created: result.created, contact_created: result.contactCreated, message_sent: false, flow_started: false }
+  }
