diff --git a/packages/core/src/chats/model/status-receipts.ts b/packages/core/src/chats/model/status-receipts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dcbbc5d540163b75d9f52ee8d9979a7c98607e8a
--- /dev/null
+++ b/packages/core/src/chats/model/status-receipts.ts
@@ -0,0 +1,110 @@
+import { and, eq, sql } from 'drizzle-orm'
+import { messages, pendingMessageStatus, type Database } from '@crm/db'
+import type { MessageView, WaEventOf } from '@crm/wa-port'
+import type { MessageRow } from './dto'
+import { canAdvanceStatus } from './rules'
+
+type Tx = Parameters<Parameters<Database['transaction']>[0]>[0]
+type Scope = { companyId: string; connectionId: string; pipelineMessageId: string }
+type Evidence = Pick<typeof pendingMessageStatus.$inferSelect, 'status' | 'waMessageId' | 'sentAt' | 'deliveredAt' | 'readAt' | 'error'>
+
+const where = (s: Scope) => and(eq(pendingMessageStatus.companyId, s.companyId), eq(pendingMessageStatus.connectionId, s.connectionId), eq(pendingMessageStatus.pipelineMessageId, s.pipelineMessageId))
+
+/** Recorder and ACK serialize on the same pipeline identity, including before a row exists.
+ * A receipt committed first is consumed by the recorder; otherwise ACK waits for its commit.
+ * Transaction rollback releases the lock and leaves evidence available for an idempotent retry.
+ */
+export async function lockMessageStatus(tx: Tx, s: Scope): Promise<void> {
+  await tx.execute(sql`select pg_advisory_xact_lock(hashtext(${`crm-status/${s.companyId}/${s.connectionId}`}),hashtext(${s.pipelineMessageId}))`)
+}
+
+export function statusEvidence(event: WaEventOf<'message.status'>): Evidence {
+  const at = new Date(event.at)
+  const sent = ['sent', 'delivered', 'read'].includes(event.status)
+  const delivered = ['delivered', 'read'].includes(event.status)
+  return {
+    status: event.status,
+    waMessageId: event.transport_message_id ?? null,
+    sentAt: sent ? at : null,
+    deliveredAt: delivered ? at : null,
+    readAt: event.status === 'read' ? at : null,
+    error: event.status === 'failed' || event.status === 'cancelled' ? event.error ?? null : null,
+  }
+}
+
+export function viewEvidence(view: MessageView): Evidence {
+  return { status: view.status, waMessageId: view.transportMessageId, sentAt: view.sentAt ? new Date(view.sentAt) : null,
+    deliveredAt: view.deliveredAt ? new Date(view.deliveredAt) : null, readAt: view.readAt ? new Date(view.readAt) : null,
+    error: view.status === 'failed' || view.status === 'cancelled' ? view.lastError : null }
+}
+
+const earliest = (a: Date | null, b: Date | null) => !a ? b : !b ? a : a < b ? a : b
+
+function combine(a: Evidence, b: Evidence): Evidence {
+  const advance = canAdvanceStatus(a.status, b.status)
+  return {
+    status: advance ? b.status : a.status,
+    waMessageId: a.waMessageId ?? b.waMessageId,
+    sentAt: earliest(a.sentAt, b.sentAt),
+    deliveredAt: earliest(a.deliveredAt, b.deliveredAt),
+    readAt: earliest(a.readAt, b.readAt),
+    error: advance ? b.error : a.error,
+  }
+}
+
+/** Bounded, connection-local cleanup. No sends, flow changes or historical event replay. */
+async function expire(tx: Tx, s: Scope): Promise<void> {
+  await tx.execute(sql`delete from crm.pending_message_status where ctid in
+    (select ctid from crm.pending_message_status where company_id=${s.companyId}
+      and connection_id=${s.connectionId} and expires_at < now() limit 100 for update skip locked)`)
+}
+
+export async function rememberMessageStatus(tx: Tx, s: Scope, evidence: Evidence): Promise<void> {
+  await expire(tx, s)
+  const [previous] = await tx.select().from(pendingMessageStatus).where(where(s))
+  if (previous?.waMessageId && evidence.waMessageId && previous.waMessageId !== evidence.waMessageId) throw new Error('Conflicting WhatsApp status identity')
+  const next = previous ? combine(previous, evidence) : evidence
+  await tx.insert(pendingMessageStatus).values({ ...s, ...next })
+    .onConflictDoUpdate({ target: [pendingMessageStatus.companyId, pendingMessageStatus.connectionId, pendingMessageStatus.pipelineMessageId], set: next })
+}
+
+/** Monotonic delivery projection. An equal/stale ACK can still supply missing WAID/timestamps. */
+export async function projectMessageStatus(tx: Tx, msg: MessageRow, evidence: Evidence, now: Date): Promise<MessageRow | null> {
+  if (msg.direction !== 'outbound') return null
+  if (msg.waMessageId && evidence.waMessageId && msg.waMessageId !== evidence.waMessageId) return null
+  const next = combine({ ...msg, status: msg.status === 'received' ? 'queued' : msg.status }, evidence)
+  if (next.status === msg.status && next.waMessageId === msg.waMessageId &&
+      next.sentAt?.getTime() === msg.sentAt?.getTime() && next.deliveredAt?.getTime() === msg.deliveredAt?.getTime() &&
+      next.readAt?.getTime() === msg.readAt?.getTime() && next.error === msg.error) return null
+  const [updated] = await tx.update(messages).set({ ...next, updatedAt: now }).where(and(eq(messages.id, msg.id), eq(messages.companyId, msg.companyId), eq(messages.connectionId, msg.connectionId))).returning()
+  return updated ?? null
+}
+
+/** Caller holds the pipeline lock; consumes only evidence belonging to this exact outbound. */
+export async function consumeMessageStatus(tx: Tx, msg: MessageRow, now: Date): Promise<MessageRow> {
+  if (!msg.pipelineMessageId || msg.direction !== 'outbound') return msg
+  const scope = { companyId: msg.companyId, connectionId: msg.connectionId, pipelineMessageId: msg.pipelineMessageId }
+  const [receipt] = await tx.select().from(pendingMessageStatus).where(and(where(scope), sql`${pendingMessageStatus.expiresAt} >= now()`))
+  if (!receipt) return msg
+  if (msg.waMessageId && receipt.waMessageId && msg.waMessageId !== receipt.waMessageId) throw new Error('Conflicting WhatsApp status identity')
+  const updated = await projectMessageStatus(tx, msg, receipt, now)
+  await tx.delete(pendingMessageStatus).where(where(scope))
+  return updated ?? msg
+}
+
+/** Associates the already accepted send; same-pipeline queued views cannot erase a concurrent ACK.
+ * A caller-requested retry with a NEW pipeline resets only that attempt's transport metadata.
+ * Takes the pipeline lock before the row lock; no gateway/Redis call happens here.
+ */
+export async function associateMessagePipeline(tx: Tx, msg: MessageRow, view: MessageView, now: Date): Promise<MessageRow> {
+  await lockMessageStatus(tx, { companyId: msg.companyId, connectionId: msg.connectionId, pipelineMessageId: view.id })
+  const [current] = await tx.select().from(messages).where(and(eq(messages.id, msg.id), eq(messages.companyId, msg.companyId), eq(messages.connectionId, msg.connectionId), eq(messages.chatId, msg.chatId), eq(messages.direction, 'outbound'))).for('update')
+  if (!current) throw new Error('Outbound association not found')
+  let associated: MessageRow
+  if (current.pipelineMessageId === view.id) associated = await projectMessageStatus(tx, current, viewEvidence(view), now) ?? current
+  else {
+    const [updated] = await tx.update(messages).set({ ...viewEvidence(view), pipelineMessageId: view.id, updatedAt: now }).where(eq(messages.id, current.id)).returning()
+    associated = updated!
+  }
+  return consumeMessageStatus(tx, associated, now)
+}
