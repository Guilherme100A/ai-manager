new file mode 100644
index 0000000000000000000000000000000000000000..a587bdd59aab4eb7ecfc998f8e8df6a560901693
--- /dev/null
+++ b/packages/db/src/schema/crm/message-status.ts
@@ -0,0 +1,24 @@
+import { sql } from 'drizzle-orm'
+import { check, foreignKey, index, primaryKey, text, timestamp, uuid } from 'drizzle-orm/pg-core'
+import type { CrmMessageStatus } from './chats.js'
+import { connections } from './connections.js'
+import { crm } from './schema.js'
+
+/** Unmatched delivery evidence; private, no message body and no send/retry intent. */
+export const pendingMessageStatus = crm.table('pending_message_status', {
+  companyId: uuid('company_id').notNull(),
+  connectionId: uuid('connection_id').notNull(),
+  pipelineMessageId: text('pipeline_message_id').notNull(),
+  status: text('status').$type<Exclude<CrmMessageStatus, 'received'>>().notNull(),
+  waMessageId: text('wa_message_id'),
+  sentAt: timestamp('sent_at', { withTimezone: true }),
+  deliveredAt: timestamp('delivered_at', { withTimezone: true }),
+  readAt: timestamp('read_at', { withTimezone: true }),
+  error: text('error'),
+  expiresAt: timestamp('expires_at', { withTimezone: true }).notNull().default(sql`now() + interval '30 days'`),
+}, t => [
+  primaryKey({ columns: [t.companyId, t.connectionId, t.pipelineMessageId] }),
+  foreignKey({ name: 'pending_message_status_connection_fk', columns: [t.companyId, t.connectionId], foreignColumns: [connections.companyId, connections.id] }).onDelete('cascade'),
+  check('pending_message_status_status_check', sql`${t.status} in ('queued','processing','retrying','sent','delivered','read','failed','cancelled')`),
+  index('pending_message_status_expiry_idx').on(t.companyId, t.connectionId, t.expiresAt),
+])
