+  const [contact] = await db.insert(contacts).values({ companyId: company!.id, name: 'Client', phoneE164: '+5511999990001' }).returning()
+  const [chat] = await db.insert(chats).values({ companyId: company!.id, connectionId: connection!.id, contactId: contact!.id }).returning()
+  const [user] = await db.insert(users).values({ name: 'Operator', email: randomUUID() + '@example.test', passwordHash: 'synthetic-not-login' }).returning()
