+/**
+ * Chave de uma conta autorizada no workspace: ligada quando já tem vínculo neste workspace; desabilitada para quem
+ * não gere perfis e durante qualquer mutação/recarga.
+ */
+export function workspaceSwitchState(
+  account: { linked_ad_account_id: string | null },
+  opts: { manager: boolean; locked: boolean },
+): { checked: boolean; disabled: boolean } {
+  return { checked: account.linked_ad_account_id != null, disabled: !opts.manager || opts.locked }
+}
+
+/** Perfil a abrir depois do OAuth no workspace: o único, ou o de `updated_at` mais recente. */
+export function oauthFocusProfile(profiles: readonly Pick<MetaProfile, 'id' | 'updated_at'>[]): string | null {
+  if (profiles.length <= 1) return profiles[0]?.id ?? null
+  const time = (p: Pick<MetaProfile, 'updated_at'>) => {
+    const t = p.updated_at ? Date.parse(p.updated_at) : NaN
+    return Number.isNaN(t) ? -Infinity : t
+  }
+  return profiles.reduce((best, p) => (time(p) > time(best) ? p : best)).id
+}
+
+/** Pixels que impedem o desvínculo (409 `details.pixels`), ou `null` se o erro for outro. */
+export function unlinkBlockingPixels(err: unknown): { id: string; pixel_id: string; name: string }[] | null {
+  if (!(err instanceof HttpError) || err.status !== 409) return null
+  const pixels = (err.details as { pixels?: unknown } | undefined)?.pixels
+  return Array.isArray(pixels) && pixels.length ? (pixels as { id: string; pixel_id: string; name: string }[]) : null
+}
