@@ -0,0 +1,51 @@
+import { Hono } from 'hono'
+import { z } from 'zod'
+import { BusinessAreasService, BusinessAreaError, AREA_RESOURCE_TABLES, isSharedOffersCompany } from '@crm/core'
+import type { AppEnv, ResolvedDeps } from '../../lib/types'
+import { getCompanyCtx } from '../../lib/context'
+import { ApiError } from '../../lib/errors'
+import { requirePerm } from '../../middleware/authorize'
+import { validate } from '../../lib/validate'
+import { setAudit } from '../../middleware/audit'
+
+export function areaError(err: unknown): never {
+  if (err instanceof BusinessAreaError) throw new ApiError(({ not_found: 'NOT_FOUND', conflict: 'CONFLICT', validation: 'VALIDATION_ERROR' } as const)[err.code], err.message)
+  throw err
+}
+export function businessAreasRoutes(deps: ResolvedDeps) {
+  const app = new Hono<AppEnv>(), svc = new BusinessAreasService(deps.db)
+  const company = (c: Parameters<typeof getCompanyCtx>[0]) => getCompanyCtx(c).companyId
+  const gate = async (c: Parameters<typeof getCompanyCtx>[0], next: () => Promise<void>) => {
+    if (!isSharedOffersCompany(company(c)) || !await svc.administrator(company(c),getCompanyCtx(c).user?.id)) throw new ApiError('NOT_FOUND', 'Área não encontrada')
+    await next()
+  }
+  app.use('/api/business-areas', gate)
+  app.use('/api/business-areas/*', gate)
+  app.onError(err => areaError(err))
+  app.get('/api/business-areas', requirePerm('settings.products.view'), async c => c.json({ items: await svc.list(company(c)) }))
+  app.get('/api/business-areas/catalog', requirePerm('settings.products.edit'), async c => c.json(await svc.catalog(company(c))))
+  app.post('/api/business-areas/initialize', requirePerm('settings.products.edit'), async c => {
+    const items = await svc.initialize(company(c))
+    setAudit(c, { action: 'business_areas.initialize', targetType: 'company', targetId: company(c) })
+    return c.json({ items }, 201)
+  })
+  app.put('/api/business-areas/:id', requirePerm('settings.products.edit'), validate('param', z.object({ id: z.uuid() })),
+    validate('json', z.object({ name: z.string().trim().min(1).max(80), bm_id: z.string().regex(/^\d{1,32}$/).nullable() })), async c => {
+      const area = await svc.update(company(c), c.req.param('id'), c.req.valid('json'))
+      setAudit(c, { action: 'business_areas.update', targetType: 'business_area', targetId: area.id })
+      return c.json({ area })
+    })
+  app.post('/api/business-areas/:id/resources', requirePerm('settings.products.edit'), validate('param', z.object({ id: z.uuid() })),
+    validate('json', z.object({ kind: z.enum(Object.keys(AREA_RESOURCE_TABLES) as ['product', 'flow', 'integration', 'account', 'pixel', 'link']), resource_id: z.uuid() })), async c => {
+      const b = c.req.valid('json'), binding = await svc.assign(company(c), c.req.param('id'), b.kind, b.resource_id)
+      setAudit(c, { action: 'business_areas.assign', targetType: b.kind, targetId: b.resource_id, detail: { business_area_id: binding.area_id } })
+      return c.json({ binding }, 201)
+    })
+  app.post('/api/business-areas/:id/adopt-offer', requirePerm('settings.products.edit'), validate('param', z.object({ id: z.uuid() })),
+    validate('json', z.object({ offer_id: z.uuid(), confirm: z.literal(true) })), async c => {
+      const result = await svc.adoptOffer(company(c), c.req.param('id'), c.req.valid('json').offer_id)
+      setAudit(c, { action: 'business_areas.adopt_offer', targetType: 'offer', targetId: result.offer_id, detail: { business_area_id: result.business_area_id } })
+      return c.json(result)
+    })
+  return app
+}
