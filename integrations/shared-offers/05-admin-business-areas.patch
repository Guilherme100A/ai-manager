+import { useEffect, useState } from 'react'
+import { api, activeBusinessArea, selectBusinessArea } from '@/lib/http'
+import { appPath } from '@/lib/base'
+
+interface Area { id: string; slot: number; name: string; bm_id: string | null }
+interface Resource { id: string; name: string; area_id: string | null }
+const labels: Record<string, string> = { product: 'Produtos', integration: 'Contas XPag / pagamentos', account: 'Contas de anúncios', pixel: 'Pixels', link: 'Links rastreáveis', flow: 'Fluxos' }
+
+export function BusinessAreaSwitcher({ companyId }: { companyId: string }) {
+  const [areas, setAreas] = useState<Area[]>([]), [error, setError] = useState('')
+  useEffect(() => { void api.get<{ items: Area[] }>('/api/business-areas').then(r => setAreas(r.items)).catch(() => setError('Não foi possível carregar as áreas')) }, [companyId])
+  if (!areas.length) return error ? <p role="alert">{error}</p> : null
+  return <label className="block px-2 text-sm" data-testid="business-area-switcher">
+    Área de negócio
+    <select aria-label="Área de negócio" className="mt-1 w-full rounded border bg-background p-2" value={activeBusinessArea() ?? ''} onChange={e => {
+      selectBusinessArea(e.target.value || null)
+      // Clears all query/editor caches and pending unsaved forms from the previous area.
+      window.location.assign(appPath('/offers') + window.location.search)
+    }}>
+      <option value="">Sem área (cadastros existentes)</option>
+      {areas.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}
+    </select>
+    {activeBusinessArea() && <small className="block" data-testid="business-area-bm">BM declarada: {areas.find(a => a.id === activeBusinessArea())?.bm_id ?? 'não informada'}</small>}
+  </label>
+}
+
+export function BusinessAreaManager() {
+  const [areas, setAreas] = useState<Area[]>([]), [catalog, setCatalog] = useState<Record<string, Resource[]>>({}),
+    [selected, setSelected] = useState(activeBusinessArea() ?? ''), [name, setName] = useState(''), [bm, setBm] = useState(''),
+    [offers, setOffers] = useState<{ id: string; name: string }[]>([]), [adopt, setAdopt] = useState(''),
+    [error, setError] = useState(''), [notice, setNotice] = useState(''), [busy, setBusy] = useState(false)
+  const load = async () => {
+    const [a, c, o] = await Promise.all([
+      api.get<{ items: Area[] }>('/api/business-areas'), api.get<Record<string, Resource[]>>('/api/business-areas/catalog'),
+      api.get<{ items: { id: string; name: string }[] }>('/api/offers', { headers: { 'X-Business-Area-Id': '' } }),
+    ])
+    setAreas(a.items); setCatalog(c); setOffers(o.items)
+  }
+  const run = async (fn: () => Promise<void>) => {
+    setError(''); setNotice(''); setBusy(true)
+    try { await fn() } catch (e) { setError(e instanceof Error ? e.message : 'Falha ao configurar áreas') } finally { setBusy(false) }
+  }
+  useEffect(() => { void run(load) }, [])
+  useEffect(() => { const a = areas.find(a => a.id === selected); setName(a?.name ?? ''); setBm(a?.bm_id ?? '') }, [selected, areas])
+  return <details data-testid="business-area-manager">
+    <summary>Organizar Admin 1 / Admin 2 / Admin 3</summary>
+    <p>Uma conta e três áreas de negócio. O mesmo chip pode ser compartilhado. A área define quais ofertas, fluxos, pagamentos e contas de anúncios podem ser combinados.</p>
+    <p>Todos continuam administradores da mesma conta e podem trocar de área. Esta seleção não identifica pessoas nem cria senhas ou usuários.</p>
+    {error && <p role="alert">{error}</p>}{notice && <p role="status">{notice}</p>}
+    {!areas.length ? <button type="button" disabled={busy} onClick={() => void run(async () => {
+      await api.post('/api/business-areas/initialize', {}); window.location.reload()
+    })}>Criar as três áreas sem mover cadastros</button> : <>
+      <label>Área a configurar<select aria-label="Área a configurar" value={selected} onChange={e => { setSelected(e.target.value); setAdopt('') }}>
+        <option value="">Selecione uma área</option>{areas.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}
+      </select></label>
+      {selected && <>
+        <label>Nome da área<input aria-label="Nome da área" maxLength={80} value={name} onChange={e => setName(e.target.value)} /></label>
+        <label>ID da BM<input aria-label="ID da BM" inputMode="numeric" maxLength={32} value={bm} onChange={e => setBm(e.target.value)} /></label>
+        <p>Identificação declarada da BM. Não concede acesso à Meta nem verifica sua propriedade. Vincule abaixo a conta de anúncios já conectada.</p>
+        <button type="button" disabled={busy || !name.trim()} onClick={() => void run(async () => {
+          await api.put('/api/business-areas/' + selected, { name, bm_id: bm || null }); await load(); setNotice('Área salva')
+        })}>Salvar nome e BM</button>
+        <fieldset><legend>Atribuir oferta existente com seus recursos</legend>
+          <p>Atribui o conjunto completo sem alterar destinos, ativação ou históricos. Recursos de outra área impedem a operação inteira.</p>
+          <select aria-label="Oferta existente sem área" value={adopt} onChange={e => setAdopt(e.target.value)}>
+            <option value="">Selecione uma oferta sem área</option>{offers.map(o => <option key={o.id} value={o.id}>{o.name}</option>)}
+          </select>
+          <button type="button" disabled={busy || !adopt} onClick={() => void run(async () => {
+            await api.post(`/api/business-areas/${selected}/adopt-offer`, { offer_id: adopt, confirm: true }); setAdopt(''); await load(); setNotice('Oferta e recursos atribuídos à área selecionada')
+          })}>Confirmar atribuição da oferta e recursos</button>
+        </fieldset>
+        {Object.entries(labels).map(([kind, label]) => <fieldset key={kind}><legend>{label}</legend>
+          <p>Cadastros atribuídos a outra área não são transferidos.</p>
+          {(catalog[kind] ?? []).map(r => <div key={r.id} className="origin-row">
+            <span>{r.name} · {areas.find(a => a.id === r.area_id)?.name ?? 'Sem área'}</span>
+            {!r.area_id && <button type="button" disabled={busy} onClick={() => void run(async () => {
+              await api.post(`/api/business-areas/${selected}/resources`, { kind, resource_id: r.id }); await load(); setNotice('Recurso atribuído')
+            })}>Atribuir a {areas.find(a => a.id === selected)?.name}</button>}
+          </div>)}
+        </fieldset>)}
+      </>}
+    </>}
+  </details>
+}
