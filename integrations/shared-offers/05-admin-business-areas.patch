+++ b/packages/core/src/business-areas/service.ts
@@ -0,0 +1,159 @@
+import { sql, type SQL } from 'drizzle-orm'
+import type { Database } from '@crm/db'
+import { isSharedOffersCompany, requireSharedOffersCompany } from '../offers/policy'
+
+export const AREA_RESOURCE_TABLES = {
+  product: 'products', flow: 'flows', integration: 'payment_integrations',
+  account: 'meta_ad_accounts', pixel: 'pixel_configs', link: 'tracked_links',
+} as const
+export type AreaResourceKind = keyof typeof AREA_RESOURCE_TABLES
+export interface BusinessArea { id: string; company_id: string; slot: number; name: string; bm_id: string | null }
+export class BusinessAreaError extends Error {
+  constructor(readonly code: 'not_found' | 'conflict' | 'validation', message: string) { super(message) }
+}
+const rows = async <T>(db: Database, query: SQL) => (await db.execute(query)).rows as T[]
+const uuid = (v: unknown): v is string => typeof v === 'string' && /^[a-f\d]{8}(-[a-f\d]{4}){3}-[a-f\d]{12}$/i.test(v)
+const refs: Record<string, AreaResourceKind> = {
+  product_id: 'product', flow_id: 'flow', target_flow_id: 'flow', integration_id: 'integration',
+  payment_integration_id: 'integration', ad_account_id: 'account', pixel_id: 'pixel', pixel_config_id: 'pixel',
+}
+
+/** Business partitions of ONE account. They do not authenticate different people. */
+export class BusinessAreasService {
+  constructor(readonly db: Database) {}
+  async administrator(company: string, userId: string | null | undefined) {
+    if (!userId || !isSharedOffersCompany(company)) return false
+    // A company has exactly one owner. A different admin/member, even with all permissions, is not this account.
+    return (await rows(this.db, sql`select 1 from crm.company_members where company_id=${company} and user_id=${userId} and role='owner'`)).length === 1
+  }
+  async list(company: string) {
+    requireSharedOffersCompany(company)
+    return rows<BusinessArea>(this.db, sql`select * from crm.business_areas where company_id=${company} order by slot`)
+  }
+  async enabled(company: string) {
+    return isSharedOffersCompany(company) && (await this.list(company)).length > 0
+  }
+  async get(company: string, id: string) {
+    requireSharedOffersCompany(company)
+    if (!uuid(id)) throw new BusinessAreaError('not_found', 'Área não encontrada')
+    const [area] = await rows<BusinessArea>(this.db, sql`select * from crm.business_areas where company_id=${company} and id=${id}`)
+    if (!area) throw new BusinessAreaError('not_found', 'Área não encontrada')
+    return area
+  }
+  async initialize(company: string) {
+    requireSharedOffersCompany(company)
+    await this.db.execute(sql`insert into crm.business_areas(company_id,slot,name)
+      select ${company}::uuid,n,'Admin '||n from generate_series(1,3) n on conflict(company_id,slot) do nothing`)
+    return this.list(company)
+  }
+  async update(company: string, id: string, input: { name: string; bm_id: string | null }) {
+    if (!input.name.trim() || input.name.trim().length > 80 || (input.bm_id !== null && !/^\d{1,32}$/.test(input.bm_id)))
+      throw new BusinessAreaError('validation', 'Informe nome válido e o ID numérico da BM, ou deixe a BM vazia')
+    return this.db.transaction(async tx => {
+      const db = tx as unknown as Database
+      await db.execute(sql`select pg_advisory_xact_lock(hashtextextended(${`business-areas:${company}`},0))`)
+      await new BusinessAreasService(db).get(company,id)
+      // BM is an explicit organizational identifier, not a claim of verified Meta ownership.
+      const existing = input.bm_id && await rows(db, sql`select 1 from crm.business_areas where company_id=${company} and bm_id=${input.bm_id} and id<>${id}::uuid`)
+      if (existing && existing.length) throw new BusinessAreaError('conflict', 'Esta BM já está em outra área')
+      return (await rows<BusinessArea>(db, sql`update crm.business_areas set name=${input.name.trim()},bm_id=${input.bm_id} where company_id=${company} and id=${id} returning *`))[0]!
+    })
+  }
+  async owner(company: string, kind: AreaResourceKind, id: string) {
+    return (await rows<{ area_id: string }>(this.db, sql`select area_id from crm.business_area_resources where company_id=${company} and kind=${kind} and resource_id=${id}`))[0]?.area_id ?? null
+  }
+  async allowed(company: string, area: string | null, kind: AreaResourceKind, id: string) {
+    if (!uuid(id)) return false
+    const table = AREA_RESOURCE_TABLES[kind]
+    if (!(await rows(this.db, sql`select 1 from crm.${sql.raw(table)} where company_id=${company} and id=${id}`)).length) return false
+    return (await this.owner(company, kind, id)) === area
+  }
+  async assertResource(company: string, area: string | null, kind: AreaResourceKind, id: string) {
+    if (!await this.allowed(company, area, kind, id)) throw new BusinessAreaError('not_found', 'Recurso não pertence à área selecionada')
+  }
+  async filter<T extends { id: string }>(company: string, area: string | null, kind: AreaResourceKind, items: T[]) {
+    const bindings = await rows<{ resource_id: string; area_id: string }>(this.db, sql`select resource_id,area_id from crm.business_area_resources where company_id=${company} and kind=${kind}`)
+    const owners = new Map(bindings.map(r => [r.resource_id, r.area_id]))
+    return items.filter(item => (owners.get(item.id) ?? null) === area)
+  }
+  async assertReferences(company: string, area: string | null, value: unknown, depth = 0): Promise<void> {
+    if (depth > 30) throw new BusinessAreaError('validation', 'Configuração excede o limite de profundidade')
+    if (Array.isArray(value)) { for (const v of value) await this.assertReferences(company, area, v, depth + 1); return }
+    if (!value || typeof value !== 'object') return
+    for (const [key, v] of Object.entries(value)) {
+      const kind = refs[key]
+      if (key === 'product_public_id' && v !== null && v !== undefined && v !== '') {
+        const product = uuid(v) ? (await rows<{ id: string }>(this.db, sql`select id from crm.products where company_id=${company} and public_id=${v}`))[0] : null
+        if (!product || !await this.allowed(company,area,'product',product.id)) throw new BusinessAreaError('validation','Produto da venda não pertence à área selecionada')
+      } else if (area && ['note_issuer_id','utmify_integration_id'].includes(key) && v) {
+        throw new BusinessAreaError('validation','Integrações de nota fiscal/UTMify globais não podem ser usadas como destino de uma área')
+      } else if (kind && v !== null && v !== undefined && v !== '') {
+        // Expressions may be evaluated later by a flow: never accept a dynamic payment/pixel destination in a partition.
+        if (!uuid(v) || !await this.allowed(company, area, kind, v))
+          throw new BusinessAreaError('validation', `Referência ${key} não pertence à área selecionada`)
+      } else if (typeof v === 'object') await this.assertReferences(company, area, v, depth + 1)
+    }
+  }
+  async assign(company: string, area: string, kind: AreaResourceKind, id: string) {
+    requireSharedOffersCompany(company)
+    return this.db.transaction(async tx => {
+      const db = tx as unknown as Database, svc = new BusinessAreasService(db)
+      // Serialize assignments with offer/flow edits using the same company advisory lock.
+      await db.execute(sql`select pg_advisory_xact_lock(hashtextextended(${`business-areas:${company}`},0))`)
+      area = (await svc.get(company, area)).id
+      const table = AREA_RESOURCE_TABLES[kind]
+      if (!table || !uuid(id) || !(await rows(db, sql`select 1 from crm.${sql.raw(table)} where company_id=${company} and id=${id} for update`)).length)
+        throw new BusinessAreaError('not_found', 'Recurso não encontrado nesta empresa')
+      const owner = await svc.owner(company, kind, id)
+      if (owner && owner !== area) throw new BusinessAreaError('conflict', 'Recurso já atribuído a outra área; não será transferido')
+      // Existing offers must be explicitly adopted together with their complete resource bundle.
+      const key = Object.entries(refs).find(([k, v]) => v === kind && k !== 'target_flow_id')?.[0]
+      if (key && (await rows(db, sql`select 1 from crm.offers where company_id=${company} and config->>${key}=${id} and business_area_id is distinct from ${area}::uuid limit 1`)).length)
+        throw new BusinessAreaError('conflict', 'Recurso em oferta existente. Atribua a oferta completa pela opção de adoção explícita')
+      if (kind === 'link' && (await rows(db, sql`select 1 from crm.offers o where o.company_id=${company} and o.business_area_id is distinct from ${area}::uuid
+        and exists(select 1 from jsonb_array_elements(o.config->'origins') origin where origin->>'type'='link' and origin->>'value'=${id}) limit 1`)).length)
+        throw new BusinessAreaError('conflict', 'Link em oferta existente. Atribua a oferta completa pela opção de adoção explícita')
+      if (kind === 'flow') {
+        const actions = await rows<{ config: unknown }>(db, sql`select a.config from crm.flow_node_actions a join crm.flow_nodes n on n.id=a.node_id where a.company_id=${company} and n.flow_id=${id}`)
+        const versions = await rows<{ definition: unknown }>(db, sql`select v.definition from crm.flow_versions v join crm.flows f on f.id=v.flow_id and f.published_version=v.version where v.company_id=${company} and v.flow_id=${id}`)
+        for (const a of actions) await svc.assertReferences(company, area, a.config)
+        for (const v of versions) await svc.assertReferences(company, area, v.definition)
+      }
+      await db.execute(sql`insert into crm.business_area_resources(company_id,area_id,kind,resource_id) values(${company},${area},${kind},${id}) on conflict(company_id,kind,resource_id) do nothing`)
+      return { kind, resource_id: id, area_id: area }
+    })
+  }
+  async catalog(company: string) {
+    requireSharedOffersCompany(company)
+    const result: Record<string, unknown> = {}
+    for (const [kind, table] of Object.entries(AREA_RESOURCE_TABLES)) {
+      const name = kind === 'integration' ? sql.raw('r.label') : kind === 'account' ? sql.raw('coalesce(r.name,r.fb_account_id)') : sql.raw('r.name')
+      result[kind] = await rows(this.db, sql`select r.id,${name} as name,b.area_id from crm.${sql.raw(table)} r
+        left join crm.business_area_resources b on b.company_id=r.company_id and b.resource_id=r.id and b.kind=${kind}
+        where r.company_id=${company} order by name`)
+    }
+    return result
+  }
+  async adoptOffer(company: string, area: string, offerId: string) {
+    return this.db.transaction(async tx => {
+      const db = tx as unknown as Database, svc = new BusinessAreasService(db)
+      await db.execute(sql`select pg_advisory_xact_lock(hashtextextended(${`business-areas:${company}`},0))`)
+      area = (await svc.get(company, area)).id
+      if (!uuid(offerId)) throw new BusinessAreaError('not_found', 'Oferta não encontrada')
+      const [offer] = await rows<{ config: Record<string, unknown>; business_area_id: string | null }>(db, sql`select config,business_area_id from crm.offers where company_id=${company} and id=${offerId} for update`)
+      if (!offer) throw new BusinessAreaError('not_found', 'Oferta não encontrada')
+      if (offer.business_area_id && offer.business_area_id !== area) throw new BusinessAreaError('conflict', 'Oferta já atribuída a outra área')
+      await db.execute(sql`update crm.offers set business_area_id=${area},version=version+1,updated_at=now() where company_id=${company} and id=${offerId} and business_area_id is null`)
+      // Assign non-flow resources first so the existing flow's references can be checked.
+      for (const [key, kind] of Object.entries(refs).filter(([key, kind]) => kind !== 'flow' && key !== 'pixel_config_id' && key !== 'payment_integration_id')) {
+        const id = offer.config[key]
+        if (uuid(id)) await svc.assign(company, area, kind, id)
+      }
+      for (const origin of (offer.config.origins ?? []) as { type: string; value: string }[])
+        if (origin.type === 'link') await svc.assign(company, area, 'link', origin.value)
+      if (uuid(offer.config.flow_id)) await svc.assign(company, area, 'flow', offer.config.flow_id)
+      await svc.assertReferences(company, area, offer.config)
+      return { offer_id: offerId, business_area_id: area }
+    })
+  }
+}
