+import { sql } from 'drizzle-orm'
+import { check, foreignKey, index, integer, primaryKey, text, unique, uuid } from 'drizzle-orm/pg-core'
+import { crm } from './schema.js'
+import { companies } from './base.js'
+
+export const businessAreas = crm.table('business_areas', {
+  id: uuid('id').primaryKey().defaultRandom(), companyId: uuid('company_id').notNull().references(() => companies.id),
+  slot: integer('slot').notNull(), name: text('name').notNull(), bmId: text('bm_id'),
+}, t => [
+  unique().on(t.companyId,t.slot), unique().on(t.companyId,t.id), unique().on(t.companyId,t.bmId),
+  check('business_areas_slot_check',sql`${t.slot} between 1 and 3`),
+  check('business_areas_name_check',sql`length(btrim(${t.name})) between 1 and 80`),
+  check('business_areas_bm_id_check',sql`${t.bmId} is null or ${t.bmId} ~ '^[0-9]{1,32}$'`),
+])
+export const businessAreaResources = crm.table('business_area_resources', {
+  companyId: uuid('company_id').notNull(), areaId: uuid('area_id').notNull(), kind: text('kind').notNull(), resourceId: uuid('resource_id').notNull(),
+}, t => [
+  primaryKey({ columns:[t.companyId,t.kind,t.resourceId] }),
+  foreignKey({columns:[t.companyId,t.areaId],foreignColumns:[businessAreas.companyId,businessAreas.id]}),
+  index('business_area_resources_area_idx').on(t.companyId,t.areaId,t.kind),
+  check('business_area_resources_kind_check',sql`${t.kind} in ('product','flow','integration','account','pixel','link')`),
+])
