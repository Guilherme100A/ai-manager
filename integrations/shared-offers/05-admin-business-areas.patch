+  }
+  expect((await call('GET', '/api/payment-integrations', areas[0].id)).body.items.map((r: any) => r.id)).toEqual([bundles[0].integration_id])
+  expect((await call('GET', '/api/payment-integrations/' + bundles[1].integration_id, areas[0].id)).status).toBe(404)
+  expect((await call('PUT', '/api/meta/ad-accounts/' + bundles[1].ad_account_id, areas[0].id, { included_in_dashboard: false })).status).toBe(404)
