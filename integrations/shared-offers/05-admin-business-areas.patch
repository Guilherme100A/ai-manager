+// Runs against disposable CI infrastructure and fake providers, never a live chip/provider.
+/* eslint-disable @typescript-eslint/no-explicit-any -- acceptance JSON fixtures */
+import { randomUUID } from 'node:crypto'
+import { createServer, type Server } from 'node:http'
+import { readFileSync, existsSync } from 'node:fs'
+import { resolve, extname } from 'node:path'
+import { chromium, type Browser } from '@playwright/test'
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { startSystem, tenant, connectMeta, salesPixel, type System, type Tenant } from './setup'
+
+let sys: System, t: Tenant, foreign: Tenant, areas: any[], bundles: any[], oldOffer: any, writer: string, reader: string
+let server: Server, browser: Browser
+const previousGate = process.env.SHARED_OFFERS_COMPANY_ID
+const fixtureSecret = 'synthetic-area-xpag-never-contact-provider'
+let rpcId = 0
+async function call(method: string, path: string, area?: string, body?: unknown, account = t) {
+  const response = await sys.app.request(path, { method, headers: {
+    cookie: 'crm_session=' + account.token, 'x-company-id':account.companyId, 'x-requested-with': 'crm', 'content-type': 'application/json',
+    ...(area ? { 'x-business-area-id': area } : {}),
+  }, ...(body !== undefined ? { body: JSON.stringify(body) } : {}) })
+  return { status: response.status, body: await response.json().catch(() => null) as any }
+}
+async function tool(token: string, name: string, args: any = {}) {
+  const response = await sys.app.request('/api/mcp', { method: 'POST', headers: {
+    authorization: 'Bearer ' + token, 'content-type': 'application/json', accept: 'application/json, text/event-stream', 'mcp-protocol-version': '2025-06-18',
+  }, body: JSON.stringify({ jsonrpc: '2.0', id: ++rpcId, method: 'tools/call', params: { name, arguments: args } }) })
+  const body = await response.json() as any, result = body.result
+  let data: any = result?.content?.[0]?.text ?? body
+  if (typeof data === 'string') { try { data=JSON.parse(data) } catch { /* SDK errors can be plain text. */ } }
+  return { error: !!(body.error || result?.isError), data }
+}
+beforeAll(async () => {
+  sys = await startSystem(); t = await tenant(sys); foreign = await tenant(sys)
+  process.env.SHARED_OFFERS_COMPANY_ID = t.companyId
+  const accounts = await connectMeta(sys, t, 3), user = (await t.c.get('/api/auth/profile')).body.user.id
+  bundles = []
+  for (let i = 0; i < 3; i++) {
+    const product = (await t.c.post('/api/products', { name: 'Area product ' + i, currency: 'BRL', price_min_cents: 100, price_max_cents: 100, price_fallback_cents: 100 })).body.product
+    const integration = (await t.c.post('/api/payment-integrations', { gateway: 'xpag', label: 'Area XPag ' + i, client_id: 'area-client-' + i, client_secret: fixtureSecret })).body.integration
+    const pixel = await salesPixel(sys, t)
+    const [flow] = await sys.q("insert into crm.flows(company_id,name,status,published_version) values($1,$2,'active',1) returning id", [t.companyId, 'Area flow ' + i])
+    bundles.push({ owner_user_id: user, product_id: product.id, flow_id: flow.id, currency: 'BRL', connection_ids: [t.connectionId], integration_id: integration.id, ad_account_id: accounts[i]!.localId, pixel_id: pixel.id, origins: [] })
+  }
