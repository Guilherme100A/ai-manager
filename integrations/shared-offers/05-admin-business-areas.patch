index 0000000000000000000000000000000000000000..7f48e323b3dc2bca8a69c052a70bdcd66cdc3c63
--- /dev/null
+++ b/apps/api/src/middleware/business-area.ts
@@ -0,0 +1,88 @@
+import type { MiddlewareHandler } from 'hono'
+import { BusinessAreasService, BusinessAreaError, isSharedOffersCompany, type AreaResourceKind } from '@crm/core'
+import { sql } from 'drizzle-orm'
+import type { AppEnv, ResolvedDeps } from '../lib/types'
+import { ApiError } from '../lib/errors'
+import { setAudit } from './audit'
+
+export const BUSINESS_AREA_HEADER = 'x-business-area-id'
+const groups: [RegExp, AreaResourceKind, string][] = [
+  [/^\/api\/flows(?:\/([^/]+))?/, 'flow', 'flow'],
+  [/^\/api\/products(?:\/([^/]+))?/, 'product', 'product'],
+  [/^\/api\/payment-integrations(?:\/([^/]+))?/, 'integration', 'integration'],
+  [/^\/api\/meta\/pixels(?:\/([^/]+))?/, 'pixel', 'pixel'],
+  [/^\/api\/meta\/tracked-links(?:\/([^/]+))?/, 'link', 'link'],
+  [/^\/api\/meta\/ad-accounts(?:\/([^/]+))?/, 'account', 'ad_account'],
+]
+const staticNames = new Set(['names'])
+const scopedPath = (path: string) => groups.find(([re]) => re.test(path))
+class RollbackResponse extends Error {}
+
+/** Absent header = legacy resources that have not been assigned. Shared chips are not partitioned. */
+export function businessAreaContext(deps: ResolvedDeps): MiddlewareHandler<AppEnv> {
+  return async (c, next) => {
+    const ctx = c.get('ctx'), company = ctx?.companyId
+    if (!company || !isSharedOffersCompany(company)) {
+      if (c.req.header(BUSINESS_AREA_HEADER)) throw new ApiError('NOT_FOUND', 'Área não encontrada')
+      return next()
+    }
+    const svc = new BusinessAreasService(deps.db), requested = c.req.header(BUSINESS_AREA_HEADER)?.trim() || null
+    try {
+      const administrator = await svc.administrator(company,ctx?.user?.id)
+      if (requested && !administrator) throw new ApiError('NOT_FOUND','Área não encontrada')
+      const resolved = requested ? await svc.get(company, requested) : null
+      if (!requested && !await svc.enabled(company)) return next()
+      if (!administrator && (/^\/api\/(business-areas|offers|flows|flow-folders|flow-runs|products|payment-integrations|meta|sales|dashboard|exports)(\/|$)/.test(c.req.path)
+        || /^\/api\/chats\/[^/]+\/offers?$/.test(c.req.path))) throw new ApiError('NOT_FOUND','Recurso não encontrado')
+      const area = resolved?.id ?? null
+      c.set('businessArea', area)
+      setAudit(c, { detail: { business_area_id: area } })
+      const group = scopedPath(c.req.path)
+      const apply = async () => {
+        if (group) {
+          const [pattern, kind, key] = group, id = pattern.exec(c.req.path)?.[1]
+          if (id && !staticNames.has(id)) await svc.assertResource(company, area, kind, id)
+          if (kind === 'flow' && !['GET', 'HEAD', 'DELETE'].includes(c.req.method)) {
+            const raw = await c.req.raw.clone().text()
+            if (raw) {
+              let body: unknown
+              try { body = JSON.parse(raw) } catch { throw new ApiError('MALFORMED_REQUEST', 'JSON inválido') }
+              await svc.assertReferences(company, area, body)
+            }
+          }
+          await next()
+          if (c.res.status >= 400 || c.res.status === 204 || !c.res.headers.get('content-type')?.includes('application/json')) return
+          const body = await c.res.clone().json() as Record<string, unknown>
+          if (c.req.method === 'GET' && (!id || staticNames.has(id)) && Array.isArray(body.items)) {
+            body.items = await svc.filter(company, area, kind, body.items as { id: string }[])
+            c.res = new Response(JSON.stringify(body), c.res)
+          }
+          if (c.req.method === 'POST' && (!id || (kind === 'flow' && c.req.path.endsWith('/duplicate'))) && area) {
+            const created = body[key] as { id?: string } | undefined
+            if (created?.id) await deps.db.execute(sql`insert into crm.business_area_resources(company_id,area_id,kind,resource_id)
+              values(${company},${area},${kind},${created.id})`)
+          }
+          return
+        }
+        // Meta profiles are credentials shared by accounts. Scoped mutation would affect other areas.
+        if (area && /^\/api\/meta\/profiles\/[^/]+/.test(c.req.path) && c.req.method !== 'GET')
+          throw new ApiError('CONFLICT', 'Gerencie credenciais Meta no cadastro geral; esta operação afeta todas as áreas')
+        await next()
+      }
+      // Hold assignment lock through the API mutation so destinations cannot change area mid-edit.
+      const lifecycle = /\/flows\/[^/]+\/(activate|pause|archive|unarchive)$/.test(c.req.path)
+      if ((group || c.req.path.startsWith('/api/offers')) && !lifecycle && !['GET', 'HEAD'].includes(c.req.method)) {
+        try {
+          await deps.areaTransaction(async tx => {
+            await tx.execute(sql`select pg_advisory_xact_lock(hashtextextended(${`business-areas:${company}`},0))`)
+            await apply()
+            if (c.res.status >= 400) throw new RollbackResponse()
+          })
+        } catch (err) { if (!(err instanceof RollbackResponse)) throw err }
+      } else await apply()
+    } catch (err) {
+      if (err instanceof BusinessAreaError) throw new ApiError(({ not_found: 'NOT_FOUND', conflict: 'CONFLICT', validation: 'VALIDATION_ERROR' } as const)[err.code], err.message)
+      throw err
+    }
+  }
+}
