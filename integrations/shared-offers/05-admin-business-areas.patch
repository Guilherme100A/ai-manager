diff --git a/apps/api/src/lib/request-db.node.test.mjs b/apps/api/src/lib/request-db.node.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..915d518a3ac84084bba217b942d4e7a89f8f0c1c
--- /dev/null
+++ b/apps/api/src/lib/request-db.node.test.mjs
@@ -0,0 +1,37 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { requestDatabase } from './request-db.ts'
+
+function fixture() {
+  const events = [], database = { name: 'pool', read() { return this.name }, async transaction(work) {
+    const name = 'tx-' + events.length, tx = { name, read() { return this.name } }
+    events.push(['begin', name])
+    try { const result = await work(tx); events.push(['commit', name]); return result }
+    catch (error) { events.push(['rollback', name]); throw error }
+  } }
+  return { ...requestDatabase(database), events }
+}
+test('ordinary requests keep the original database receiver', () => {
+  const { db } = fixture(); assert.equal(db.read(), 'pool')
+})
+test('concurrent requests use their own transaction across asynchronous work', async () => {
+  const { db, transaction, events } = fixture()
+  const results = await Promise.all(Array.from({ length: 3 }, (_, i) => transaction(async tx => {
+    const first = db.read(); await new Promise(resolve => setTimeout(resolve, 4 - i))
+    assert.equal(db.read(), first); assert.equal(first, tx.name); return first
+  })))
+  assert.equal(new Set(results).size, 3); assert.equal(db.read(), 'pool')
+  assert.equal(events.filter(e => e[0] === 'commit').length, 3)
+})
+test('a rejected operation rolls back and cannot leave the next request attached to it', async () => {
+  const { db, transaction, events } = fixture()
+  await assert.rejects(transaction(async () => { assert.notEqual(db.read(), 'pool'); throw new Error('synthetic abort') }), /synthetic abort/)
+  assert.equal(events.at(-1)[0], 'rollback'); assert.equal(db.read(), 'pool')
+})
+test('background callbacks inherited from a completed request cannot reuse its closed transaction', async () => {
+  const { db, transaction } = fixture()
+  let resume, observed
+  const pending = new Promise(resolve => { resume = resolve })
+  await transaction(async () => { observed = pending.then(() => db.read()); assert.notEqual(db.read(), 'pool') })
+  resume(); assert.equal(await observed, 'pool')
+})
diff --git a/apps/api/src/lib/request-db.ts b/apps/api/src/lib/request-db.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7c41d09cba620f507ca2f557f1e67c391ee1a56e
--- /dev/null
+++ b/apps/api/src/lib/request-db.ts
@@ -0,0 +1,24 @@
+import { AsyncLocalStorage } from 'node:async_hooks'
+import type { Database } from '@crm/db'
+
+type Scope = { database: Database; active: boolean }
+/** All services constructed by createApp share this facade, but concurrent requests never share a transaction. */
+export function requestDatabase(database: Database) {
+  const storage = new AsyncLocalStorage<Scope>()
+  const db = new Proxy(database, {
+    get(target, key) {
+      const scope = storage.getStore(), source = scope?.active && key in scope.database ? scope.database : target
+      const value = Reflect.get(source, key, source)
+      return typeof value === 'function' ? value.bind(source) : value
+    },
+  })
+  return {
+    db,
+    transaction: <T>(work: (tx: Database) => Promise<T>) => database.transaction(async tx => {
+      const scope: Scope = { database: tx as unknown as Database, active: true }
+      return storage.run(scope, async () => {
+        try { return await work(scope.database) } finally { scope.active = false }
+      })
+    }),
+  }
+}
