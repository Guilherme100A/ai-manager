@@ -0,0 +1,299 @@
+import { Dialog } from '@base-ui/react/dialog'
+import { useEffect, useState } from 'react'
+import { Button } from '@/components/ui/button'
+import { useSession } from '@/features/settings-company/ui'
+import { Field, inputClass, serverMessage } from '@/features/settings-quick-replies/kit'
+import { api } from '@/lib/http'
+import { hasAny } from '@/lib/session'
+import { notify } from '@/lib/toast'
+
+type FlowRef = { id: string; name: string; status: 'draft' | 'active' | 'paused' | 'archived'; workspace_owned?: boolean }
+
+type Item = { id: string; name: string; currency?: string }
+type Origin = { type: 'source_id' | 'link'; value: string }
+type CommercialConfig = {
+  owner_user_id: string
+  product_id: string
+  currency: string
+  connection_ids: string[]
+  integration_id: string
+  ad_account_id: string
+  pixel_id: string
+  origins: Origin[]
+  cost_cents: number | null
+  cost_label: string
+}
+type SelectKey = 'owner_user_id' | 'product_id' | 'integration_id' | 'ad_account_id' | 'pixel_id'
+type Commercial = { id: string; active: boolean; version: number; config: CommercialConfig }
+type Resources = {
+  members: Item[]
+  products: Item[]
+  connections: Item[]
+  integrations: Item[]
+  accounts: Item[]
+  pixels: (Item & { meta_ad_account_id?: string | null })[]
+  links: Item[]
+  managed_connections: string[]
+}
+type Response = { commercial: Commercial | null; resources: Resources; can_save: boolean }
+type Result = {
+  offer_id: string
+  currency: string
+  sales: number
+  revenue_cents: string
+  costs_complete: boolean
+  estimated_profit_cents: string | null
+}
+
+const blank = (owner: string): CommercialConfig => ({
+  owner_user_id: owner,
+  product_id: '',
+  currency: 'BRL',
+  connection_ids: [],
+  integration_id: '',
+  ad_account_id: '',
+  pixel_id: '',
+  origins: [],
+  cost_cents: null,
+  cost_label: '',
+})
+
+// The server derives the flow ID and name from the route. Never copy a flow ID from the browser payload.
+const payload = (config: CommercialConfig): CommercialConfig => ({
+  owner_user_id: config.owner_user_id,
+  product_id: config.product_id,
+  currency: config.currency,
+  connection_ids: config.connection_ids,
+  integration_id: config.integration_id,
+  ad_account_id: config.ad_account_id,
+  pixel_id: config.pixel_id,
+  origins: config.origins,
+  cost_cents: config.cost_cents,
+  cost_label: config.cost_label,
+})
+
+export function CommercialDialog({ flow, onClose }: { flow: FlowRef | null; onClose: () => void }) {
+  const session = useSession()
+  const canView = !!session && hasAny(session, ['settings.products.view'])
+  const canEdit = !!session && hasAny(session, ['flows.edit']) && hasAny(session, ['settings.products.edit']) && flow?.workspace_owned !== false
+  const [data, setData] = useState<Response | null>(null)
+  const [config, setConfig] = useState<CommercialConfig>(blank(''))
+  const [active, setActive] = useState(false)
+  const [loading, setLoading] = useState(false)
+  const [saving, setSaving] = useState(false)
+  const [chipPending, setChipPending] = useState<string | null>(null)
+  const [results, setResults] = useState<Result[] | null>(null)
+  const [resultsError, setResultsError] = useState(false)
+  const [error, setError] = useState('')
+  const canSave = canEdit && data?.can_save === true
+  const complete = Boolean(config.owner_user_id && config.product_id && config.integration_id &&
+    config.ad_account_id && config.pixel_id && config.connection_ids.length &&
+    config.origins.every(origin => origin.value.trim()))
+
+  useEffect(() => {
+    if (!flow || !canView) return
+    let cancelled = false
+    setLoading(true)
+    setData(null)
+    setError('')
+    setResults(null)
+    setResultsError(false)
+    void api.get<Response>(`/api/flows/${encodeURIComponent(flow.id)}/commercial`)
+      .then(result => {
+        if (cancelled) return
+        setData(result)
+        setConfig(result.commercial ? payload(result.commercial.config) : blank(session?.user.id ?? ''))
+        setActive(flow.status === 'active' && (result.commercial?.active ?? false))
+        if (!result.commercial) {
+          setResults([])
+          return
+        }
+        void api.get<{ items: Result[] }>('/api/offers/results', { query: { offer: result.commercial.id } })
+          .then(report => { if (!cancelled) setResults(report.items) })
+          .catch(() => { if (!cancelled) setResultsError(true) })
+      })
+      .catch(err => { if (!cancelled) setError(serverMessage(err) ?? 'Não foi possível carregar esta configuração.') })
+      .finally(() => { if (!cancelled) setLoading(false) })
+    return () => { cancelled = true }
+  }, [flow?.id, canView, session?.user.id])
+
+  function update<K extends keyof CommercialConfig>(key: K, value: CommercialConfig[K]) {
+    setConfig(previous => ({ ...previous, [key]: value }))
+  }
+
+  async function save() {
+    if (!flow || !data || !canSave || !complete) return
+    setSaving(true)
+    setError('')
+    try {
+      const result = await api.put<{ commercial: Commercial }>(
+        `/api/flows/${encodeURIComponent(flow.id)}/commercial`,
+        { active: flow.status === 'active' && active, config: payload(config) },
+      )
+      setData(previous => previous && { ...previous, commercial: result.commercial })
+      if (!data.commercial) setResults([])
+      notify('success', 'Configuração do fluxo salva')
+      onClose()
+    } catch (err) {
+      setError(serverMessage(err) ?? 'Não foi possível salvar a configuração do fluxo.')
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  async function toggleChip(connectionId: string, enabled: boolean) {
+    if (!flow || !data?.commercial?.active || !canSave ||
+      !data.commercial.config.connection_ids.includes(connectionId)) return
+    const name = data.resources.connections.find(item => item.id === connectionId)?.name ?? 'chip'
+    const warning = enabled
+      ? `Ativar a modalidade comercial no ${name}? Isso afeta o chip compartilhado: entradas sem vínculo ficam para atendimento manual e gatilhos legados deixam de iniciar fluxos nele.`
+      : `Desativar a modalidade comercial no ${name}? Isso afeta todos os fluxos que usam esse chip.`
+    if (!window.confirm(warning)) return
+    setChipPending(connectionId)
+    setError('')
+    try {
+      await api.put(`/api/offers/chips/${encodeURIComponent(connectionId)}`, { enabled })
+      const response = await api.get<Response>(`/api/flows/${encodeURIComponent(flow.id)}/commercial`)
+      setData(response)
+      notify('success', enabled ? 'Modalidade comercial ativada no chip' : 'Modalidade comercial desativada no chip')
+    } catch (err) {
+      setError(serverMessage(err) ?? 'Não foi possível alterar o modo deste chip.')
+    } finally {
+      setChipPending(null)
+    }
+  }
+
+  const resources = data?.resources
+  const money = (cents: string, currency: string) =>
+    new Intl.NumberFormat('pt-BR', { style: 'currency', currency }).format(Number(cents) / 100)
+  const selectedPixels = resources?.pixels.filter(pixel => !config.ad_account_id || pixel.meta_ad_account_id === config.ad_account_id) ?? []
+  const select = (label: string, key: SelectKey, items: Item[]) => (
+    <Field label={label} htmlFor={`flow-commercial-${key}`}>
+      <select id={`flow-commercial-${key}`} className={inputClass} value={String(config[key])}
+        disabled={!canSave}
+        onChange={event => key === 'ad_account_id'
+          ? setConfig(previous => ({ ...previous, ad_account_id: event.target.value, pixel_id: '' }))
+          : update(key, event.target.value)}>
+        <option value="">Selecione</option>
+        {items.map(item => <option key={item.id} value={item.id}>{item.name}</option>)}
+      </select>
+    </Field>
+  )
+
+  return (
+    <Dialog.Root open={!!flow} onOpenChange={open => !open && onClose()}>
+      <Dialog.Portal>
+        <Dialog.Backdrop className="fixed inset-0 z-[70] bg-black/40" />
+        <Dialog.Popup data-testid="flow-commercial-dialog"
+          className="fixed top-1/2 left-1/2 z-[70] flex max-h-[calc(100dvh-2rem)] w-[min(54rem,calc(100vw-2rem))] -translate-x-1/2 -translate-y-1/2 flex-col rounded-xl border bg-background shadow-xl outline-none">
+          <Dialog.Title className="border-b px-5 py-4 text-lg font-semibold">Pagamentos e anúncios · {flow?.name}</Dialog.Title>
+          <div className="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto px-5 py-4 text-sm">
+            <p className="text-muted-foreground">Esta configuração pertence somente a este fluxo. Para outra combinação de produto, pagamento ou pixel, duplique o fluxo e configure a cópia. O valor cobrado é definido nos blocos de pagamento do editor.</p>
+            {flow?.status !== 'active' && <p role="status" className="rounded-md border border-amber-500/40 bg-amber-500/10 p-3">Você pode salvar a configuração inativa. Para receber entradas comerciais, publique e ative o fluxo depois. Abrir este painel não ativa nem envia mensagens.</p>}
+            {data && !data.can_save && <p role="status" className="rounded-md border p-3">Desarquive o fluxo para editar esta configuração.</p>}
+            {!canView && <p role="alert">Você não tem permissão para ver os recursos comerciais.</p>}
+            {loading && <p role="status">Carregando recursos…</p>}
+            {error && <p role="alert" data-testid="flow-commercial-error" className="text-destructive">{error}</p>}
+            {resources && <>
+              {(!resources.products.length || !resources.integrations.length || !resources.accounts.length || !resources.pixels.length) &&
+                <p role="status" className="rounded-md border p-3">Para completar esta configuração, cadastre o produto, conecte XPag e vincule conta de anúncios e pixel no workspace.</p>}
+              <div className="grid gap-3 sm:grid-cols-2">
+                {resources.members.length > 1 && select('Responsável pelo resultado', 'owner_user_id', resources.members)}
+                {select('Produto', 'product_id', resources.products)}
+                <Field label="Moeda" htmlFor="flow-commercial-currency">
+                  <select id="flow-commercial-currency" className={inputClass} value={config.currency}
+                    disabled={!canSave} onChange={event => update('currency', event.target.value)}>
+                    {['BRL', 'MXN', 'USD', 'EUR'].map(currency => <option key={currency}>{currency}</option>)}
+                  </select>
+                </Field>
+                {select('Conta recebedora XPag', 'integration_id', resources.integrations)}
+                {select('Conta de anúncios', 'ad_account_id', resources.accounts)}
+                {select('Pixel de Purchase', 'pixel_id', selectedPixels)}
+              </div>
+              <fieldset className="rounded-md border p-3">
+                <legend className="px-1 font-medium">Chips usados neste fluxo</legend>
+                <div className="grid gap-2 sm:grid-cols-2">
+                  {resources.connections.map(chip => <label key={chip.id} className="flex items-center gap-2">
+                    <input type="checkbox" checked={config.connection_ids.includes(chip.id)}
+                      disabled={!canSave}
+                      onChange={event => update('connection_ids', event.target.checked
+                        ? [...config.connection_ids, chip.id] : config.connection_ids.filter(id => id !== chip.id))} />
+                    {chip.name}
+                  </label>)}
+                </div>
+                {config.connection_ids.length > 0 && <div className="mt-3 border-t pt-3">
+                  <p className="mb-2 text-xs text-muted-foreground">O modo comercial é global para cada chip. Ativá-lo muda o tratamento de entradas nesse chip, inclusive de outros fluxos. Salve e habilite a configuração deste fluxo antes de alterar o modo do chip.</p>
+                  {resources.connections.filter(chip => config.connection_ids.includes(chip.id)).map(chip => <label key={chip.id} className="flex items-center gap-2 py-1">
+                    <input type="checkbox" checked={resources.managed_connections.includes(chip.id)}
+                      disabled={!canSave || chipPending !== null || !data?.commercial?.active || !data?.commercial?.config.connection_ids.includes(chip.id)}
+                      onChange={event => void toggleChip(chip.id, event.target.checked)} />
+                    Modo comercial em {chip.name}
+                  </label>)}
+                </div>}
+              </fieldset>
+              <fieldset className="rounded-md border p-3">
+                <legend className="px-1 font-medium">Origem dos anúncios</legend>
+                <p className="mb-2 text-xs text-muted-foreground">Vincule um ID de anúncio ou link rastreável exato. A origem não será presumida pela hora da mensagem.</p>
+                {config.origins.map((origin, index) => <div key={index} className="mb-2 grid gap-2 sm:grid-cols-[12rem_1fr_auto]">
+                  <select aria-label={`Tipo de origem ${index + 1}`} className={inputClass} value={origin.type}
+                    disabled={!canSave}
+                    onChange={event => update('origins', config.origins.map((item, i) => i === index ? { type: event.target.value as Origin['type'], value: '' } : item))}>
+                    <option value="source_id">ID de anúncio</option><option value="link">Link rastreável</option>
+                  </select>
+                  {origin.type === 'link' ? <select aria-label={`Link de origem ${index + 1}`} className={inputClass} value={origin.value}
+                    disabled={!canSave}
+                    onChange={event => update('origins', config.origins.map((item, i) => i === index ? { ...item, value: event.target.value } : item))}>
+                    <option value="">Selecione o link</option>
+                    {resources.links.map(link => <option key={link.id} value={link.id}>{link.name}</option>)}
+                  </select> : <input aria-label={`ID de origem ${index + 1}`} className={inputClass} value={origin.value}
+                    disabled={!canSave}
+                    onChange={event => update('origins', config.origins.map((item, i) => i === index ? { ...item, value: event.target.value } : item))} />}
+                  <Button type="button" variant="outline" disabled={!canSave}
+                    onClick={() => update('origins', config.origins.filter((_, i) => i !== index))}>Remover</Button>
+                </div>)}
+                <Button type="button" variant="outline" disabled={!canSave}
+                  onClick={() => update('origins', [...config.origins, { type: 'source_id', value: '' }])}>Adicionar origem</Button>
+              </fieldset>
+              <div className="grid gap-3 sm:grid-cols-2">
+                <Field label="Custo declarado por venda (centavos)" htmlFor="flow-commercial-cost">
+                  <input id="flow-commercial-cost" type="number" min="0" step="1" className={inputClass} value={config.cost_cents ?? ''}
+                    disabled={!canSave}
+                    onChange={event => update('cost_cents', event.target.value === '' ? null : Number(event.target.value))} />
+                </Field>
+                <Field label="Descrição do custo" htmlFor="flow-commercial-cost-label">
+                  <input id="flow-commercial-cost-label" className={inputClass} value={config.cost_label}
+                    disabled={!canSave} onChange={event => update('cost_label', event.target.value)} />
+                </Field>
+              </div>
+              <p className="text-xs text-muted-foreground">Taxas XPag e gasto em anúncios não são incluídos automaticamente no lucro estimado.</p>
+              <label className="flex items-center gap-2 font-medium">
+                <input type="checkbox" checked={active} disabled={!canSave || flow?.status !== 'active'}
+                  onChange={event => setActive(event.target.checked)} />
+                Usar esta configuração para entradas comerciais deste fluxo
+              </label>
+              {data?.commercial && <section aria-labelledby="flow-commercial-results-title" className="rounded-md border p-3">
+                <h3 id="flow-commercial-results-title" className="font-semibold">Resultados deste fluxo</h3>
+                {resultsError ? <p role="status" className="mt-2 text-muted-foreground">Não foi possível carregar os resultados agora.</p>
+                  : results === null ? <p role="status" className="mt-2 text-muted-foreground">Carregando resultados…</p>
+                  : results.length === 0 ? <p className="mt-2 text-muted-foreground">Ainda não há vendas confirmadas para este fluxo.</p>
+                  : <ul className="mt-2 space-y-2">
+                    {results.map((item, index) => <li key={`${item.offer_id}-${item.currency}-${index}`} className="rounded-md bg-muted/50 p-2">
+                      <strong>{item.sales} {item.sales === 1 ? 'venda' : 'vendas'}</strong> · Receita {money(item.revenue_cents, item.currency)}
+                      <span className="block text-xs text-muted-foreground">{item.costs_complete && item.estimated_profit_cents !== null
+                        ? `Lucro estimado ${money(item.estimated_profit_cents, item.currency)}`
+                        : 'Custos incompletos; lucro não calculado.'}</span>
+                    </li>)}
+                  </ul>}
+              </section>}
+            </>}
+          </div>
+          <div className="flex justify-end gap-2 border-t px-5 py-3">
+            <Button type="button" variant="outline" onClick={onClose}>Fechar</Button>
+            {canEdit && <Button type="button" data-testid="flow-commercial-save" disabled={saving || loading || !canSave || !complete}
+              onClick={() => void save()}>{saving ? 'Salvando…' : 'Salvar configuração'}</Button>}
+          </div>
+        </Dialog.Popup>
+      </Dialog.Portal>
+    </Dialog.Root>
+  )
+}
