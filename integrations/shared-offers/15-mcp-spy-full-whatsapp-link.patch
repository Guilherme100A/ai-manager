diff --git a/packages/core/src/mcp/spy-capture-url.ts b/packages/core/src/mcp/spy-capture-url.ts
new file mode 100644
index 0000000000000000000000000000000000000000..974cd11d99ba437f876185dc2cd7e96c06d15ee3
--- /dev/null
+++ b/packages/core/src/mcp/spy-capture-url.ts
@@ -0,0 +1,32 @@
+export const MAX_SPY_CAPTURE_URL_LENGTH = 32_768
+
+const whatsappHosts = new Set(['wa.me', 'api.whatsapp.com', 'web.whatsapp.com', 'whatsapp.com', 'www.whatsapp.com'])
+const facebookHosts = new Set(['facebook.com', 'www.facebook.com', 'm.facebook.com', 'web.facebook.com', 'mbasic.facebook.com', 'fb.com', 'www.fb.com'])
+
+/** Preserve the capture destination, never the WhatsApp token or advertising parameters. */
+export function normalizeSpyCaptureInput(raw: string): string | null {
+  if (raw.length > MAX_SPY_CAPTURE_URL_LENGTH) return null
+  const value = raw.trim()
+  if (!/^https?:\/\//i.test(value)) return null
+  let url: URL
+  try {
+    url = new URL(value)
+  } catch {
+    return null
+  }
+  if (url.username || url.password || url.port) return null
+
+  if (whatsappHosts.has(url.hostname)) {
+    const numbers = url.searchParams.getAll('phone')
+    const phone = url.hostname === 'wa.me'
+      ? /^\/(\+?\d{10,15})\/?$/.exec(url.pathname)?.[1]
+      : /^\/send\/?$/.test(url.pathname) && numbers.length === 1
+        ? numbers[0]?.trim()
+        : undefined
+    if (!phone || !/^\+?\d{10,15}$/.test(phone)) return null
+    return `https://wa.me/${phone.replace(/^\+/, '')}`
+  }
+
+  // Keep the previous bound for Facebook links forwarded as received.
+  return value.length <= 2048 && facebookHosts.has(url.hostname) ? value : null
+}
diff --git a/packages/core/src/mcp/spy-capture-url.unit.test.ts b/packages/core/src/mcp/spy-capture-url.unit.test.ts
