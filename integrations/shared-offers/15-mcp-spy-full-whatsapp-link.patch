--- /dev/null
+++ b/packages/core/src/mcp/spy-capture-url.unit.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from 'vitest'
+import { MAX_SPY_CAPTURE_URL_LENGTH, normalizeSpyCaptureInput } from './spy-capture-url'
+
+describe('MCP WhatsApp capture links', () => {
+  const wa = 'https://api.whatsapp.com/send?phone=5511999900011'
+  const canonical = 'https://wa.me/5511999900011'
+
+  it('normalizes the full link to the same destination as a short link', () => {
+    expect(normalizeSpyCaptureInput(wa + '&source=FB_Post&token=' + 'fake.jwt.'.repeat(1000) + '#tracking')).toBe(canonical)
+    expect(normalizeSpyCaptureInput(canonical)).toBe(canonical)
+    expect(normalizeSpyCaptureInput('http://web.whatsapp.com/send/?phone=%2B5511999900011&text=ol%C3%A1')).toBe(canonical)
+  })
+
+  it.each([
+    wa + '&phone=5511999900022',
+    'https://api.whatsapp.com.evil.test/send?phone=5511999900011',
+    'https://api.whatsapp.com@evil.test/send?phone=5511999900011',
+    'https://api.whatsapp.com:8443/send?phone=5511999900011',
+    'https://wa.me/message/INVITE',
+    wa + '&token=' + 'x'.repeat(MAX_SPY_CAPTURE_URL_LENGTH),
+    'https://www.facebook.com/ads/library/?id=101&x=' + 'x'.repeat(2048),
+  ])('rejects malformed targets and over-limit links', url => {
+    expect(normalizeSpyCaptureInput(url)).toBeNull()
+  })
+
+  it('preserves a short Facebook capture URL', () => {
+    const facebook = 'https://www.facebook.com/ads/library/?id=101'
+    expect(normalizeSpyCaptureInput(facebook)).toBe(facebook)
+  })
+})
