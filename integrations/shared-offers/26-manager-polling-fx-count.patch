diff --git a/apps/web/src/features/facebook/campaigns-page.unit.test.tsx b/apps/web/src/features/facebook/campaigns-page.unit.test.tsx
new file mode 100644
index 0000000..57a735f
--- /dev/null
+++ b/apps/web/src/features/facebook/campaigns-page.unit.test.tsx
@@ -0,0 +1,116 @@
+// B-05: o Gerenciador não pode ficar preso em "carregando". Usa as MESMAS opções do useQuery da campaigns-page
+// (bundle-query.ts) com o QueryClient real, fetch fake e timers fake: (a) o polling de reserva continua com a aba em
+// segundo plano; (b) o SSE ready que chega antes do 202 entrar no cache não se perde.
+import { environmentManager, focusManager, QueryClient, QueryObserver } from '@tanstack/react-query'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { configureHttp } from '@/lib/http'
+import { bundleQueryKey, type BundleEnvelope, type BundleQuery, type BundleRow } from './api'
+import { bundleProgressHandler, bundleQueryOptions, POLL_MS, type BundleRefs } from './bundle-query'
+
+const COMPANY = '11111111-1111-4111-8111-111111111111'
+const K = 'bundle-key-b05'
+const BQ: BundleQuery = { status_filter: 'active', date_preset: 'today', display_currency: 'BRL', ad_account_ids: [] }
+
+const row = (id: string) => ({ id, ad_account_id: 'acc', ad_account_label: 'Conta', name: id, metrics: {} }) as unknown as BundleRow
+const envelope = (over: Partial<BundleEnvelope>): BundleEnvelope => ({
+  bundle_key: K,
+  status: 'loading',
+  campaign: [],
+  adset: [],
+  ad: [],
+  targets_done: 0,
+  targets_total: 3,
+  errors: [],
+  display_currency: 'BRL',
+  since: '2026-11-24',
+  until: '2026-11-24',
+  status_filter: 'active',
+  warnings: [],
+  cached: false,
+  generated_at: null,
+  ...over,
+})
+const loading = envelope({})
+const ready = envelope({ status: 'ready', targets_done: 3, campaign: [row('c1'), row('c2')], generated_at: '2026-11-24T12:00:00.000Z' })
+
+let replies: (() => Promise<{ status: number; body: BundleEnvelope }>)[]
+let gets: string[]
+const fakeFetch = vi.fn(async (input: RequestInfo | URL) => {
+  gets.push(String(input))
+  const next = replies.shift()
+  if (!next) throw new Error('GET inesperado')
+  const { status, body } = await next()
+  return new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } })
+})
+
+function observe() {
+  const qc = new QueryClient()
+  const key = bundleQueryKey(COMPANY, BQ)
+  const refs: BundleRefs = { mode: { current: 'async' }, stall: { current: { sig: null, count: 0 } }, query: { current: BQ }, lateProgress: { current: null } }
+  const observer = new QueryObserver(qc, bundleQueryOptions(qc, key, refs))
+  const unsubscribe = observer.subscribe(() => undefined)
+  return { qc, key, refs, observer, unsubscribe }
+}
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  replies = []
+  gets = []
+  fakeFetch.mockClear()
+  configureHttp({ fetch: fakeFetch as unknown as typeof fetch, companyId: COMPANY })
+  // Sem `window` o query-core se trata como servidor e não agenda timers: aqui ele age como no navegador.
+  environmentManager.setIsServer(() => false)
+  // Aba em segundo plano (document hidden): o query-core não dispara refetchInterval sem refetchIntervalInBackground.
+  focusManager.setFocused(false)
+})
+afterEach(() => {
+  focusManager.setFocused(undefined)
+  environmentManager.setIsServer(() => typeof window === 'undefined')
+  vi.useRealTimers()
+})
+
+describe('B-05 Gerenciador preso em carregando', () => {
+  it('a) aba oculta: 202 loading 0/3, depois 200 ready; o polling de reserva relê em 3 s e as linhas aparecem', async () => {
+    replies.push(async () => ({ status: 202, body: loading }), async () => ({ status: 200, body: ready }))
+    const { observer, unsubscribe } = observe()
+    await vi.advanceTimersByTimeAsync(0)
+    expect(gets).toHaveLength(1)
+    expect(gets[0]).toContain('async=1')
+    expect(observer.getCurrentResult().data?.status).toBe('loading')
+    await vi.advanceTimersByTimeAsync(POLL_MS)
+    expect(gets).toHaveLength(2)
+    const data = observer.getCurrentResult().data
+    expect(data?.status).toBe('ready')
+    expect(data?.campaign.map((r) => r.id)).toEqual(['c1', 'c2'])
+    unsubscribe()
+  })
+
+  it('b) aba oculta: SSE ready chega antes de o 1º GET (202) resolver → 2º GET imediato e a tela fica pronta', async () => {
+    let release!: () => void
+    const firstGet = new Promise<void>((r) => {
+      release = r
+    })
+    replies.push(
+      async () => {
+        await firstGet
+        return { status: 202, body: loading }
+      },
+      async () => ({ status: 200, body: ready }),
+    )
+    const { qc, key, refs, observer, unsubscribe } = observe()
+    await vi.advanceTimersByTimeAsync(0)
+    expect(gets).toHaveLength(1)
+    // O cache ainda não tem o 202: progressReadMode não tem com o que comparar.
+    expect(qc.getQueryData(key)).toBeUndefined()
+    bundleProgressHandler(qc, key, refs)({ bundle_key: K, status: 'ready', targets_done: 3, targets_total: 3 })
+    release()
+    // Bem antes do polling de reserva (3 s).
+    await vi.advanceTimersByTimeAsync(50)
+    expect(gets).toHaveLength(2)
+    expect(gets[1]).toContain('async=1')
+    const data = observer.getCurrentResult().data
+    expect(data?.status).toBe('ready')
+    expect(data?.campaign).toHaveLength(2)
+    unsubscribe()
+  })
+})
