+// Leitura do bundle do Gerenciador (T101/T106): opções do `useQuery` (modo async/sync/force, polling de reserva,
+// detecção de estagnação) e a reação ao SSE `meta.bundle.progress`. Fora do componente para ser testada com o
+// QueryClient real (campaigns-page.unit.test.tsx).
+import type { QueryClient, QueryKey } from '@tanstack/react-query'
+import { fetchBundle, type BundleEnvelope, type BundleMode, type BundleQuery } from './api'
+import type { BundleProgress } from './realtime'
+import { isRateLimited, progressReadMode, rowCount } from './rules'
+
+/** Polling de reserva enquanto o bundle está pendente (o SSE é o caminho normal). */
+export const POLL_MS = 3000
+/**
+ * Leituras `async` seguidas sem nenhum avanço (status, contas, linhas) antes de ler em modo `sync`. Bundle pronto com
+ * erro de conta não fica no cache do servidor, e o reenfileiramento com o mesmo jobId é deduplicado pelo BullMQ contra
+ * o job concluído: o estado ficaria `loading` até expirar (pendência registrada no relatório da T106).
+ */
+export const STALL_POLLS = 4
+export const CACHE_MS = 5 * 60_000
+
+/** Estado mutável da tela (refs do componente). */
+export interface BundleRefs {
+  mode: { current: BundleMode }
+  stall: { current: { sig: string | null; count: number } }
+  query: { current: BundleQuery }
+  /**
+   * `bundle_key` do último SSE ready/partial que chegou antes de o 202 dessa chave entrar no cache (B-05): sem ele,
+   * `progressReadMode` não tem com o que comparar e o evento se perde. Limpo na troca de filtros.
+   */
+  lateProgress: { current: string | null }
+}
+
+export const resetStall = (refs: BundleRefs) => {
+  refs.stall.current = { sig: null, count: 0 }
+}
+
+/** Opções do `useQuery` do bundle (sem `enabled`). */
+export function bundleQueryOptions(qc: QueryClient, key: QueryKey, refs: BundleRefs) {
+  return {
+    queryKey: key,
+    queryFn: async (): Promise<BundleEnvelope> => {
+      let mode = refs.mode.current
+      refs.mode.current = 'async'
+      if (mode === 'async' && refs.stall.current.count >= STALL_POLLS) mode = 'sync'
+      const res = await fetchBundle(refs.query.current, mode)
+      if (mode === 'async' && res.status !== 'ready') {
+        const sig = `${res.bundle_key}:${res.status}:${res.targets_done}:${rowCount(res)}`
+        refs.stall.current = { sig, count: sig === refs.stall.current.sig ? refs.stall.current.count + 1 : 0 }
+        if (res.bundle_key === refs.lateProgress.current) {
+          // O SSE já avisou ready/partial desta chave antes deste 202: relê uma vez, logo depois de o 202 entrar no cache.
+          refs.lateProgress.current = null
+          refs.mode.current = 'async'
+          setTimeout(() => void qc.refetchQueries({ queryKey: key, exact: true }), 0)
+        }
+      } else resetStall(refs)
+      return res
+    },
+    staleTime: (q: { state: { data?: BundleEnvelope } }) =>
+      q.state.data && q.state.data.status === 'ready' && !isRateLimited(q.state.data) ? CACHE_MS : 0,
+    gcTime: CACHE_MS,
+    refetchInterval: (q: { state: { data?: BundleEnvelope } }) => {
+      const d = q.state.data
+      if (!d || d.status === 'ready') return false
+      if (isRateLimited(d) && rowCount(d) === 0) return false
+      return POLL_MS
+    },
+    // O polling de reserva vale também com a aba em segundo plano (o query-core não dispara com document hidden).
+    refetchIntervalInBackground: true,
+    refetchOnWindowFocus: false,
+    retry: false,
+  } as const
+}
+
+/** SSE: parcial ou pronto → relê o estado em async (traz os erros de conta e o `rate_limited` do refresh; T129). */
+export function bundleProgressHandler(qc: QueryClient, key: QueryKey, refs: BundleRefs) {
+  return (p: BundleProgress) => {
+    const mode = progressReadMode(qc.getQueryData<BundleEnvelope>(key), p)
+    if (!mode) {
+      if (p.status === 'ready' || p.status === 'partial') refs.lateProgress.current = p.bundle_key
+      return
+    }
+    refs.mode.current = mode
+    void qc.refetchQueries({ queryKey: key, exact: true })
+  }
+}
