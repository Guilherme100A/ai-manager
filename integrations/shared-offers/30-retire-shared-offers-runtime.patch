+-- CRM-003: aposenta o fluxo de ofertas compartilhadas. Sem DROP de tabela, sem apagar histórico.
+-- 1) Aborta, com erro explicativo, se houver operação de oferta ativa que o código novo não sabe drenar.
+-- 2) Remove guards/índices específicos de oferta e libera o índice único de run ativo por contato.
+-- 3) Congela as tabelas legadas (INSERT/UPDATE recusados): nada é recobrado nem reenviado.
+DO $$
+DECLARE n bigint;
+BEGIN
+  SELECT count(*) INTO n FROM crm.offer_event_outbox WHERE status = 'pending';
+  IF n > 0 THEN
+    RAISE EXCEPTION 'migração 0049 abortada: % evento(s) de oferta pendente(s) em crm.offer_event_outbox (envio ao pixel ainda não confirmado). Esta versão não entrega mais esses eventos. Drene com a versão anterior (até status sent/discarded) e rode a migração de novo.', n;
+  END IF;
+
+  SELECT count(*) INTO n FROM crm.offer_sale_notifications WHERE status = 'pending';
+  IF n > 0 THEN
+    RAISE EXCEPTION 'migração 0049 abortada: % notificação(ões) de venda de oferta pendente(s) em crm.offer_sale_notifications. Esta versão não entrega mais essas notificações. Drene com a versão anterior (até status sent) e rode a migração de novo.', n;
+  END IF;
+
+  SELECT count(*) INTO n FROM crm.flow_runs WHERE offer_scoped AND status IN ('running', 'waiting');
+  IF n > 0 THEN
+    RAISE EXCEPTION 'migração 0049 abortada: % run(s) de fluxo de oferta ainda ativo(s) (running/waiting, offer_scoped). Eles dependem do contexto de oferta removido. Deixe terminar (ou pare por decisão do operador) e rode a migração de novo.', n;
+  END IF;
+
+  SELECT count(*) INTO n FROM crm.payment_charges
+   WHERE opportunity_id IS NOT NULL AND status = 'created' AND created_at > now() - interval '7 days';
+  IF n > 0 THEN
+    RAISE EXCEPTION 'migração 0049 abortada: % cobrança(s) de oferta aguardando pagamento (status created, últimos 7 dias). Esta versão não registra mais a venda de uma cobrança de oferta aprovada depois. Aguarde a aprovação/expiração com a versão anterior e rode a migração de novo.', n;
+  END IF;
+
+  SELECT count(*) INTO n FROM (
+    SELECT 1 FROM crm.flow_runs WHERE status IN ('running', 'waiting') GROUP BY company_id, contact_id HAVING count(*) > 1
+  ) d;
+  IF n > 0 THEN
+    RAISE EXCEPTION 'migração 0049 abortada: % contato(s) com mais de um run ativo; o índice único por contato não pode ser recriado. Resolva as duplicatas (um run ativo por contato) e rode a migração de novo.', n;
+  END IF;
+END $$;
+--> statement-breakpoint
+DROP TRIGGER IF EXISTS validate_offer_run_scope ON crm.flow_runs;
+--> statement-breakpoint
+DROP TRIGGER IF EXISTS offer_pixel_destination ON crm.pixel_configs;
+--> statement-breakpoint
+DROP TRIGGER IF EXISTS offer_payment_destination ON crm.payment_integrations;
+--> statement-breakpoint
+DROP TRIGGER IF EXISTS offer_pixel_delete ON crm.pixel_configs;
+--> statement-breakpoint
+DROP TRIGGER IF EXISTS offer_payment_delete ON crm.payment_integrations;
+--> statement-breakpoint
+DROP FUNCTION IF EXISTS crm.validate_offer_run_scope();
+--> statement-breakpoint
+DROP FUNCTION IF EXISTS crm.guard_offer_destination();
+--> statement-breakpoint
+DROP FUNCTION IF EXISTS crm.guard_offer_destination_delete();
+--> statement-breakpoint
+DROP INDEX IF EXISTS crm.flow_runs_active_chat_uq;
+--> statement-breakpoint
+DROP INDEX IF EXISTS crm.flow_runs_active_contact_uq;
+--> statement-breakpoint
+CREATE UNIQUE INDEX flow_runs_active_contact_uq ON crm.flow_runs(company_id, contact_id) WHERE status IN ('running', 'waiting');
+--> statement-breakpoint
+CREATE FUNCTION crm.offer_legacy_frozen() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  RAISE EXCEPTION 'offer_legacy_frozen: crm.% é histórico somente leitura (ofertas foram aposentadas); nada é recobrado nem reenviado', TG_TABLE_NAME;
+END $$;
+--> statement-breakpoint
+CREATE TRIGGER offer_legacy_frozen BEFORE INSERT OR UPDATE ON crm.offers FOR EACH ROW EXECUTE FUNCTION crm.offer_legacy_frozen();
+--> statement-breakpoint
+CREATE TRIGGER offer_legacy_frozen BEFORE INSERT OR UPDATE ON crm.offer_connections FOR EACH ROW EXECUTE FUNCTION crm.offer_legacy_frozen();
+--> statement-breakpoint
+CREATE TRIGGER offer_legacy_frozen BEFORE INSERT OR UPDATE ON crm.offer_opportunities FOR EACH ROW EXECUTE FUNCTION crm.offer_legacy_frozen();
+--> statement-breakpoint
+CREATE TRIGGER offer_legacy_frozen BEFORE INSERT OR UPDATE ON crm.offer_event_outbox FOR EACH ROW EXECUTE FUNCTION crm.offer_legacy_frozen();
+--> statement-breakpoint
+CREATE TRIGGER offer_legacy_frozen BEFORE INSERT OR UPDATE ON crm.offer_sale_notifications FOR EACH ROW EXECUTE FUNCTION crm.offer_legacy_frozen();
