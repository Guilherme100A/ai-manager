diff --git a/packages/core/src/business-areas/policy.ts b/packages/core/src/business-areas/policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6ea3d2857cc129e648388bba10d511198192721a
--- /dev/null
+++ b/packages/core/src/business-areas/policy.ts
@@ -0,0 +1,21 @@
+/**
+ * Opt-in de servidor da área de negócio isolada. Nome, claims de login e headers do cliente nunca autorizam o recurso.
+ * `BUSINESS_AREAS_COMPANY_ID` é o nome canônico; `SHARED_OFFERS_COMPANY_ID` continua aceito para que o env de produção
+ * já publicado funcione sem alteração.
+ */
+const UUID_RE = /^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i
+
+export function businessAreasCompany(env: Record<string, string | undefined> = process.env): string | null {
+  const id = env.BUSINESS_AREAS_COMPANY_ID || env.SHARED_OFFERS_COMPANY_ID
+  return id && UUID_RE.test(id) ? id.toLowerCase() : null
+}
+export function isBusinessAreasCompany(company: string, env: Record<string, string | undefined> = process.env): boolean {
+  return businessAreasCompany(env) === company.toLowerCase()
+}
+/** Decora os resumos de empresa produzidos pelo servidor, antes de qualquer cache da resposta de auth. */
+export function withCompanyCapabilities<T extends { id: string }>(companies: T[]): (T & { business_areas: boolean })[] {
+  return companies.map((company) => ({ ...company, business_areas: isBusinessAreasCompany(company.id) }))
+}
+export function requireBusinessAreasCompany(company: string): void {
+  if (!isBusinessAreasCompany(company)) throw new Error('Business areas unavailable for this company')
+}
diff --git a/packages/core/src/business-areas/policy.unit.test.ts b/packages/core/src/business-areas/policy.unit.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8224525698118ffccbb68ea365fea57f1cb4e9ff
--- /dev/null
+++ b/packages/core/src/business-areas/policy.unit.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, it } from 'vitest'
+import { businessAreasCompany, isBusinessAreasCompany, requireBusinessAreasCompany, withCompanyCapabilities } from './policy'
+
+const A = '11111111-1111-4111-8111-111111111111'
+const B = '22222222-2222-4222-8222-222222222222'
+
+describe('business-areas/policy', () => {
+  it('aceita o env canônico e o env de produção legado', () => {
+    expect(businessAreasCompany({ BUSINESS_AREAS_COMPANY_ID: A })).toBe(A)
+    expect(businessAreasCompany({ SHARED_OFFERS_COMPANY_ID: A.toUpperCase() })).toBe(A)
+    expect(businessAreasCompany({ BUSINESS_AREAS_COMPANY_ID: A, SHARED_OFFERS_COMPANY_ID: B })).toBe(A)
+  })
+  it('ignora valor ausente ou malformado', () => {
+    expect(businessAreasCompany({})).toBeNull()
+    expect(businessAreasCompany({ SHARED_OFFERS_COMPANY_ID: 'nao-e-uuid' })).toBeNull()
+    expect(isBusinessAreasCompany(A, {})).toBe(false)
+  })
+  it('isola por empresa e decora o resumo', () => {
+    const prev = process.env.BUSINESS_AREAS_COMPANY_ID
+    process.env.BUSINESS_AREAS_COMPANY_ID = A
+    try {
+      expect(isBusinessAreasCompany(A)).toBe(true)
+      expect(isBusinessAreasCompany(B)).toBe(false)
+      expect(withCompanyCapabilities([{ id: A }, { id: B }])).toEqual([{ id: A, business_areas: true }, { id: B, business_areas: false }])
+      expect(() => requireBusinessAreasCompany(B)).toThrow()
+      expect(() => requireBusinessAreasCompany(A)).not.toThrow()
+    } finally {
+      if (prev === undefined) delete process.env.BUSINESS_AREAS_COMPANY_ID
+      else process.env.BUSINESS_AREAS_COMPANY_ID = prev
+    }
+  })
+})
