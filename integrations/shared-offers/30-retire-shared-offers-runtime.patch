@@ -0,0 +1,30 @@
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { MIGRATION_SETS } from './client.js'
+
+// Contrato estático da 0049 (sem banco): a verificação com Postgres real roda na CI.
+const sql = readFileSync(join(MIGRATION_SETS.crm.folder, '0049_retire_offers.sql'), 'utf8')
+const journal = JSON.parse(readFileSync(join(MIGRATION_SETS.crm.folder, 'meta', '_journal.json'), 'utf8')) as { entries: { idx: number; tag: string; when: number }[] }
+
+describe('0049_retire_offers', () => {
+  it('está no journal, depois da 0048, com data crescente', () => {
+    const e = journal.entries
+    expect(e.at(-1)).toMatchObject({ idx: 49, tag: '0049_retire_offers' })
+    expect(e.at(-1)!.when).toBeGreaterThan(e.at(-2)!.when)
+  })
+  it('não apaga tabelas nem dados históricos', () => {
+    expect(sql).not.toMatch(/DROP\s+TABLE/i)
+    expect(sql).not.toMatch(/DELETE\s+FROM/i)
+    expect(sql).not.toMatch(/TRUNCATE/i)
+  })
+  it('aborta com erro explicativo diante de pendências e duplicatas', () => {
+    for (const piece of ['offer_event_outbox WHERE status', 'offer_sale_notifications WHERE status', 'offer_scoped AND status', 'payment_charges', 'HAVING count(*) > 1'])
+      expect(sql).toContain(piece)
+    expect(sql.match(/RAISE EXCEPTION 'migração 0049 abortada/g)).toHaveLength(5)
+  })
+  it('libera o índice único por contato e congela o legado', () => {
+    expect(sql).toContain("CREATE UNIQUE INDEX flow_runs_active_contact_uq ON crm.flow_runs(company_id, contact_id) WHERE status IN ('running', 'waiting')")
+    expect(sql.match(/CREATE TRIGGER offer_legacy_frozen/g)).toHaveLength(5)
+  })
+})
