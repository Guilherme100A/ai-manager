@@ -0,0 +1,121 @@
+import { useEffect, useState, type ReactNode } from 'react'
+import { ArrowRight, Building2, Layers3 } from 'lucide-react'
+import { Link, useRouterState } from '@tanstack/react-router'
+import { appPath, stripAppBase } from '@/lib/base'
+import { api, BUSINESS_AREA_HEADER, selectBusinessArea, selectedWorkspace } from '@/lib/http'
+import type { Session } from '@/lib/session'
+import { BusinessAreaManager } from './areas'
+
+type Workspace = { id: string; slot: number; name: string; bm_id: string | null }
+type WorkspaceList = { items: Workspace[] }
+const unscoped = { headers: { [BUSINESS_AREA_HEADER]: '' } }
+
+export function WorkspaceBoundary({ session, children }: { session: Session; children: ReactNode }) {
+  const [workspaces, setWorkspaces] = useState<Workspace[] | null>(null)
+  const [choice] = useState(selectedWorkspace)
+  const [choosing, setChoosing] = useState(false)
+  const [legacy, setLegacy] = useState(false)
+  const [error, setError] = useState('')
+  const [attempt, setAttempt] = useState(0)
+  const [initializing, setInitializing] = useState(false)
+  const canEdit = session.perms.has('settings.products.edit')
+  const pathname = useRouterState({ select: state => state.location.pathname })
+  useEffect(() => { setLegacy(false) }, [pathname])
+
+  useEffect(() => {
+    let cancelled = false
+    void api.get<WorkspaceList>('/api/business-areas', unscoped).then(result => {
+      if (!cancelled) setWorkspaces(result.items)
+    }).catch(() => {
+      if (!cancelled) setError('Não foi possível carregar os workspaces.')
+    })
+    return () => { cancelled = true }
+  }, [attempt])
+
+  const current = workspaces?.find(item => item.id === choice)
+  const hasWorkspace = choice === null || Boolean(current) || (choice === undefined && workspaces?.length === 0)
+
+  function enter(id: string | null) {
+    if (!selectBusinessArea(id)) {
+      setError('Habilite o armazenamento de sessão do navegador para entrar no workspace.')
+      return
+    }
+    // A troca precisa descartar cache de consultas e editores do workspace anterior.
+    const path = stripAppBase(window.location.pathname)
+    const scopedDeepLink = /^\/(offers|flows|connections|settings|facebook)(\/|$)/.test(path)
+    if (!choosing && scopedDeepLink) window.location.reload()
+    else window.location.replace(appPath('/offers'))
+  }
+
+  async function initialize() {
+    setInitializing(true)
+    setError('')
+    try {
+      const result = await api.post<WorkspaceList>('/api/business-areas/initialize', {}, unscoped)
+      setWorkspaces(result.items)
+    } catch {
+      setError('Não foi possível criar os workspaces.')
+    } finally {
+      setInitializing(false)
+    }
+  }
+
+  const ready = workspaces !== null && hasWorkspace
+  const chooser = (!ready || choosing) ? (
+      <section className="mx-auto max-w-5xl py-6 lg:py-12" data-testid="workspace-entry" aria-labelledby="workspace-entry-heading">
+        <div className="mb-7 flex items-start justify-between gap-4">
+          <div>
+            <h1 id="workspace-entry-heading" className="text-3xl font-semibold tracking-tight">Escolher workspace</h1>
+            <p className="mt-2 text-muted-foreground">Entre no espaço onde quer trabalhar nesta sessão.</p>
+          </div>
+          {choosing && hasWorkspace && <button type="button" className="rounded-md border px-3 py-2 text-sm" onClick={() => { setError(''); setChoosing(false) }}>Voltar</button>}
+        </div>
+        {error && <p role="alert" className="mb-4 text-sm text-destructive">{error}</p>}
+        {!workspaces ? (
+          error ? <button type="button" onClick={() => { setError(''); setAttempt(attempt + 1) }}>Tentar novamente</button> : <p role="status">Carregando workspaces…</p>
+        ) : (
+          <>
+            <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
+              {[...workspaces].sort((a, b) => a.slot - b.slot).map(item => (
+                <button key={item.id} type="button" data-testid={'workspace-enter-' + item.slot} onClick={() => enter(item.id)}
+                  className="flex min-h-32 flex-col justify-between rounded-xl border bg-card p-5 text-left text-card-foreground hover:border-primary">
+                  <Building2 className="size-5 text-primary" aria-hidden />
+                  <span className="flex w-full items-center justify-between gap-2 text-lg font-semibold">{item.name}<ArrowRight className="size-4" aria-hidden /></span>
+                </button>
+              ))}
+            </div>
+            {!workspaces.length && canEdit && <button type="button" className="mb-2 rounded-md bg-primary px-4 py-2 text-primary-foreground" disabled={initializing} onClick={() => void initialize()}>Criar Admin 1, Admin 2 e Admin 3</button>}
+            <button type="button" data-testid="workspace-enter-general" onClick={() => enter(null)} className="mt-4 flex w-full items-center justify-between gap-4 rounded-lg border px-4 py-3 text-left hover:bg-accent">
+              <span><strong className="block">Geral</strong><span className="text-sm text-muted-foreground">Ofertas que ainda estão fora dos workspaces</span></span>
+              <ArrowRight className="size-4 shrink-0" aria-hidden />
+            </button>
+          </>
+        )}
+      </section>
+  ) : null
+
+  return (
+    <>
+      {chooser}
+      {ready && <div hidden={choosing}>
+      <section className="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-card p-3" data-testid="business-area-switcher" aria-label="Workspace atual">
+        <div className="flex min-w-0 flex-wrap items-center gap-2">
+          <Layers3 className="size-5 shrink-0 text-primary" aria-hidden />
+          <span className="truncate font-semibold" data-testid="workspace-current">{current?.name ?? 'Geral'}</span>
+          {current?.bm_id && <span className="text-xs text-muted-foreground" data-testid="business-area-bm">BM cadastrada: {current.bm_id}</span>}
+          <button type="button" className="rounded-md border px-2 py-1 text-sm hover:bg-accent" onClick={() => { setLegacy(false); setChoosing(true) }}>Trocar workspace</button>
+        </div>
+        <nav aria-label="Ofertas e recursos compartilhados" className="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
+          <Link to="/offers" className="font-semibold" onClick={() => setLegacy(false)}>Ofertas</Link>
+          {session.perms.has('flows.view') && <Link to="/flows" onClick={() => setLegacy(false)}>Fluxos</Link>}
+          {session.perms.has('connections.view') && <Link to="/connections" onClick={() => setLegacy(false)}>Chips</Link>}
+          {session.perms.has('settings.view') && session.perms.has('settings.integrations.view') && <Link to="/settings" search={{ tab: 'integrations' }} onClick={() => setLegacy(false)}>Integrações</Link>}
+          {session.perms.has('facebook.profiles') && <Link to="/facebook/profiles" onClick={() => setLegacy(false)}>Meta</Link>}
+          {hasWorkspace && !current && canEdit && <button type="button" onClick={() => setLegacy(open => !open)} aria-expanded={legacy}>Mover ofertas de Geral</button>}
+        </nav>
+      </section>
+      {legacy && !current ? <BusinessAreaManager /> : children}
+      </div>}
+    </>
+  )
+}
