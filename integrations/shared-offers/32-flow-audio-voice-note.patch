+import { spawnSync } from 'node:child_process'
+import { describe, expect, it } from 'vitest'
+import { toPttOgg } from '@crm/ai'
+import type { FlowAction, FlowNode } from '@crm/shared'
+import { FakeWaGateway } from '@crm/wa-port/testing'
+import { buildContext, type NodeContext, type StepStore } from '../../engine/context'
+import { messagingHandlers, voiceNotePreparer, VoiceNoteSourceError, VOICE_NOTE_MIME, type MessagingDeps, type VoiceNotePreparerOptions } from './index'
+
+const SESSION = 'sess-1'
+const PHONE = '+5511999990000'
+const MP3 = new Uint8Array([0x49, 0x44, 0x33, 3, 0, 0, 0, 0, 0, 1])
+const OGG = new Uint8Array([0x4f, 0x67, 0x67, 0x53, 9, 9])
+const SHA_SRC = 'a'.repeat(64)
+const SHA_OUT = 'b'.repeat(64)
+
+const audioNode = (config: Record<string, unknown>): FlowNode => ({
+  id: 'n1',
+  type: 'message',
+  name: 'message',
+  position: { x: 0, y: 0 },
+  actions: [{ id: 'a1', type: 'send_multi_media', order: 0, config: { media_type: 'audio', media_source: 'url', ...config } } as FlowAction],
+})
+
+function memoryStore(): StepStore {
+  const actions = new Map<string, unknown>()
+  return {
+    findAction: async (key) => (actions.has(key) ? { result: actions.get(key) } : null),
+    saveAction: async (row) => void actions.set(row.key, row.result),
+    saveStep: async () => undefined,
+  }
+}
+
+function setup(n: FlowNode, deps: MessagingDeps) {
+  const wa = new FakeWaGateway({ sessions: [{ id: SESSION, name: 'c1', state: 'STABLE' }] })
+  const errors: string[] = []
+  const ctx = () =>
+    buildContext({
+      runId: 'run-1',
+      companyId: 'co-1',
+      flowId: 'f1',
+      contactId: 'ct-1',
+      chatId: 'chat-1',
+      seq: 1,
+      node: n,
+      definition: { schema: 'crm.flow/v1', entry: 'start', nodes: [n], edges: [], variables: [], refs: {} },
+      contact: { full_name: 'Maria Silva', phone_number: '5511999990000' },
+      vars: {},
+      wa,
+      log: { debug() {}, info() {}, warn() {}, error: (_o: unknown, msg?: string) => void errors.push(String(msg)) },
+      repo: { companyId: 'co-1', db: null, dryRun: false },
+      store: memoryStore(),
+    })
+  const handlers = messagingHandlers({ resolveTarget: async () => ({ sessionId: SESSION, phone: PHONE }), sleep: async () => undefined, ...deps })
+  return { wa, ctx, handlers, errors }
+}
+
+function fakes() {
+  const converted: Uint8Array[] = []
+  const stored: { companyId: string; mime: string }[] = []
+  const fetched: string[] = []
+  const owned = new Map<string, Uint8Array>([[`co-1:${SHA_SRC}`, MP3]])
+  const opts = {
+    readBlob: async (companyId: string, sha: string) => owned.get(`${companyId}:${sha}`) ?? null,
+    store: async (companyId: string, _data: Uint8Array, mime: string) => (stored.push({ companyId, mime }), { sha256: SHA_OUT }),
+    convert: async (data: Uint8Array) => (converted.push(data), { audio: OGG, mime: VOICE_NOTE_MIME }),
+    download: async (url: string) => (fetched.push(url), { status: 200, bytes: MP3 }),
+  }
+  return { opts, converted, stored, fetched }
+}
+
+const ctxOf = (companyId: string) => ({ companyId }) as NodeContext
+
+describe('voiceNotePreparer', () => {
+  it('URL http(s) (ex.: MP3 do Google Drive): baixa, converte para Ogg/Opus e devolve blob da empresa', async () => {
+    const f = fakes()
+    const prepare = voiceNotePreparer(f.opts)
+    const out = await prepare(ctxOf('co-1'), 'https://drive.usercontent.google.com/download?id=x&export=download')
+    expect(out).toEqual({ url: `blob:${SHA_OUT}`, mimetype: 'audio/ogg; codecs=opus' })
+    expect(f.converted[0]).toEqual(MP3)
+    expect(f.stored).toEqual([{ companyId: 'co-1', mime: VOICE_NOTE_MIME }])
+  })
+
