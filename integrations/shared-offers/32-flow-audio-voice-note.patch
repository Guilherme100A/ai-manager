diff --git a/packages/core/src/flows/nodes/messaging/voice-note.ts b/packages/core/src/flows/nodes/messaging/voice-note.ts
new file mode 100644
index 0000000..6c13c73
--- /dev/null
+++ b/packages/core/src/flows/nodes/messaging/voice-note.ts
@@ -0,0 +1,106 @@
+// Áudio do nó `message` (send_multi_media/audio) → Ogg/Opus mono antes do envio. O WhatsApp só toca nota de voz
+// (e áudio sem mimetype, que o Baileys rotula como `audio/ogg; codecs=opus`) se os bytes forem Ogg/Opus de fato:
+// MP3/M4A/WAV enviados como estão aparecem para o lead como "áudio com defeito". O Baileys não converte; o fluxo
+// converte aqui, grava o resultado no BlobStore da empresa e envia a referência `blob:<sha256>`.
+import type { NodeContext } from '../../engine/context'
+import { blobUrl } from '../../../media/service'
+import { safeHttpRequest } from '../external/http'
+
+export const VOICE_NOTE_MIME = 'audio/ogg; codecs=opus'
+/** Teto de download do áudio de origem (o limite de áudio do WhatsApp é 16 MB). */
+export const VOICE_NOTE_MAX_SOURCE_BYTES = 16 * 1024 * 1024
+
+export interface VoiceNoteResult {
+  url: string
+  mimetype: string
+}
+
+/** Converte a mídia de `url` (http(s) ou `blob:<sha256>` da empresa) e devolve a referência pronta para envio. */
+export type VoiceNotePreparer = (ctx: NodeContext, url: string) => Promise<VoiceNoteResult>
+
+export class VoiceNoteSourceError extends Error {
+  constructor(message: string, options?: { cause?: unknown }) {
+    super(message, options)
+    this.name = 'VoiceNoteSourceError'
+  }
+}
+
+export interface VoiceNotePreparerOptions {
+  /** Bytes de um blob da empresa, só se ela for dona (senão `null`). */
+  readBlob: (companyId: string, sha256: string) => Promise<Uint8Array | null>
+  /** Grava o áudio convertido para a empresa (registra a posse) e devolve o sha256. */
+  store: (companyId: string, data: Uint8Array, mime: string) => Promise<{ sha256: string }>
+  /** Conversor para Ogg/Opus mono (produção: `toPttOgg` de @crm/ai, com ffmpeg). */
+  convert: (data: Uint8Array) => Promise<{ audio: Uint8Array; mime: string }>
+  /** Download da origem http(s). Padrão: `safeHttpRequest` (bloqueia rede interna no destino, no DNS e em cada redirect). */
+  download?: (url: string, limits: { maxBytes: number; timeoutMs: number }) => Promise<{ status: number; bytes: Uint8Array }>
+  maxSourceBytes?: number
+  timeoutMs?: number
+  /** Conversões lembradas por empresa+origem (o mesmo áudio vai para muitos leads). */
+  cacheSize?: number
+  cacheTtlMs?: number
+  now?: () => number
+}
+
+const BLOB_REF = /^blob:([a-f0-9]{64})$/
+
+export function voiceNotePreparer(opts: VoiceNotePreparerOptions): VoiceNotePreparer {
+  const fetchSource = opts.download ?? defaultDownload
+  const maxBytes = opts.maxSourceBytes ?? VOICE_NOTE_MAX_SOURCE_BYTES
+  const timeoutMs = opts.timeoutMs ?? 30_000
+  const cacheSize = opts.cacheSize ?? 500
+  const ttl = opts.cacheTtlMs ?? 60 * 60 * 1000
+  const now = opts.now ?? Date.now
+  const cache = new Map<string, { result: VoiceNoteResult; at: number }>()
+  const inflight = new Map<string, Promise<VoiceNoteResult>>()
+
+  const download = async (url: string): Promise<Uint8Array> => {
+    if (!/^https?:\/\//i.test(url)) throw new VoiceNoteSourceError('URL do áudio precisa ser http(s)')
+    let res: { status: number; bytes: Uint8Array }
+    try {
+      res = await fetchSource(url, { maxBytes, timeoutMs })
+    } catch (err) {
+      throw new VoiceNoteSourceError(`download do áudio falhou (${err instanceof Error ? err.message : String(err)})`, { cause: err })
+    }
+    if (res.status < 200 || res.status >= 300) throw new VoiceNoteSourceError(`download do áudio respondeu ${res.status}`)
+    if (!res.bytes.byteLength) throw new VoiceNoteSourceError('áudio vazio')
+    if (res.bytes.byteLength > maxBytes) throw new VoiceNoteSourceError('áudio acima do limite')
+    return res.bytes
+  }
+
+  const prepare = async (companyId: string, url: string): Promise<VoiceNoteResult> => {
+    const sha = BLOB_REF.exec(url)?.[1]
+    let source: Uint8Array
+    if (sha) {
+      const data = await opts.readBlob(companyId, sha)
+      if (!data || !data.byteLength) throw new VoiceNoteSourceError('mídia do áudio não encontrada para a empresa')
+      source = data
+    } else source = await download(url)
+    const converted = await opts.convert(source)
+    const stored = await opts.store(companyId, converted.audio, converted.mime)
+    return { url: blobUrl(stored.sha256), mimetype: converted.mime }
+  }
+
+  return async (ctx, url) => {
+    const key = `${ctx.companyId}\u0000${url}`
+    const hit = cache.get(key)
+    if (hit && now() - hit.at < ttl) return hit.result
+    const running = inflight.get(key)
+    if (running) return running
+    const job = prepare(ctx.companyId, url)
+      .then((result) => {
+        cache.delete(key)
+        cache.set(key, { result, at: now() })
+        while (cache.size > cacheSize) cache.delete(cache.keys().next().value!)
+        return result
+      })
+      .finally(() => inflight.delete(key))
+    inflight.set(key, job)
+    return job
+  }
+}
+
+const defaultDownload: NonNullable<VoiceNotePreparerOptions['download']> = async (url, limits) => {
+  const res = await safeHttpRequest({ method: 'GET', url }, { maxResponseBytes: limits.maxBytes, timeoutMs: limits.timeoutMs })
+  return { status: res.status, bytes: new Uint8Array(res.bytes) }
+}
