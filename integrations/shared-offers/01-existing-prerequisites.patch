@@ -0,0 +1,32 @@
+import type { FlowNodeData } from './model'
+
+/** Presentation only: ids and the saved graph remain untouched. */
+export function portColor(handle: string, fallback = '#818cf8'): string {
+  if (handle === 'failure' || handle.includes('errad')) return '#f87171'
+  if (handle === 'timeout' || handle === 'other') return '#fbbf24'
+  if (handle === 'success' || handle === 'output:payment_approved') return '#34d399'
+  return fallback
+}
+
+export function portLabel(handle: string, data: FlowNodeData, t: (key: string) => string): string {
+  const [kind, id] = handle.split(':')
+  if (!id) return t(`handles.${handle}`)
+  for (const action of data.actions) {
+    const options = action.config.options
+    if (Array.isArray(options)) {
+      const option = options.find((o) => o && o.id === id)
+      if (option?.title) return String(option.title)
+    }
+  }
+  const key = `handles.${id}`
+  const translated = t(key)
+  return translated !== key ? translated : kind === 'option' ? id : id.replaceAll('_', ' ')
+}
+
+export function actionPreview(config: Record<string, unknown>): string | undefined {
+  // Explicitly selected user-facing fields; never display API credentials or prompts.
+  for (const key of ['message_text', 'text', 'caption', 'title']) {
+    if (typeof config[key] === 'string' && config[key].trim()) return config[key] as string
+  }
+  return undefined
+}
