@@ -0,0 +1,11 @@
+import { and, eq } from 'drizzle-orm'
+import { chats, messages, type Database } from '@crm/db'
+
+export async function initialTrigger(db: Database, companyId: string, contactId: string, chatId: string | null | undefined, input: Record<string, unknown> | null | undefined) {
+  const trigger = { ...(input ?? {}) }
+  delete trigger.message_text
+  if (!chatId || !['keyword','welcome','finished_conversation','default_response','out_of_hours'].includes(String(trigger.type)) || typeof trigger.message_id !== 'string' || !/^[a-f0-9-]{36}$/i.test(trigger.message_id)) return trigger
+  const [message] = await db.select({ body: messages.body }).from(messages).innerJoin(chats,eq(chats.id,messages.chatId)).where(and(eq(messages.id,trigger.message_id),eq(messages.companyId,companyId),eq(chats.companyId,companyId),eq(messages.chatId,chatId),eq(chats.contactId,contactId),eq(messages.direction,'inbound'),eq(messages.historical,false),eq(messages.type,'text'))).limit(1)
+  if (message?.body?.trim()) trigger.message_text=message.body
+  return trigger
+}
