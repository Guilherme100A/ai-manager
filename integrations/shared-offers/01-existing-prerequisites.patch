@@ -0,0 +1,46 @@
+import { z } from 'zod'
+import { fromApi, tool, UUID } from './shared'
+
+const offer = { id: UUID.describe('ID da oferta da Sonda, não do fluxo CRM') }
+const chunk = { offset: z.number().int().min(0).optional(), length: z.number().int().min(1).max(1048576).optional() }
+const read = (api: import('./shared').McpApi, op: string, query = {}) => api.request('GET', `/api/spy-bridge/${op}`, { query })
+
+export function uniqueSpyConversations(value: unknown) {
+  if (!Array.isArray(value)) return value
+  const seen = new Set<string>()
+  return value.filter(item => {
+    const key = JSON.stringify([item?.fileName, item?.content])
+    if (seen.has(key)) return false
+    seen.add(key)
+    return true
+  })
+}
+
+async function getFlow(api: import('./shared').McpApi, args: { id: string }) {
+  const r = await read(api, 'flow', args)
+  if (r.status === 200 && r.body && typeof r.body === 'object') {
+    const body = r.body as Record<string, unknown>
+    return { ...r, body: { ...body, conversations: uniqueSpyConversations(body.conversations) } }
+  }
+  return r
+}
+
+export const spyTools = [
+  tool({ name: 'list_spy_offers', title: 'Ofertas da Sonda', description: 'Lista ofertas capturadas pelo Espião, com IDs, números e status. Para roteiro e resumo atuais consulte get_spy_flow.', perm: 'flows.view', run: async (_, api) => {
+    const r = await read(api, 'offers')
+    if (r.status === 200 && r.body && typeof r.body === 'object') {
+      const body = r.body as { items?: Record<string, unknown>[] }
+      // Stored flowData is a historical import snapshot, not the live media catalog.
+      if (Array.isArray(body.items)) return fromApi({ ...r, body: { ...body, items: body.items.map(({ flowData, ...item }) => ({ ...item, ...(flowData ? { captured_snapshot: flowData, snapshot_notice: 'Resumo histórico; consulte get_spy_flow/list_spy_media para dados atuais.' } : {}) })) } })
+    }
+    return fromApi(r)
+  } }),
+  tool({ name: 'list_spy_probes', title: 'Sondas', description: 'Lista sondas, status, chip e oferta associados.', perm: 'flows.view', run: async (_, api) => fromApi(await read(api, 'probes')) }),
+  tool({ name: 'get_spy_offer', title: 'Ver oferta capturada', description: 'Oferta com roteiro, resumo, conversas e catálogo de mídias capturadas.', input: offer, perm: 'flows.view', run: async (args, api) => fromApi(await getFlow(api, args)) }),
+  tool({ name: 'get_spy_flow', title: 'Ler fluxo sondado', description: 'Roteiro completo, conversas por ramificação e mídias da oferta; não é o grafo editável CRM.', input: offer, perm: 'flows.view', run: async (args, api) => fromApi(await getFlow(api, args)) }),
+  tool({ name: 'list_spy_media', title: 'Mídias da oferta', description: 'Lista IDs, nomes, tipos e tamanhos das mídias capturadas. Use download_spy_media para obter os bytes.', input: offer, perm: 'flows.view', run: async (args, api) => { const r = await read(api, 'flow', args); return fromApi(r.status === 200 ? { ...r, body: { media: (r.body as { media: unknown }).media } } : r) } }),
+  tool({ name: 'get_spy_probe_messages', title: 'Conversa da sonda', description: 'Mensagens capturadas por uma sonda.', input: { id: UUID.describe('ID da sonda') }, perm: 'flows.view', run: async (args, api) => fromApi(await read(api, 'messages', args)) }),
+  tool({ name: 'download_spy_media', title: 'Baixar mídia capturada', description: 'Retorna bytes em base64 (PDF, áudio, imagem ou vídeo). Para arquivos grandes repita com next_offset até null; concatene os bytes decodificados em ordem. Padrão 256 KiB, máximo 1 MiB por chamada.', input: { id: UUID.describe('ID da mídia retornado por list_spy_media'), ...chunk }, perm: 'flows.view', run: async (args, api) => fromApi(await read(api, 'media', args)) }),
+  tool({ name: 'export_spy_offer_zip', title: 'Baixar ZIP completo', description: 'ZIP com resumo, roteiro, conversas e todos os arquivos capturados disponíveis. Retorna bytes base64 por partes: repita com next_offset até null e concatene os bytes decodificados. Não contém mídias que nunca foram capturadas.', input: { ...offer, ...chunk }, perm: 'flows.view', run: async (args, api) => fromApi(await read(api, 'zip', args)) }),
+  tool({ name: 'import_spy_offer_to_crm', title: 'Importar oferta no CRM', description: 'Cria NOVO rascunho editável com mensagens e mídias capturadas. Cada chamada cria uma cópia. Não ativa nem dispara mensagens.', input: offer, kind: 'write', perm: 'flows.edit', run: async (args, api) => fromApi(await api.request('POST', '/api/spy-bridge/import', { query: args, body: {}, write: true })) }),
+]
