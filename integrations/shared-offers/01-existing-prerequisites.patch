--- /dev/null
+++ b/packages/core/src/flows/nodes/logic/anchored.unit.test.ts
@@ -0,0 +1,26 @@
+import { expect, it } from 'vitest'
+import { nextSmartInterval } from './rules'
+import { ACTION_CONFIG_SCHEMAS } from '@crm/shared/flows'
+import { blockCatalog } from '../../../mcp/tools/flows'
+
+const paid = '2026-11-13T10:00:00Z'
+const config = { schedule_type: 'anchored', anchor_variable: 'gateway.paid_at', interval_value: 24, interval_unit: 'hours' }
+it('anchors 24h/72h/7d to payment, not support completion; overdue continues immediately', () => {
+  for (const hours of [24, 72, 168]) {
+    const next = nextSmartInterval({ ...config, interval_value: hours }, new Date('2026-11-13T16:00:00Z'), 'America/Mexico_City', { gateway: { paid_at: paid } })
+    expect(next.at?.getTime()).toBe(Date.parse(paid) + hours * 3600000)
+    expect(next.delayMs).toBe((hours - 6) * 3600000)
+  }
+  expect(nextSmartInterval(config, new Date('2026-11-15T10:00:00Z'), 'UTC', { gateway: { paid_at: paid } }).delayMs).toBe(0)
+  for (const paid_at of [undefined, null, '', 'tomorrow', '2026-11-13T10:00:00', '2026-02-30T10:00:00Z']) expect(() => nextSmartInterval(config, new Date(), 'UTC', { gateway: { paid_at } })).toThrow('invalid_payment_anchor')
+})
+it('catalog exposes both modes and rejects invalid input', () => {
+  expect(ACTION_CONFIG_SCHEMAS.smart_interval.safeParse(config).success).toBe(true)
+  expect(ACTION_CONFIG_SCHEMAS.smart_interval.safeParse({ ...config, anchor_variable: undefined }).success).toBe(false)
+  expect(ACTION_CONFIG_SCHEMAS.smart_interval.safeParse({ ...config, interval_value: 745 }).success).toBe(false)
+  const condition = { ruleType: 'all', conditions: [{ category: 'run_variable', fieldName: 'ready', operator: 'equal', value: 'true' }] }
+  expect(ACTION_CONFIG_SCHEMAS.evaluate_condition.safeParse(condition).success).toBe(true)
+  expect(ACTION_CONFIG_SCHEMAS.evaluate_condition.safeParse({ ...condition, conditions: [{ ...condition.conditions[0], fieldName: '__proto__.ready' }] }).success).toBe(false)
+  expect(JSON.stringify(blockCatalog('condition'))).toContain('run_variable')
+  expect(JSON.stringify(blockCatalog('smart_interval'))).toContain('anchor_variable')
+})
