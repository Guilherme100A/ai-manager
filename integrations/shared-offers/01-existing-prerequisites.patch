+import { expect, it } from 'vitest'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import { spyTools, uniqueSpyConversations } from './spy'
+
+it('removes identical duplicate conversations without dropping different captured text', () => {
+  const first = { fileName: 'principal.md', content: 'first' }
+  const different = { fileName: 'principal.md', content: 'different' }
+  expect(uniqueSpyConversations([first, { ...first }, different])).toEqual([first, different])
+})
+
+it('marks persisted summaries as historical snapshots instead of presenting them as live counts', async () => {
+  const api = { request: async () => ({ status: 200, body: { items: [{ id: 'offer', flowData: { summary: '0 mídias' } }] } }) }
+  const r = await spyTools.find(t => t.name === 'list_spy_offers')!.run({}, api)
+  const result = JSON.parse(r.content[0]!.text)
+  expect(result.items[0].captured_snapshot.summary).toBe('0 mídias')
+  expect(result.items[0].snapshot_notice).toContain('histórico')
+  expect(result.items[0].flowData).toBeUndefined()
+})
+import { registerApiTools } from './shared'
+
+it('read credentials expose downloads but never import; permissions hide all spy tools', () => {
+  const server = { registerTool() {} } as unknown as McpServer
+  const api = { request: async () => ({ status: 200, body: {} }) }
+  const names = registerApiTools(server, { api, access: 'read', perms: new Set(['flows.view', 'flows.edit']) }, spyTools)
+  expect(names).toContain('export_spy_offer_zip')
+  expect(names).toContain('download_spy_media')
+  expect(names).not.toContain('import_spy_offer_to_crm')
+  expect(registerApiTools(server, { api, access: 'write', perms: new Set() }, spyTools)).toEqual([])
+})
+
+it('media and ZIP requests retain offsets; import is explicitly a write', async () => {
+  const calls: unknown[] = []
+  const api = { request: async (...args: unknown[]) => { calls.push(args); return { status: 200, body: {} } } }
+  await spyTools.find(t => t.name === 'export_spy_offer_zip')!.run({ id: 'offer', offset: 262144, length: 4096 }, api)
+  expect(calls[0]).toEqual(['GET', '/api/spy-bridge/zip', { query: { id: 'offer', offset: 262144, length: 4096 } }])
+  await spyTools.find(t => t.name === 'import_spy_offer_to_crm')!.run({ id: 'offer' }, api)
+  expect(calls[1]).toEqual(['POST', '/api/spy-bridge/import', { query: { id: 'offer' }, body: {}, write: true }])
+})
