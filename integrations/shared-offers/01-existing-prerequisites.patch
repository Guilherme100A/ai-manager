+import { expect, it } from 'vitest'
+import { ElevenLabsTts } from './tts'
+
+it('402 preserves a safe actionable reason, never arbitrary provider details', async () => {
+  for (const status of ['payment_required', 'paid_plan_required', 'quota_exceeded', 'secret-from-provider']) {
+    const tts = new ElevenLabsTts({ apiKey: 'secret-key', fetch: async () => new Response(JSON.stringify({ detail: { status, message: 'secret-key private payload' } }), { status: 402 }) })
+    const err = await tts.synthesize({ voiceId: 'voice', text: 'Hola', format: 'mp3' }).catch(e => e)
+    expect(err.details).toMatchObject({ status: 402, retryable: false })
+    expect(err.message).not.toContain('secret')
+    if (status !== 'secret-from-provider') {
+      expect(err.message).toContain(status)
+      expect(err.details.provider_code).toBe(status)
+    } else {
+      expect(err.message).toContain('pagamento, créditos ou plano')
+      expect(err.details.provider_code).toBeUndefined()
+    }
+  }
+})
