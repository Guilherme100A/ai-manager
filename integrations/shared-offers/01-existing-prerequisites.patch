+    service = new OffersService(deps.db)
+  app.onError((err, c) => {
+    if (err instanceof OfferError) return c.json({ error: { code: 'VALIDATION_ERROR', message: err.message } }, 422)
+    throw err
+  })
+  app.get('/api/offers/resources', requirePerm('settings.products.view'), async (c) =>
+    c.json(await service.resources(getCompanyCtx(c).companyId)),
+  )
+  app.get(
+    '/api/offers/results',
+    requirePerm('settings.products.view'),
+    validate('query', z.object({ owner: z.uuid().optional(), offer: z.uuid().optional() })),
+    async (c) =>
+      c.json({
+        items: await service.report(getCompanyCtx(c).companyId, c.req.valid('query').owner, c.req.valid('query').offer),
+      }),
+  )
+  app.get('/api/offers', requirePerm('settings.products.view'), async (c) =>
+    c.json({ items: await service.list(getCompanyCtx(c).companyId) }),
+  )
+  app.post('/api/offers', requirePerm('settings.products.edit'), validate('json', body), async (c) => {
+    const offer = await service.save(
+      getCompanyCtx(c).companyId,
+      c.req.valid('json') as { name: string; active?: boolean; config: OfferConfig },
+    )
+    setAudit(c, { action: 'offers.create', targetType: 'offer', targetId: offer.id })
+    return c.json({ offer }, 201)
+  })
+  app.put(
+    '/api/offers/:id',
+    requirePerm('settings.products.edit'),
+    validate('param', z.object({ id: z.uuid() })),
+    validate('json', body),
+    async (c) => {
+      const offer = await service.save(
+        getCompanyCtx(c).companyId,
+        c.req.valid('json') as { name: string; active?: boolean; config: OfferConfig },
+        c.req.param('id'),
+      )
+      setAudit(c, { action: 'offers.update', targetType: 'offer', targetId: offer.id })
+      return c.json({ offer })
+    },
+  )
+  app.put(
+    '/api/offers/chips/:id',
+    requirePerm('settings.products.edit'),
+    validate('param', z.object({ id: z.uuid() })),
+    validate('json', z.object({ enabled: z.boolean() })),
+    async (c) => {
+      await service.manageConnection(getCompanyCtx(c).companyId, c.req.param('id'), c.req.valid('json').enabled)
+      return c.json({ ok: true })
+    },
+  )
+  app.get(
+    '/api/chats/:id/offers',
+    requirePerm('chat.view'),
+    validate('param', z.object({ id: z.uuid() })),
+    async (c) => {
+      const company = getCompanyCtx(c).companyId
+      const opportunities = await offerRows(
+        deps.db,
+        sql`select id,offer_id,evidence,snapshot->>'name' as name,created_at from crm.offer_opportunities where company_id=${company} and chat_id=${c.req.param('id')} order by created_at desc`,
+      )
+      return c.json({ items: opportunities })
+    },
+  )
+  app.post(
+    '/api/chats/:id/offer',
+    requirePerm('flows.run'),
+    validate('param', z.object({ id: z.uuid() })),
+    validate('json', z.object({ offer_id: z.uuid(), replace_active: z.literal(true) })),
+    async (c) => {
+      const company = getCompanyCtx(c).companyId
+      const resolved = await service.createOpportunity(company, c.req.param('id'), {}, c.req.valid('json').offer_id)
+      if (!resolved.opportunity) throw new ApiError('CONFLICT', 'Oferta inativa ou incompatível com este chip')
+      const op = resolved.opportunity,
+        svc = flowServices(deps)
+      await svc.control.cancelForContact({ companyId: company, chatId: op.chat_id }, op.contact_id)
+      const run = await svc.engine.startRun(
+        { companyId: company },
+        {
+          versionId: op.snapshot.version_id,
+          contactId: op.contact_id,
+          chatId: op.chat_id,
+          trigger: { type: 'offer_manual', opportunity_id: op.id },
+        },
+      )
+      await svc.enqueue(run)
+      setAudit(c, { action: 'offers.select', targetType: 'opportunity', targetId: op.id })
+      return c.json({ opportunity_id: op.id, run_id: run.runId }, 201)
+    },
+  )
+  return app
+}
