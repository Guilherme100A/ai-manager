+ALTER TABLE crm.sales ADD COLUMN opportunity_id uuid REFERENCES crm.offer_opportunities(id);
+CREATE TABLE crm.offer_event_outbox (
+ id uuid PRIMARY KEY DEFAULT gen_random_uuid(), company_id uuid NOT NULL REFERENCES crm.companies(id),
+ opportunity_id uuid NOT NULL REFERENCES crm.offer_opportunities(id), event_id text NOT NULL UNIQUE,
+ payload jsonb NOT NULL, status text NOT NULL DEFAULT 'pending' CHECK(status IN ('pending','sent','discarded')),
+ attempts integer NOT NULL DEFAULT 0, last_error text, created_at timestamptz NOT NULL DEFAULT now(), updated_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE INDEX offer_outbox_pending_idx ON crm.offer_event_outbox(status,updated_at);
+-- Destination identity is immutable once snapshotted. Rotate secrets in place; use a NEW record for a new account.
+CREATE FUNCTION crm.guard_offer_destination() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF TG_TABLE_NAME='pixel_configs' THEN
+  IF (NEW.pixel_id,NEW.page_id,NEW.whatsapp_business_account_id) IS DISTINCT FROM (OLD.pixel_id,OLD.page_id,OLD.whatsapp_business_account_id)
+   AND EXISTS(SELECT 1 FROM crm.offer_opportunities WHERE snapshot->>'pixel_id'=OLD.id::text) THEN
+    RAISE EXCEPTION 'offer_destination_locked: create a new pixel record';
+  END IF;
+ ELSE
+  IF NEW.client_id IS DISTINCT FROM OLD.client_id AND EXISTS(SELECT 1 FROM crm.offer_opportunities WHERE snapshot->>'integration_id'=OLD.id::text) THEN
+   RAISE EXCEPTION 'offer_destination_locked: create a new payment integration';
+  END IF;
+ END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER offer_pixel_destination BEFORE UPDATE ON crm.pixel_configs FOR EACH ROW EXECUTE FUNCTION crm.guard_offer_destination();
+CREATE TRIGGER offer_payment_destination BEFORE UPDATE ON crm.payment_integrations FOR EACH ROW EXECUTE FUNCTION crm.guard_offer_destination();
+CREATE FUNCTION crm.guard_offer_destination_delete() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF EXISTS(SELECT 1 FROM crm.offer_opportunities WHERE
+  (TG_TABLE_NAME='pixel_configs' AND snapshot->>'pixel_id'=OLD.id::text) OR
+  (TG_TABLE_NAME='payment_integrations' AND snapshot->>'integration_id'=OLD.id::text)) THEN
+   RAISE EXCEPTION 'offer_destination_locked: referenced by an immutable opportunity';
+ END IF;
+ RETURN OLD;
+END $$;
+CREATE TRIGGER offer_pixel_delete BEFORE DELETE ON crm.pixel_configs FOR EACH ROW EXECUTE FUNCTION crm.guard_offer_destination_delete();
+CREATE TRIGGER offer_payment_delete BEFORE DELETE ON crm.payment_integrations FOR EACH ROW EXECUTE FUNCTION crm.guard_offer_destination_delete();
+DROP INDEX crm.flow_runs_active_contact_uq;
+CREATE UNIQUE INDEX flow_runs_active_contact_uq ON crm.flow_runs(company_id,contact_id) WHERE status IN ('running','waiting') AND chat_id IS NULL;
+CREATE UNIQUE INDEX flow_runs_active_chat_uq ON crm.flow_runs(company_id,chat_id) WHERE status IN ('running','waiting') AND chat_id IS NOT NULL;
