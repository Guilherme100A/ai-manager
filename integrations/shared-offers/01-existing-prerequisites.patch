+++ b/tests/acceptance/T125/independent-pixel-review.test.ts
@@ -0,0 +1,156 @@
+import { createHash, randomBytes } from 'node:crypto'
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { defineQueue, META_CAPI_QUEUE, saleJobId } from '@crm/core'
+import { FakeXPag } from '../../../packages/core/src/payments/xpag/fake'
+import { chatOf, phone, receive, salesPixel, sleep, startSystem, tenant, waitFor, type System } from './setup'
+
+// Independent review: production API/worker/BullMQ/Postgres, only providers are fake HTTP servers.
+let sys: System
+let queue: ReturnType<typeof defineQueue>
+const fake = new FakeXPag({ clientId: 'independent-review', clientSecret: 'local-review-secret-only' })
+const tag = () => randomBytes(4).toString('hex')
+const oldXpag = process.env.XPAG_API_URL
+const oldPublic = process.env.API_PUBLIC_URL
+
+beforeAll(async () => {
+  await fake.start()
+  process.env.XPAG_API_URL = fake.url
+  process.env.API_PUBLIC_URL = 'http://api.review.test'
+  sys = await startSystem()
+  queue = defineQueue(META_CAPI_QUEUE)
+})
+afterAll(async () => {
+  await queue?.close()
+  await sys?.close()
+  await fake.stop()
+  if (oldXpag === undefined) delete process.env.XPAG_API_URL
+  else process.env.XPAG_API_URL = oldXpag
+  if (oldPublic === undefined) delete process.env.API_PUBLIC_URL
+  else process.env.API_PUBLIC_URL = oldPublic
+})
+
+const node = (id: string, type: string, actionType?: string, config?: any) => ({
+  id, type, name: id, position: { x: 0, y: 0 },
+  actions: actionType ? [{ id: `a-${id}`, type: actionType, order: 0, config }] : [],
+})
+const edge = (from: string, handle: string, to: string) => ({ id: `${from}-${to}`, from, handle, to })
+
+it.each(['automatic', 'dual', 'pixel-retry'])('callback -> sale -> Meta: %s', async (mode) => {
+  const dual = mode !== 'automatic'
+  const retry = mode === 'pixel-retry'
+  const t = await tenant(sys)
+  const px = await salesPixel(sys, t)
+  if (retry) {
+    const manual = await t.c.put(`/api/meta/pixels/${px.id}`, { auto_send_sales: false })
+    expect(manual.status, manual.text).toBe(200)
+  }
+  const other = await tenant(sys)
+  const otherPixel = await salesPixel(sys, other)
+  const integration = await t.c.post('/api/payment-integrations', {
+    label: 'Review XPag', gateway: 'xpag', client_id: 'independent-review', client_secret: 'local-review-secret-only',
+  })
+  expect(integration.status, integration.text).toBe(201)
+  const product = await t.c.post('/api/products', {
+    name: 'Review MXN', currency: 'MXN', price_min_cents: 1, price_max_cents: 100000, price_fallback_cents: 12345,
+  })
+  expect(product.status, product.text).toBe(201)
+  const f = await t.c.post('/api/flows', { name: `Review ${tag()}` })
+  expect(f.status, f.text).toBe(201)
+  const nodes = [
+    node('start', 'start'),
+    node('payment', 'payment', 'create_payment_charge', {
+      gateway: 'xpag', payment_integration_id: integration.body.integration.id,
