+import { Hono } from 'hono'
+import { bodyLimit } from 'hono/body-limit'
+import { asc, eq } from 'drizzle-orm'
+import { FlowStore, blobUrl } from '@crm/core'
+import { companies } from '@crm/db'
+import type { FlowAction, FlowDefinition, FlowNode } from '@crm/shared'
+import type { AppEnv, ResolvedDeps } from '../../lib/types'
+import { ApiError } from '../../lib/errors'
+import { mediaServiceFor } from '../media/index'
+
+type ImportedBranch = { branch: string; turns: Array<{ de: 'eu' | 'oferta'; texto: string }> }
+type ImportedMedia = { mime: string; fileName?: string | null; bytes: string }
+type ImportBody = { title?: string; phone: string; stage?: string | null; script?: string; branches?: ImportedBranch[]; media?: ImportedMedia[] }
+const clean = (value: unknown, max: number) => typeof value === 'string' ? value.trim().slice(0, max) : ''
+
+/** Ponte interna AI Manager -> CRM. Não usa sessão; exige o mesmo INTERNAL_TOKEN dos containers. */
+export function internalSpyImportRoutes(deps: ResolvedDeps) {
+  const app = new Hono<AppEnv>()
+  app.post('/internal/spy-flow-import', bodyLimit({ maxSize: 128 * 1024 * 1024 }), async (c) => {
+    const expected = process.env.INTERNAL_TOKEN?.trim()
+    const supplied = c.req.header('authorization')?.replace(/^Bearer\s+/i, '').trim()
+    if (!expected || supplied !== expected) throw new ApiError('UNAUTHORIZED', 'Token interno inválido')
+    const body = await c.req.json<ImportBody>().catch(() => null)
+    if (!body || !clean(body.phone, 40)) throw new ApiError('VALIDATION_ERROR', 'Oferta inválida')
+
+    const configuredCompany = process.env.CRM_SPY_COMPANY_ID?.trim()
+    const companyRows = configuredCompany
+      ? await deps.db.select().from(companies).where(eq(companies.id, configuredCompany)).limit(1)
+      : await deps.db.select().from(companies).where(eq(companies.active, true)).orderBy(asc(companies.createdAt)).limit(2)
+    if (!companyRows.length) throw new ApiError('NOT_FOUND', 'Nenhuma empresa ativa no CRM')
+    if (!configuredCompany && companyRows.length > 1) throw new ApiError('CONFLICT', 'Configure CRM_SPY_COMPANY_ID para escolher a empresa do CRM')
+    const companyId = companyRows[0]!.id
+
+    const media = mediaServiceFor(deps)
+    const uploaded: Array<{ mime: string; fileName: string; id: string; ref: string }> = []
+    for (const item of body.media ?? []) {
+      const mime = clean(item.mime, 120) || 'application/octet-stream'
+      const fileName = clean(item.fileName, 180) || `midia-${uploaded.length + 1}`
+      const bytes = Buffer.from(item.bytes ?? '', 'base64')
+      if (!bytes.length) continue
+      const saved = await media.upload(companyId, bytes, mime, fileName)
+      uploaded.push({ mime: saved.mime, fileName, id: saved.id, ref: blobUrl(saved.sha256) })
+    }
+
+    const title = clean(body.title, 120) || `Oferta ${clean(body.phone, 40)}`
+    const stage = clean(body.stage, 200) || 'Em mapeamento'
+    const store = new FlowStore(deps.db)
+    const ctx = { companyId, userId: null }
+    const flow = await store.createFlow(ctx, { name: title, description: `Importado do Espião · WhatsApp ${clean(body.phone, 40)} · Etapa: ${stage}`, status: 'draft' })
+    await store.fromDefinition(ctx, flow.id, flowDefinition(body.branches ?? [], clean(body.script, 100_000), uploaded))
+    return c.json({ ok: true, flowId: flow.id, editUrl: `/crm/flows/${flow.id}/edit`, mediaCount: uploaded.length }, 201)
+  })
+  return app
+}
+
+function flowDefinition(branches: ImportedBranch[], script: string, media: Array<{ mime: string; fileName: string; id: string; ref: string }>): FlowDefinition {
+  const nodes: FlowNode[] = [{ id: 'start', type: 'start', name: 'Início', position: { x: 80, y: 80 }, actions: [] }]
+  const actions: Array<{ name: string; action: FlowAction }> = []
+  for (const branch of branches) {
+    const label = clean(branch.branch, 50) || 'principal'
+    for (const turn of branch.turns ?? []) {
+      if (turn.de !== 'oferta') continue
+      const message = clean(turn.texto, 20_000)
+      if (message) actions.push({ name: `Oferta · ${label}`, action: { id: `action-${actions.length + 1}`, type: 'send_message', order: 0, config: { message_text: message, typing_delay_seconds: 1 } } })
+    }
+  }
+  if (!actions.length && script) actions.push({ name: 'Roteiro capturado', action: { id: 'action-1', type: 'send_message', order: 0, config: { message_text: script, typing_delay_seconds: 1 } } })
+  for (const item of media) {
+    const index = actions.length + 1
+    const common = { media_source: 'file', media_id: item.id, file_label: item.fileName }
+    if (item.mime.startsWith('image/') || item.mime.startsWith('video/') || item.mime.startsWith('audio/')) {
+      const mediaType = item.mime.startsWith('image/') ? 'image' : item.mime.startsWith('video/') ? 'video' : 'audio'
+      actions.push({ name: `Mídia · ${item.fileName}`, action: { id: `action-${index}`, type: 'send_multi_media', order: 0, config: { ...common, media_type: mediaType, media_url: item.ref, messages: [] } } })
+    } else {
+      actions.push({ name: `Arquivo · ${item.fileName}`, action: { id: `action-${index}`, type: 'send_file', order: 0, config: { ...common, file_url: item.ref, file_name: item.fileName } } })
+    }
+  }
+  actions.forEach((item, index) => nodes.push({ id: `step-${index + 1}`, type: 'message', name: item.name, position: { x: 380, y: 80 + index * 180 }, actions: [item.action] }))
+  const edges = actions.map((_, index) => ({ id: `edge-${index + 1}`, from: index === 0 ? 'start' : `step-${index}`, handle: 'source', to: `step-${index + 1}` }))
+  return { schema: 'crm.flow/v1', entry: 'start', nodes, edges, variables: [], refs: {} }
+}
