new file mode 100644
index 0000000..85c48f6
--- /dev/null
+++ b/apps/api/src/routes/ai-voices/generate.ts
@@ -0,0 +1,61 @@
+import { ElevenLabsTts, LlmUpstreamError } from '@crm/ai'
+import { AiKeysError, blobUrl, meterTts, UsageGuard } from '@crm/core'
+import { Hono } from 'hono'
+import { z } from 'zod'
+import { getCompanyCtx } from '../../lib/context'
+import { ApiError } from '../../lib/errors'
+import type { AppEnv, ResolvedDeps } from '../../lib/types'
+import { validate } from '../../lib/validate'
+import { requirePerm } from '../../middleware/authorize'
+import { setAudit } from '../../middleware/audit'
+import { mediaApiError, mediaServiceFor } from '../media/index'
+
+export const generateSpeechBody = z.object({
+  key_id: z.uuid(),
+  voice_id: z.string().trim().regex(/^[A-Za-z0-9_-]{1,128}$/),
+  text: z.string().trim().min(1).max(5000),
+  model: z.string().trim().regex(/^[A-Za-z0-9_-]{1,100}$/).default('eleven_multilingual_v2'),
+  language_code: z.string().regex(/^[a-z]{2}$/).default('es'),
+  format: z.enum(['mp3', 'ogg_opus']).default('mp3'),
+  file_name: z.string().trim().min(1).max(120).optional(),
+}).strict()
+
+export function generatedAudioConfig(ref: string) {
+  return { media_type: 'audio', media_source: 'file', media_url: ref, audio_forward: false }
+}
+
+export function generateSpeechRoutes(deps: ResolvedDeps) {
+  const app = new Hono<AppEnv>()
+  app.post('/api/ai-voices/generate', requirePerm('flows.edit'), validate('json', generateSpeechBody), async c => {
+    const { companyId } = getCompanyCtx(c)
+    const body = c.req.valid('json')
+    let credentials
+    try {
+      credentials = await deps.aiKeys!.credentialsForKey(companyId, body.key_id)
+    } catch (err) {
+      if (err instanceof AiKeysError) throw new ApiError('NOT_FOUND', 'Integração não encontrada nesta empresa')
+      throw err
+    }
+    if (credentials.provider !== 'elevenlabs') throw new ApiError('VALIDATION_ERROR', 'Selecione uma integração ElevenLabs')
+    const provider = new ElevenLabsTts({ apiKey: credentials.apiKey, languageCode: body.language_code, ...(deps.aiVoicesFetch ? { fetch: deps.aiVoicesFetch } : {}) })
+    const tts = meterTts(provider, { guard: new UsageGuard({ db: deps.db, redis: deps.redis as never }), companyId, provider: 'elevenlabs', feature: 'tts' })
+    let audio
+    try {
+      audio = await tts.synthesize({ text: body.text, voiceId: body.voice_id, model: body.model, format: body.format, signal: AbortSignal.timeout(60000) })
+    } catch (err) {
+      if (err instanceof LlmUpstreamError) throw new ApiError('UPSTREAM_ERROR', err.message, err.details)
+      if (err instanceof Error && (err.name === 'AbortError' || err.name === 'TimeoutError')) throw new ApiError('UPSTREAM_ERROR', 'ElevenLabs excedeu o tempo de geração')
+      throw err
+    }
+    if (!audio.audio.length) throw new ApiError('UPSTREAM_ERROR', 'ElevenLabs retornou áudio vazio')
+    const ext = body.format === 'mp3' ? 'mp3' : 'ogg'
+    const cleanName = (body.file_name || 'audio-funil').replace(/[^\p{L}\p{N}._-]+/gu, '-').replace(/\.(mp3|ogg)$/i, '')
+    let media
+    try { media = await mediaServiceFor(deps).upload(companyId, audio.audio, audio.mime, `${cleanName}.${ext}`) }
+    catch (err) { throw mediaApiError(err) }
+    const ref = blobUrl(media.sha256)
+    setAudit(c, { action: 'ai_voices.generate', targetType: 'media', targetId: media.sha256, detail: { key_id: body.key_id, voice_id: body.voice_id, model: body.model, characters: audio.chars, size: media.size } })
+    return c.json({ media, media_url: ref, characters: audio.chars, action: { type: 'send_multi_media', config: generatedAudioConfig(ref) } }, 201)
+  })
+  return app
+}
diff --git a/apps/api/src/routes/ai-voices/generate.unit.test.ts b/apps/api/src/routes/ai-voices/generate.unit.test.ts
new file mode 100644
index 0000000..fdc0a41
