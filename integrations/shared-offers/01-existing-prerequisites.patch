+import { afterAll, expect, it } from 'vitest'
+import { mediaRoutes } from './index'
+import { onError } from '../../lib/errors'
+import type { AppEnv, ResolvedDeps } from '../../lib/types'
+
+const dir = await mkdtemp(join(tmpdir(), 'mcp-upload-'))
+afterAll(() => rm(dir, { recursive: true, force: true }))
+const deps = { blobStore: new FsBlobStore(dir), mediaSigningKey: Buffer.alloc(32, 3), mediaLimits: { document: 20 } } as unknown as ResolvedDeps
+function harness(companyId = 'A', permission = true) {
+  const app = new Hono<AppEnv>()
+  app.use('*', async (c, next) => { c.set('ctx', { companyId, user: { id: 'u' }, perms: new Set(permission ? ['flows.edit', 'chat.view'] : []) } as never); await next() })
+  app.onError(onError)
+  app.route('/', mediaRoutes(deps))
+  return app
+}
+const bytes = Buffer.from('%PDF-1.7\nexample')
+const body = { file_name: 'guia.pdf', mime: 'application/pdf', data_base64: bytes.toString('base64') }
+const upload = (app: ReturnType<typeof harness>, b: unknown = body) => app.request('/api/media/base64', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(b) })
+it('accepts XLSX MIME as private document and returns send_file action', async () => {
+  const r = await upload(harness(), { ...body, file_name: 'costos.xlsx', mime: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' })
+  expect(r.status).toBe(201)
+  const data = await r.json() as { media: { kind: string }; action: { type: string; config: { file_name: string } } }
+  expect(data.media.kind).toBe('document')
+  expect(data.action).toMatchObject({ type: 'send_file', config: { file_name: 'costos.xlsx' } })
+})
+it('persists exact bytes privately, returns flow reference and verifies company isolation', async () => {
+  const app = harness()
+  const r = await upload(app)
+  expect(r.status).toBe(201)
+  const result = await r.json() as { media: { id: string; sha256: string }; action: unknown }
+  const hash = createHash('sha256').update(bytes).digest('hex')
+  expect(result.media.sha256).toBe(hash)
+  expect(result.action).toEqual({ type: 'send_file', config: { file_name: 'guia.pdf', file_url: `blob:${hash}` } })
+  const path = `/api/media/${result.media.id}`
+  expect(Buffer.from(await (await app.request(path)).arrayBuffer())).toEqual(bytes)
+  expect((await app.request(`${path}/info`)).status).toBe(200)
+  const chunks: Buffer[] = []
+  for(let offset=0;offset<bytes.length;offset+=4){
+    const r=await app.request(`${path}/download?offset=${offset}&length=4`)
+    expect(r.status).toBe(200)
+    chunks.push(Buffer.from(((await r.json()) as {data_base64:string}).data_base64,'base64'))
+  }
+  expect(Buffer.concat(chunks)).toEqual(bytes)
+  expect((await harness('B').request(`${path}/download`)).status).toBe(404)
+  expect((await app.request(`${path}/download?length=262145`)).status).toBe(422)
+  expect((await app.request(`${path}/download?offset=999`)).status).toBe(422)
+  expect((await harness('B').request(`${path}/info`)).status).toBe(404)
+  expect((await harness('B').request(path)).status).toBe(404)
+  expect((await app.request(`${path}x/info`)).status).toBe(404)
+})
+it('rejects permission failures, invalid encoding, filenames, unsupported MIME and oversized documents', async () => {
+  expect((await upload(harness('A', false))).status).toBe(403)
+  for (const data_base64 of ['%%%%', 'AB==', 'YWJj====', 'data:application/pdf;base64,AAAA']) {
+    expect((await upload(harness(), { ...body, data_base64 })).status).toBe(422)
+  }
+  expect((await upload(harness(), { ...body, file_name: '../secret' })).status).toBe(422)
+  expect((await upload(harness(), { ...body, mime: 'application/x-msdownload' })).status).toBe(415)
+  expect((await upload(harness(), { ...body, data_base64: Buffer.alloc(21).toString('base64') })).status).toBe(413)
+})
