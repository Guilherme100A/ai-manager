@@ -0,0 +1,13 @@
+export async function testAiClassification(key: string, model: string, fetchFn: typeof fetch = fetch) {
+  const headers = { authorization: `Bearer ${key}`, 'content-type': 'application/json' }
+  const models = await fetchFn('https://api.openai.com/v1/models', { headers, signal: AbortSignal.timeout(15000) })
+  if (!models.ok) return { ok: false, stage: 'models', provider_status: models.status }
+  const catalog = await models.json() as {data?: {id:string}[]}
+  const ids = (catalog.data ?? []).map(m=>m.id)
+  if (!ids.includes(model)) return {ok:false,stage:'model_unavailable',model,available_models:ids.filter(id=>id.startsWith('gpt-')).slice(0,80)}
+  const r = await fetchFn('https://api.openai.com/v1/chat/completions', {method:'POST',headers,signal:AbortSignal.timeout(30000),body:JSON.stringify({model,max_completion_tokens:32,messages:[{role:'system',content:'Classify input. Reply only AHORRAR if input is AHORRAR; otherwise OTRO.'},{role:'user',content:'AHORRAR'}]})})
+  if(!r.ok) return {ok:false,stage:'classification',provider_status:r.status,model}
+  const body=await r.json() as {choices?:{message?:{content?:string}}[]}
+  const output=body.choices?.[0]?.message?.content?.trim().slice(0,100) ?? ''
+  return {ok:output==='AHORRAR',model,input:'AHORRAR',output}
+}
