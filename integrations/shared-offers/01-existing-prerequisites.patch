diff --git a/apps/api/src/routes/spy-mcp.ts b/apps/api/src/routes/spy-mcp.ts
new file mode 100644
index 0000000..de11464
--- /dev/null
+++ b/apps/api/src/routes/spy-mcp.ts
@@ -0,0 +1,64 @@
+import { Hono } from 'hono'
+import { asc, eq } from 'drizzle-orm'
+import { companies } from '@crm/db'
+import { getCompanyCtx } from '../lib/context'
+import { ApiError } from '../lib/errors'
+import { requirePerm } from '../middleware/authorize'
+import type { AppEnv, ResolvedDeps } from '../lib/types'
+import { createHash } from 'node:crypto'
+
+const downloads = new Map<string, { bytes: Buffer; mime: string | null; disposition: string | null; expires: number; sha256: string }>()
+
+/** Narrow bridge: the Manager has one owner company, never expose its data to other tenants. */
+export function spyMcpRoutes(deps: ResolvedDeps) {
+  const app = new Hono<AppEnv>()
+  app.all('/api/spy-bridge/:operation', async (c) => {
+    const op = c.req.param('operation')
+    const write = op === 'import'
+    if (c.req.method !== (write ? 'POST' : 'GET')) throw new ApiError('NOT_FOUND', 'Operação inválida')
+    await requirePerm(write ? 'flows.edit' : 'flows.view')(c, async () => {})
+    const configured = process.env.CRM_SPY_COMPANY_ID?.trim()
+    const rows = configured
+      ? await deps.db.select({ id: companies.id }).from(companies).where(eq(companies.id, configured)).limit(1)
+      : await deps.db.select({ id: companies.id }).from(companies).where(eq(companies.active, true)).orderBy(asc(companies.createdAt)).limit(2)
+    if (rows.length !== 1 || rows[0]!.id !== getCompanyCtx(c).companyId) throw new ApiError('FORBIDDEN', 'Sonda indisponível para esta empresa')
+    const id = c.req.query('id') ?? ''
+    if (!['offers', 'probes'].includes(op) && !/^[0-9a-f-]{36}$/i.test(id)) throw new ApiError('VALIDATION_ERROR', 'ID inválido')
+    const paths: Record<string, string> = {
+      offers: '/api/spy/offers', probes: '/api/spy/probes',
+      flow: `/api/spy/flows/${id}`, messages: `/api/spy/probes/${id}/messages`,
+      zip: `/api/spy/offers/${id}/flow.zip`, media: `/api/spy/media/${id}`,
+      import: `/api/spy/offers/${id}/copy-to-crm`,
+    }
+    if (!paths[op]) throw new ApiError('NOT_FOUND', 'Operação inválida')
+    const key = `${getCompanyCtx(c).companyId}:${op}:${id}`
+    const now = Date.now()
+    for (const [k, v] of downloads) if (v.expires < now) downloads.delete(k)
+    const offset = Number(c.req.query('offset') || 0)
+    const length = Number(c.req.query('length') || 262144)
+    if (!Number.isSafeInteger(offset) || offset < 0 || !Number.isSafeInteger(length) || length < 1 || length > 1048576)
+      throw new ApiError('VALIDATION_ERROR', 'Intervalo inválido; length máximo 1048576')
+    let cached = downloads.get(key)
+    if (offset > 0 && !cached && (op === 'zip' || op === 'media')) throw new ApiError('CONFLICT', 'Download expirou; reinicie com offset=0')
+    if (!cached || offset === 0) {
+    const token = process.env.SPY_API_TOKEN
+    if (!token) throw new ApiError('CONFLICT', 'Ponte da Sonda não configurada')
+    const upstream = await fetch(`${process.env.SPY_API_URL || 'http://api:3000'}${paths[op]}`, {
+      method: write ? 'POST' : 'GET', headers: { authorization: `Bearer ${token}` },
+      redirect: 'error', signal: AbortSignal.timeout(60000),
+    })
+    if (!upstream.ok) return c.json({ error: { message: `Sonda retornou HTTP ${upstream.status}` } }, upstream.status as 400)
+    if (op !== 'zip' && op !== 'media') return c.json(await upstream.json())
+    const bytes = Buffer.from(await upstream.arrayBuffer())
+    if (bytes.length > 128 * 1024 * 1024) throw new ApiError('VALIDATION_ERROR', 'Arquivo excede 128 MiB')
+    while (downloads.size && [...downloads.values()].reduce((n, d) => n + d.bytes.length, bytes.length) > 160 * 1024 * 1024) downloads.delete(downloads.keys().next().value!)
+    cached = { bytes, mime: upstream.headers.get('content-type'), disposition: upstream.headers.get('content-disposition'), expires: now + 5 * 60000, sha256: createHash('sha256').update(bytes).digest('hex') }
+    downloads.set(key, cached)
+    }
+    const { bytes } = cached
+    if (offset > bytes.length) throw new ApiError('VALIDATION_ERROR', 'Offset após o fim do arquivo')
+    const end = Math.min(offset + length, bytes.length)
+    return c.json({ mime: cached.mime, disposition: cached.disposition, sha256: cached.sha256, expires_at: new Date(cached.expires).toISOString(), total_bytes: bytes.length, offset, next_offset: end < bytes.length ? end : null, encoding: 'base64', data: bytes.subarray(offset, end).toString('base64') })
+  })
+  return app
+}
