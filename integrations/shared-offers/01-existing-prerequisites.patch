+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import { expect, it } from 'vitest'
+import { audioTools } from './audio'
+import { registerApiTools } from './shared'
+
+it('read-only clients cannot configure keys or spend ElevenLabs credits', () => {
+  const server = { registerTool() {} } as unknown as McpServer
+  const api = { request: async () => ({ status: 200, body: {} }) }
+  const names = registerApiTools(server, { api, access: 'read', perms: new Set(['flows.edit', 'settings.integrations.edit', 'settings.integrations.view']) }, audioTools)
+  expect(names).toEqual(['list_audio_integrations', 'list_elevenlabs_voices'])
+  expect(registerApiTools(server, { api, access: 'write', perms: new Set() }, audioTools)).toEqual([])
+})
+
+it('key registration uses encrypted key API and generation forwards selected key/voice without a secret', async () => {
+  const calls: unknown[] = []
+  const api = { request: async (...args: unknown[]) => { calls.push(args); return { status: 201, body: { key: { id: 'key', secret_hint: '1234' } } } } }
+  const registered = await audioTools.find(t => t.name === 'configure_elevenlabs_key')!.run({ name: 'Voz', api_key: 'test-only-secret' }, api)
+  expect(registered.content[0]!.text).not.toContain('test-only-secret')
+  expect(calls[0]).toEqual(['POST', '/api/ai-keys', { body: { provider: 'elevenlabs', name: 'Voz', secret: 'test-only-secret', active: true }, write: true }])
+  await audioTools.find(t => t.name === 'generate_elevenlabs_audio')!.run({ key_id: 'key', voice_id: 'voice', text: 'Hola' }, api)
+  expect(calls[1]).toEqual(['POST', '/api/ai-voices/generate', { body: { key_id: 'key', voice_id: 'voice', text: 'Hola' }, write: true }])
+})
+
+it('MCP preserves billing details and never retries a rejected generation', async () => {
+  let calls = 0
+  const api = { request: async () => { calls++; return { status: 502, body: { error: { code: 'UPSTREAM_ERROR', details: { provider: 'elevenlabs', status: 402, provider_code: 'payment_required', retryable: false } } } } } }
+  const result = await audioTools.find(t => t.name === 'generate_elevenlabs_audio')!.run({ key_id: 'key', voice_id: 'voice', text: 'Hola' }, api)
+  expect(result.isError).toBe(true)
+  expect(JSON.parse(result.content[0]!.text)).toMatchObject({ status: 502, error: { details: { status: 402, provider_code: 'payment_required', retryable: false } } })
+  expect(calls).toBe(1)
+})
