+import {dryRun} from '../../engine/dry-run'
+import {createNodeRegistry} from '../../engine/registry'
+import {registerLogicNodes} from './index'
+
+it('anchored interruption advertises output:reply and retains an absolute deadline; default remains timer',async()=>{
+ const now=new Date('2026-11-13T16:00:00Z'),paid_at='2026-11-13T10:00:00Z'
+ for(const interrupt_on_reply of [false,true]){
+ const config={schedule_type:'anchored',anchor_variable:'gateway.paid_at',interval_value:24,interval_unit:'hours',interrupt_on_reply}
+ const node={id:'W',type:'smart_interval',name:'W',position:{x:0,y:0},actions:[{id:'w',type:'smart_interval',order:0,config}]}
+ const definition:FlowDefinition={schema:'crm.flow/v1',entry:'W',nodes:[node],edges:[],variables:[],refs:{}}
+ expect(nodeHandles(node)).toEqual(interrupt_on_reply?['source','output:reply']:['source'])
+ const r=await dryRun({definition,vars:{gateway:{paid_at}},registry:registerLogicNodes(createNodeRegistry(),{now:()=>now}),now:()=>now})
+ expect(r.wait).toMatchObject({kind:interrupt_on_reply?'reply':'timer',deadline_at:'2026-11-14T10:00:00.000Z',absolute_deadline:true})
