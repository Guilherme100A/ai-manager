diff --git a/packages/core/src/offers/service.ts b/packages/core/src/offers/service.ts
new file mode 100644
index 0000000..fda7593
--- /dev/null
+++ b/packages/core/src/offers/service.ts
@@ -0,0 +1,473 @@
+import { sql, type SQL } from 'drizzle-orm'
+import type { Database } from '@crm/db'
+import { CapiService, type CapiSendInput, type CapiEventName } from '../meta-capi/service'
+import type { CapiUserInput } from '../meta-capi/hashing'
+import { SalesService } from '../sales/service'
+import type { RealtimePublisher } from '../realtime/publisher'
+
+export interface OfferConfig {
+  owner_user_id: string
+  product_id: string
+  currency: string
+  flow_id: string
+  connection_ids: string[]
+  integration_id: string
+  ad_account_id: string
+  pixel_id: string
+  origins: { type: 'source_id' | 'link'; value: string }[]
+  cost_cents?: number | null
+  cost_label?: string
+}
+export interface OfferRow {
+  id: string
+  company_id: string
+  name: string
+  active: boolean
+  version: number
+  config: OfferConfig
+}
+export interface Opportunity {
+  id: string
+  company_id: string
+  offer_id: string
+  contact_id: string
+  chat_id: string
+  snapshot: OfferConfig & {
+    version: number
+    name: string
+    version_id: string
+    user: CapiUserInput
+    connection_id: string
+    pixel_dataset_id: string
+    payment_client_id: string
+  }
+  evidence: Record<string, unknown>
+}
+export class OfferError extends Error {}
+export function isOfferDestinationLocked(error: unknown): boolean {
+  for (let e=error,depth=0; e && depth<6; depth++) {
+    if (e instanceof Error && /offer_destination_locked:/.test(e.message)) return true
+    e = typeof e==='object' && e!==null && 'cause' in e ? e.cause : null
+  }
+  return false
+}
+export async function offerRows<T>(db: Database, query: SQL): Promise<T[]> {
+  return (await db.execute(query)).rows as T[]
+}
+const uuid = (s: unknown): s is string => typeof s === 'string' && /^[a-f\d]{8}(-[a-f\d]{4}){3}-[a-f\d]{12}$/i.test(s)
+const json = (v: unknown) => JSON.stringify(v)
+
+export class OffersService {
+  constructor(readonly db: Database) {}
+  list(company: string) {
+    return offerRows<OfferRow>(this.db, sql`select * from crm.offers where company_id=${company} order by created_at`)
+  }
+  async resources(company: string) {
+    const result: Record<string, unknown> = {}
+    for (const [key, query] of Object.entries({
+      chats: sql`select c.id,coalesce(p.name,p.phone_e164,'Contato') || ' ? ' || n.name as name from crm.chats c join crm.contacts p on p.id=c.contact_id join crm.connections n on n.id=c.connection_id where c.company_id=${company} order by c.updated_at desc limit 200`,
+      members: sql`select u.id,u.name from crm.users u join crm.company_members m on m.user_id=u.id where m.company_id=${company}`,
+      products: sql`select id,name,currency from crm.products where company_id=${company}`,
+      flows: sql`select id,name from crm.flows where company_id=${company} and published_version is not null and status='active'`,
+      connections: sql`select id,name from crm.connections where company_id=${company}`,
+      integrations: sql`select id,label as name from crm.payment_integrations where company_id=${company} and gateway='xpag'`,
+      accounts: sql`select id,coalesce(name,fb_account_id) as name,currency from crm.meta_ad_accounts where company_id=${company}`,
+      pixels: sql`select id,name from crm.pixel_configs where company_id=${company}`,
+      links: sql`select id,name from crm.tracked_links where company_id=${company}`,
+    }))
+      result[key] = (await this.db.execute(query)).rows
+    result.managed_connections = (
+      await offerRows<{ connection_id: string }>(
+        this.db,
+        sql`select connection_id from crm.offer_connections where company_id=${company}`,
+      )
+    ).map((x) => x.connection_id)
+    return result
+  }
+  async save(company: string, input: { name: string; active?: boolean; config: OfferConfig }, id?: string) {
+    const c = input.config
+    if (!input.name?.trim() || input.name.length > 120 || !c || !/^[A-Z]{3}$/.test(c.currency))
+      throw new OfferError('Nome e moeda válidos são obrigatórios')
+    for (const key of [
+      'owner_user_id',
+      'product_id',
+      'flow_id',
+      'integration_id',
+      'ad_account_id',
+      'pixel_id',
+    ] as const)
+      if (!uuid(c[key])) throw new OfferError(`Recurso inválido: ${key}`)
+    if (!Array.isArray(c.connection_ids) || !c.connection_ids.length || c.connection_ids.some((x) => !uuid(x)))
+      throw new OfferError('Selecione pelo menos um chip')
+    if (
+      !Array.isArray(c.origins) ||
+      c.origins.some((x) => !['source_id', 'link'].includes(x.type) || !x.value?.trim() || x.value.length > 200)
+    )
+      throw new OfferError('Origem inválida')
+    if (c.cost_cents != null && (!Number.isSafeInteger(c.cost_cents) || c.cost_cents < 0 || !c.cost_label?.trim()))
+      throw new OfferError('Identifique o custo informado (centavos, não negativo)')
+    const resources = (await this.resources(company)) as Record<string, { id: string; currency?: string }[]>
+    for (const [key, group] of [
+      ['owner_user_id', 'members'],
+      ['product_id', 'products'],
+      ['flow_id', 'flows'],
+      ['integration_id', 'integrations'],
+      ['ad_account_id', 'accounts'],
+      ['pixel_id', 'pixels'],
+    ] as const)
+      if (!resources[group]!.some((x) => x.id === c[key]))
+        throw new OfferError(`Recurso não pertence à empresa ou não está disponível: ${key}`)
+    if (resources.products!.find((x) => x.id === c.product_id)?.currency !== c.currency)
+      throw new OfferError('Moeda incompatível com produto')
+    for (const conn of c.connection_ids)
+      if (!resources.connections!.some((x) => x.id === conn)) throw new OfferError('Chip de outra empresa')
+    for (const origin of c.origins)
+      if (origin.type === 'link' && !resources.links!.some((x) => x.id === origin.value))
+        throw new OfferError('Link de outra empresa')
+    // Whitelist: never persist arbitrary client fields or secrets.
+    const config: OfferConfig = {
+      owner_user_id: c.owner_user_id,
+      product_id: c.product_id,
+      currency: c.currency,
+      flow_id: c.flow_id,
+      connection_ids: [...new Set(c.connection_ids)],
+      integration_id: c.integration_id,
+      ad_account_id: c.ad_account_id,
+      pixel_id: c.pixel_id,
+      origins: c.origins.map((x) => ({ type: x.type, value: x.value.trim() })),
+      cost_cents: c.cost_cents ?? null,
+      cost_label: c.cost_label?.trim(),
+    }
+    const rows = id
+      ? await offerRows<OfferRow>(
+          this.db,
+          sql`update crm.offers set name=${input.name.trim()},active=${input.active === true},config=${json(config)}::jsonb,version=version+1,updated_at=now() where company_id=${company} and id=${id} returning *`,
+        )
+      : await offerRows<OfferRow>(
+          this.db,
+          sql`insert into crm.offers(company_id,name,active,config) values(${company},${input.name.trim()},${input.active === true},${json(config)}::jsonb) returning *`,
+        )
+    if (!rows[0]) throw new OfferError('Oferta não encontrada')
+    return rows[0]
+  }
+  async manageConnection(company: string, connection: string, enabled: boolean) {
+    if (
+      !uuid(connection) ||
+      !(await offerRows(this.db, sql`select id from crm.connections where company_id=${company} and id=${connection}`))
+        .length
+    )
+      throw new OfferError('Chip não encontrado')
+    if (enabled)
+      await this.db.execute(
+        sql`insert into crm.offer_connections values(${company},${connection}) on conflict do nothing`,
+      )
+    else
+      await this.db.execute(
+        sql`delete from crm.offer_connections where company_id=${company} and connection_id=${connection}`,
+      )
+  }
+  async managed(company: string, connection: string) {
+    return Boolean(
+      (
+        await offerRows(
+          this.db,
+          sql`select 1 from crm.offer_connections where company_id=${company} and connection_id=${connection}`,
+        )
+      ).length,
+    )
+  }
+  async createOpportunity(
+    company: string,
+    chatId: string,
+    evidence: { source_id?: string | null; ctwa_clid?: string | null; click_id?: string | null; message_id?: string },
+    manualOffer?: string,
+  ) {
+    return this.db.transaction(async (tx) =>
+      new OffersService(tx as unknown as Database).resolveOpportunity(company, chatId, evidence, manualOffer),
+    )
+  }
+  private async resolveOpportunity(
+    company: string,
+    chatId: string,
+    evidence: { source_id?: string | null; ctwa_clid?: string | null; click_id?: string | null; message_id?: string },
+    manualOffer?: string,
+  ) {
+    const [chat] = await offerRows<{ contact_id: string; connection_id: string }>(
+      this.db,
+      sql`select contact_id,connection_id from crm.chats where company_id=${company} and id=${chatId}`,
+    )
+    if (!chat || !(await this.managed(company, chat.connection_id)))
+      throw new OfferError('Ative a modalidade de ofertas neste chip')
+    let click: { link_id: string; fbc: string; fbp: string; client_ip: string; user_agent: string } | undefined
+    if (evidence.click_id && !manualOffer)
+      [click] = await offerRows<typeof click & object>(
+        this.db,
+        sql`select link_id,fbc,fbp,client_ip,user_agent from crm.tracked_link_clicks where company_id=${company} and id=${evidence.click_id} and contact_id=${chat.contact_id} and match_confidence='exact'`,
+      )
+    const candidates = (await this.list(company)).filter(
+      (o) =>
+        o.active &&
+        o.config.connection_ids.includes(chat.connection_id) &&
+        (manualOffer
+          ? o.id === manualOffer
+          : o.config.origins.some((r) =>
+              r.type === 'source_id'
+                ? Boolean(evidence.source_id && r.value === evidence.source_id)
+                : Boolean(click && r.value === click.link_id),
+            )),
+    )
+    // Native source and exact link must independently resolve to the SAME offer. Unknown/inactive native IDs conflict too.
+    if (!manualOffer && evidence.source_id && click) {
+      const native = candidates.filter((o) =>
+        o.config.origins.some((r) => r.type === 'source_id' && r.value === evidence.source_id),
+      )
+      const linked = candidates.filter((o) =>
+        o.config.origins.some((r) => r.type === 'link' && r.value === click!.link_id),
+      )
+      if (native.length !== 1 || linked.length !== 1 || native[0]!.id !== linked[0]!.id)
+        return { state: 'conflict', opportunity: null } as const
+    }
+    if (candidates.length !== 1)
+      return { state: candidates.length ? 'conflict' : 'unresolved', opportunity: null } as const
+    const offer = candidates[0]!
+    // Lock identities through snapshot commit. A concurrent in-place edit must see the reference before updating.
+    const [pixel] = await offerRows<{ pixel_id: string; default_country: string }>(
+      this.db,
+      sql`select pixel_id,default_country from crm.pixel_configs where company_id=${company} and id=${offer.config.pixel_id} for share`,
+    )
+    const [payment] = await offerRows<{ client_id: string }>(
+      this.db,
+      sql`select client_id from crm.payment_integrations where company_id=${company} and id=${offer.config.integration_id} for share`,
+    )
+    if (!pixel || !payment) throw new OfferError('Destino da oferta indisponível')
+    const [version] = await offerRows<{ id: string }>(
+      this.db,
+      sql`select v.id from crm.flow_versions v join crm.flows f on f.id=v.flow_id and f.published_version=v.version where f.company_id=${company} and f.id=${offer.config.flow_id} and f.status='active'`,
+    )
+    if (!version) throw new OfferError('Fluxo não publicado/ativo')
+    // Only basic identity comes from the contact. Click identifiers are restricted to THIS inbound evidence.
+    const [contact] = await offerRows<{ phone: string; email: string; name: string }>(
+      this.db,
+      sql`select phone_e164 as phone,email,name from crm.contacts where company_id=${company} and id=${chat.contact_id}`,
+    )
+    const user: CapiUserInput = {
+      phone: contact?.phone,
+      email: contact?.email,
+      externalId: chat.contact_id,
+      firstName: contact?.name?.split(' ')[0],
+      ctwaClid: manualOffer ? null : (evidence.ctwa_clid ?? null),
+      ...(!manualOffer && click
+        ? { fbc: click.fbc, fbp: click.fbp, clientIpAddress: click.client_ip, clientUserAgent: click.user_agent }
+        : {}),
+    }
+    const proof = manualOffer ? { type: 'manual' } : { type: evidence.source_id ? 'native' : 'exact_link', ...evidence }
+    user.defaultCountry = pixel.default_country
+    const snapshot = {
+      ...offer.config,
+      version: offer.version,
+      name: offer.name,
+      version_id: version.id,
+      user,
+      connection_id: chat.connection_id,
+      pixel_dataset_id: pixel.pixel_id,
+      payment_client_id: payment.client_id,
+    }
+    const [op] = await offerRows<Opportunity>(
+      this.db,
+      sql`insert into crm.offer_opportunities(company_id,offer_id,contact_id,chat_id,snapshot,evidence,message_id) values(${company},${offer.id},${chat.contact_id},${chatId},${json(snapshot)}::jsonb,${json(proof)}::jsonb,${evidence.message_id ?? null}) on conflict(company_id,message_id) do update set message_id=excluded.message_id returning *`,
+    )
+    await this.queueEvent(op!, 'Lead', `offer-lead-${op!.id}`)
+    return { state: 'resolved', opportunity: op! } as const
+  }
+  async queueEvent(
+    op: Opportunity,
+    eventName: CapiEventName,
+    eventId: string,
+    amount?: number,
+    eventTime = new Date(),
+  ) {
+    const payload: CapiSendInput = {
+      companyId: op.company_id,
+      pixelConfigId: op.snapshot.pixel_id,
+      eventName,
+      eventId,
+      eventTime,
+      value: amount == null ? undefined : amount / 100,
+      currency: op.snapshot.currency,
+      user: op.snapshot.user,
+      actionSource: eventName === 'Purchase' ? 'system_generated' : 'chat',
+      source: 'sale',
+      sourceId: op.id,
+    }
+    await this.db.execute(
+      sql`insert into crm.offer_event_outbox(company_id,opportunity_id,event_id,payload) values(${op.company_id},${op.id},${eventId},${json(payload)}::jsonb) on conflict(event_id) do nothing`,
+    )
+  }
+  async report(company: string, owner?: string, offer?: string) {
+    return offerRows(
+      this.db,
+      sql`select o.offer_id,o.snapshot->>'name' as offer_name,o.snapshot->>'owner_user_id' as owner_user_id,s.currency,count(*)::int as sales,sum(s.amount_cents)::text as revenue_cents,
+      bool_and(o.snapshot->>'cost_cents' is not null) as costs_complete,
+      case when bool_and(o.snapshot->>'cost_cents' is not null) then sum(s.amount_cents-(o.snapshot->>'cost_cents')::bigint)::text else null end as estimated_profit_cents
+      from crm.sales s join crm.offer_opportunities o on o.id=s.opportunity_id and o.company_id=s.company_id
+      where s.company_id=${company} and s.status='approved' ${owner ? sql`and o.snapshot->>'owner_user_id'=${owner}` : sql``} ${offer ? sql`and o.offer_id=${offer}` : sql``}
+      group by o.offer_id,o.snapshot->>'name',o.snapshot->>'owner_user_id',s.currency`,
+    )
+  }
+}
+
+export async function opportunityForRun(db: Database, company: string, run: string) {
+  return (
+    await offerRows<Opportunity>(
+      db,
+      sql`select o.* from crm.offer_opportunities o join crm.flow_runs r on r.trigger->>'opportunity_id'=o.id::text and r.company_id=o.company_id where r.id=${run} and o.company_id=${company}`,
+    )
+  )[0]
+}
+
+/** An approved_sale block is an explicit approval condition only when no provider charge is pending. */
+export async function recordExplicitOfferSale(db: Database, op: Opportunity, amount: number, key: string) {
+  const [sale] = await offerRows<{ id: string }>(
+    db,
+    sql`select id from crm.sales where company_id=${op.company_id} and opportunity_id=${op.id} and status='approved' limit 1`,
+  )
+  if (sale) return { saleId: sale.id, created: false }
+  if (
+    (
+      await offerRows(
+        db,
+        sql`select 1 from crm.payment_charges where company_id=${op.company_id} and opportunity_id=${op.id} limit 1`,
+      )
+    ).length
+  )
+    throw new OfferError('Pagamento não confirmado: register_approved_sale não pode aprovar a cobrança')
+  if (!Number.isSafeInteger(amount) || amount <= 0) throw new OfferError('Valor aprovado inválido')
+  const [created] = await offerRows<{ id: string }>(
+    db,
+    sql`insert into crm.sales(company_id,contact_id,connection_id,product_id,opportunity_id,amount_cents,currency,status,source,external_id)
+ values(${op.company_id},${op.contact_id},${op.snapshot.connection_id},${op.snapshot.product_id},${op.id},${amount},${op.snapshot.currency},'approved','flow',${key}) on conflict(company_id,source,external_id) where external_id is not null do update set status='approved' returning id`,
+  )
+  await new OffersService(db).queueEvent(op, 'Purchase', `sale-${created!.id}`, amount)
+  await queueOfferSaleNotification(db,op.company_id,created!.id,'sale.recorded')
+  return { saleId: created!.id, created: true }
+}
+
+/** Called inside the charge transaction, before listener/TTL checks: late callbacks still book the sale. */
+export async function refundOfferPayment(db: Database, company: string, chargeId: string) {
+  // Only the sale for this charge, not every sale of the opportunity. Retain Purchase/outbox history unchanged.
+  const changed=await offerRows<{id:string;previous_status:string}>(db,sql`with changed as (
+    select s.id,s.status as previous_status from crm.sales s join crm.payment_charges c
+    on c.opportunity_id=s.opportunity_id and c.company_id=s.company_id
+    where c.id=${chargeId} and c.company_id=${company} and s.source='flow' and s.external_id=${`offer-charge-${chargeId}`} and s.status <> 'refunded'
+  ) update crm.sales s set status='refunded',updated_at=now()
+    from changed where s.id=changed.id returning s.id,changed.previous_status`)
+  for(const sale of changed) await queueOfferSaleNotification(db,company,sale.id,'sale.updated',sale.previous_status)
+}
+
+export async function recordOfferPayment(
+  db: Database,
+  company: string,
+  chargeId: string,
+  amount: number | null,
+  paidAt: Date,
+) {
+  const [op] = await offerRows<Opportunity>(
+    db,
+    sql`select o.* from crm.offer_opportunities o join crm.payment_charges c on c.opportunity_id=o.id and c.company_id=o.company_id where c.id=${chargeId} and c.company_id=${company} and c.status='approved'`,
+  )
+  if (!op) return null
+  if (!Number.isSafeInteger(amount) || amount! <= 0) throw new OfferError('Valor confirmado inválido')
+  const [sale] = await offerRows<{ id: string }>(
+    db,
+    sql`insert into crm.sales(company_id,contact_id,connection_id,product_id,opportunity_id,amount_cents,currency,status,source,external_id,sold_at)
+    values(${company},${op.contact_id},${op.snapshot.connection_id},${op.snapshot.product_id},${op.id},${amount},${op.snapshot.currency},'approved','flow',${`offer-charge-${chargeId}`},${paidAt.toISOString()})
+    on conflict(company_id,source,external_id) where external_id is not null do update set status='approved' returning id`,
+  )
+  await new OffersService(db).queueEvent(op, 'Purchase', `sale-${sale!.id}`, amount!, paidAt)
+  await queueOfferSaleNotification(db,company,sale!.id,'sale.recorded')
+  return sale!.id
+}
+
+export async function deliverOfferEvent(db: Database, capi: CapiService, id: string) {
+  const [row] = await offerRows<{ payload: CapiSendInput; status: string; next_attempt_at: Date }>(
+    db,
+    sql`select payload,status,next_attempt_at from crm.offer_event_outbox where id=${id}`,
+  )
+  if (!row || row.status !== 'pending') return
+  if (new Date(row.next_attempt_at).getTime()>Date.now()) return // Old/duplicate queued jobs must obey persisted backoff too.
+  let retryable=true
+  try {
+  // Recover a process crash after reserving the log. Two HTTP timeout windows have elapsed; keep the SAME event ID.
+  await db.execute(
+    sql`update crm.capi_event_log set status='uncertain',error='offer delivery interrupted before acknowledgement' where company_id=${row.payload.companyId} and pixel_config_id=${row.payload.pixelConfigId} and event_id=${row.payload.eventId} and status='pending' and updated_at < now()-interval '60 seconds'`,
+  )
+  const result = await capi.send({ ...row.payload, eventTime: new Date(row.payload.eventTime!) })
+  if(result.status==='failed') retryable=result.retryable===true
+  if (result.status === 'sent' || result.status === 'discarded')
+    await db.execute(
+      sql`update crm.offer_event_outbox set status=${result.status},attempts=attempts+1,last_error=null,lease_until=null,updated_at=now() where id=${id}`,
+    )
+  else {
+    // A duplicate can be a concurrent pending delivery, not a confirmation of acceptance.
+    await db.execute(
+      sql`update crm.offer_event_outbox set last_error=${result.status === 'duplicate' ? 'delivery in progress' : result.error},updated_at=now() where id=${id} and status='pending'`,
+    )
+    const accepted = await offerRows(
+      db,
+      sql`select 1 from crm.capi_event_log where company_id=${row.payload.companyId} and pixel_config_id=${row.payload.pixelConfigId} and event_id=${row.payload.eventId} and status='sent'`,
+    )
+    if (accepted.length)
+      await db.execute(sql`update crm.offer_event_outbox set status='sent',last_error=null,lease_until=null where id=${id}`)
+    else throw new Error('offer delivery not accepted')
+  }
+  } catch(error) {
+    // Persist record-level backoff, including thrown errors. Credential rejection is slow-retried, never discarded.
+    await db.execute(sql`update crm.offer_event_outbox set attempts=attempts+1,lease_until=null,
+      next_attempt_at=now()+make_interval(secs=>least(${retryable?300:21600}::double precision,${retryable?3:300}::double precision*power(2,least(attempts,10)))),
+      last_error=coalesce(last_error,'delivery interrupted; retry scheduled'),updated_at=now() where id=${id} and status='pending'`)
+    throw error
+  }
+}
+
+export async function claimOfferEvents(db:Database) {
+  return offerRows<{id:string;dispatch_seq:number}>(db,sql`with due as (
+    select id from crm.offer_event_outbox where status='pending' and next_attempt_at<=now() and (lease_until is null or lease_until<=now())
+    order by next_attempt_at,created_at for update skip locked limit 100
+  ) update crm.offer_event_outbox o set lease_until=now()+interval '120 seconds',dispatch_seq=dispatch_seq+1
+    from due where o.id=due.id returning o.id,o.dispatch_seq`)
+}
+export async function offerEnqueueFailed(db:Database,id:string,seq:number) {
+  await db.execute(sql`update crm.offer_event_outbox set lease_until=null,next_attempt_at=now()+interval '3 seconds',last_error='enqueue failed; retry scheduled' where id=${id} and dispatch_seq=${seq} and status='pending'`)
+}
+
+async function queueOfferSaleNotification(db:Database,company:string,saleId:string,type:'sale.recorded'|'sale.updated',previous?:string) {
+  const sale=await new SalesService({db}).get(company,saleId)
+  const key=`${saleId}:${type}:${type==='sale.updated'?sale.status:'created'}`
+  const data={sale_id:saleId,sale,...(type==='sale.updated'?{status:sale.status,previous_status:previous}:{})}
+  await db.execute(sql`insert into crm.offer_sale_notifications(company_id,sale_id,event_key,event_type,data)
+    values(${company},${saleId},${key},${type},${JSON.stringify(data)}::jsonb) on conflict(event_key) do nothing`)
+}
+
+/** Only the executed block creates this intent, in its transaction. A callback never synthesizes configured pushes. */
+export async function queueOfferBlockPush(db:Database,company:string,saleId:string,stepKey:string,data:{title:string;body:string;url:null;kind:'approved_sale';sale_id:string}) {
+  await db.execute(sql`insert into crm.offer_sale_notifications(company_id,sale_id,event_key,event_type,data)
+    select ${company},s.id,${`block-push:${stepKey}`},'notification.created',${JSON.stringify(data)}::jsonb
+    from crm.sales s where s.company_id=${company} and s.id=${saleId}
+    on conflict(event_key) do nothing`)
+}
+export async function dispatchOfferNotifications(db:Database,publisher:RealtimePublisher,effects:(company:string,type:string,data:unknown)=>Promise<void>) {
+  const rows=await offerRows<{id:string;company_id:string;event_key:string;event_type:'sale.recorded'|'sale.updated'|'notification.created';data:never}>(db,sql`with due as (
+    select n.id from crm.offer_sale_notifications n where n.status='pending' and n.next_attempt_at<=now() and (n.lease_until is null or n.lease_until<=now())
+      and not exists(select 1 from crm.offer_sale_notifications earlier where earlier.sale_id=n.sale_id and earlier.status='pending' and earlier.sequence<n.sequence)
+    order by n.next_attempt_at,n.sequence for update skip locked limit 100
+  ) update crm.offer_sale_notifications n set lease_until=now()+interval '120 seconds',attempts=attempts+1 from due where n.id=due.id returning n.*`)
+  for(const row of rows) {
+    try {
+      await publisher.publishOnce(row.company_id,row.event_type,row.data,row.event_key)
+      await effects(row.company_id,row.event_type,row.data)
+      await db.execute(sql`update crm.offer_sale_notifications set status='sent',lease_until=null,last_error=null,updated_at=now() where id=${row.id}`)
+    } catch {
+      await db.execute(sql`update crm.offer_sale_notifications set lease_until=null,next_attempt_at=now()+make_interval(secs=>least(300::double precision,3*power(2,least(attempts,7)))),last_error='notification delivery failed; retry scheduled',updated_at=now() where id=${row.id}`)
+    }
+  }
+}
