+import { describe, expect, it } from 'vitest'
+import { actionPreview, portColor, portLabel } from './presentation'
+import { toDefinition, toGraph, metaOf } from './model'
+import type { FlowDefinition } from '@crm/shared/flows'
+
+describe('flow presentation', () => {
+  it('uses option titles without replacing stable connection ids', () => {
+    const data = {
+      name: 'Menu',
+      actions: [
+        {
+          id: 'a',
+          type: 'send_option_list',
+          order: 0,
+          config: { options: [null, { id: 'buy', title: 'Comprar agora' }] },
+        },
+      ],
+    }
+    expect(portLabel('option:buy', data, (k) => k)).toBe('Comprar agora')
+    expect(portLabel('output:custom_route', data, (k) => k)).toBe('custom route')
+    expect(portLabel('timeout', data, () => 'Tempo esgotado')).toBe('Tempo esgotado')
+  })
+  it('distinguishes failures, timeouts and success, preserving type color for normal paths', () => {
+    expect(new Set(['failure', 'timeout', 'success', 'source'].map((h) => portColor(h, '#2563eb'))).size).toBe(4)
+    expect(portColor('source', '#2563eb')).toBe('#2563eb')
+  })
+  it('previews content without falling back to credentials or system instructions', () => {
+    expect(actionPreview({ message_text: 'Olá', token: 'secret' })).toBe('Olá')
+    expect(actionPreview({ api_key: 'secret', system_prompt: 'private', url: 'https://secret' })).toBeUndefined()
+  })
+  it('does not persist edge decoration in the flow definition', () => {
+    const def: FlowDefinition = {
+      schema: 'crm.flow/v1',
+      entry: 'start',
+      nodes: [{ id: 'start', type: 'start', name: 'Start', position: { x: 0, y: 0 }, actions: [] }],
+      edges: [],
+      variables: [],
+      refs: {},
+    }
+    const graph = toGraph(def)
+    graph.edges.push({
+      id: 'e',
+      source: 'start',
+      sourceHandle: 'source',
+      target: 'start',
+      style: { stroke: 'red' },
+      label: 'Preview',
+    })
+    expect(toDefinition(graph, metaOf(def)).edges[0]).toEqual({ id: 'e', from: 'start', handle: 'source', to: 'start' })
+  })
+})
