+/* Shared visual language. No routing, permissions or interaction changes. */
+:root[data-skin='ai-manager'] {
+  --am-bg: #f5f3fa;
+  --am-surface: #ffffff;
+  --am-surface-2: #f0edf7;
+  --am-surface-3: #e9e3f6;
+  --am-text: #211b36;
+  --am-text-muted: #69617b;
+  --am-border: #e0d9ed;
+  --am-border-strong: #c9bfdc;
+  --am-accent: #7c3aed;
+  --am-accent-fg: #ffffff;
+  --am-accent-soft: #7c3aed12;
+  --am-shadow: 0 2px 3px #33205203, 0 6px 20px #33205207;
+  --am-shadow-lg: 0 20px 70px -20px #33205240;
+  --am-ring: 0 0 0 3px #7c3aed26;
+  --radius: 14px;
+  --radius-md-skin: 9px;
+  --radius-sm-skin: 7px;
+  --crm-button-from: #8b5cf6;
+  --crm-button-to: #6d28d9;
+  --crm-sidebar: #faf9fd;
+  --crm-grid: #8b5cf60c;
+}
+
+:root[data-skin='ai-manager'].dark {
+  --am-bg: #171326;
+  --am-surface: #1d1831;
+  --am-surface-2: #241e3a;
+  --am-surface-3: #30264b;
+  --am-text: #f2effb;
+  --am-text-muted: #b5abc9;
+  --am-border: #38304f;
+  --am-border-strong: #514269;
+  --am-accent: #a78bfa;
+  --am-accent-fg: #201438;
+  --am-accent-soft: #a78bfa1c;
+  --am-shadow: 0 1px 0 #ffffff05 inset, 0 6px 24px #08041126;
+  --am-shadow-lg: 0 24px 70px -16px #080411a6;
+  --am-ring: 0 0 0 3px #a78bfa30;
+  --crm-button-from: #8b5cf6;
+  --crm-button-to: #7c3aed;
+  --crm-sidebar: #141022;
+  --crm-grid: #a78bfa0b;
+}
+
+:root[data-skin='ai-manager'] body {
+  font-family: var(--am-font-sans);
+  letter-spacing: -0.012em;
+}
+:root[data-skin='ai-manager'] #main {
+  background: radial-gradient(ellipse at 90% 0%, var(--am-accent-soft), transparent 55%);
+}
+:root[data-skin='ai-manager'] :where(button, a, input, textarea, select):focus-visible {
+  outline: 2px solid var(--ring);
+  outline-offset: 3px;
+}
+:root[data-skin='ai-manager'] :where(input, textarea)::placeholder {
+  color: var(--am-text-muted);
+  opacity: 0.8;
+}
+:root[data-skin='ai-manager']
+  :where(
+    input:not([type='checkbox'], [type='radio'], [type='range'], [type='file'], [type='color']),
+    textarea,
+    select
+  ) {
+  border-color: var(--am-border-strong);
+  border-radius: 9px;
+}
+:root[data-skin='ai-manager'] :where(input, textarea, select):disabled {
+  cursor: not-allowed;
+}
+:root[data-skin='ai-manager'] [data-slot='button'] {
+  border-radius: 9px;
+  font-weight: 600;
+  transition:
+    background-color 150ms ease,
+    box-shadow 150ms ease,
+    border-color 150ms ease;
+}
+:root[data-skin='ai-manager'] [data-slot='button'][data-variant='default'] {
+  background: linear-gradient(115deg, var(--crm-button-from), var(--crm-button-to));
+  color: #fff;
+  box-shadow:
+    0 1px 0 #ffffff25 inset,
+    0 3px 9px #7c3aed24;
+}
+:root[data-skin='ai-manager'] [data-slot='button'][data-variant='default']:hover:not(:disabled) {
+  filter: brightness(1.09);
+}
+:root[data-skin='ai-manager'] [data-slot='button'][data-variant='outline'] {
+  background: var(--card);
+  border-color: var(--am-border-strong);
+}
+:root[data-skin='ai-manager'] [data-slot='button'][data-variant='outline']:hover:not(:disabled) {
+  background: var(--accent);
+  border-color: var(--primary);
+}
+
+/* Sidebar, collapsed sidebar and mobile drawer keep their existing sizes. */
+:root[data-skin='ai-manager'] :is([data-testid='shell-sidebar'], [data-testid='shell-drawer']) {
+  background: var(--crm-sidebar);
+  border-color: var(--am-border);
+  gap: 14px;
+}
+:root[data-skin='ai-manager'] [data-testid='shell-app-name'] {
+  letter-spacing: 0.04em;
+  font-weight: 800;
+}
+:root[data-skin='ai-manager'] [data-testid^='nav-item-'] {
+  border-radius: 9px;
+  border: 1px solid transparent;
+  font-weight: 550;
+}
+:root[data-skin='ai-manager'] [data-testid^='nav-item-'][aria-current='page'] {
+  background: linear-gradient(100deg, var(--am-accent-soft), transparent 160%);
+  border-color: color-mix(in srgb, var(--primary) 30%, transparent);
+  color: var(--foreground);
+  box-shadow: inset 3px 0 var(--primary);
+}
+:root[data-skin='ai-manager'] [data-testid^='nav-item-']:hover {
+  background-color: var(--am-surface-2);
+}
+:root[data-skin='ai-manager'] [data-testid='shell-breadcrumbs'] {
+  font-size: 12px;
+}
+:root[data-skin='ai-manager'] :is([data-testid='shell-mobile-header'], [data-testid='shell-bottom-nav']) {
+  background: var(--crm-sidebar);
+}
+
+/* Shared content hierarchy, tables, tabs and overlay surfaces. */
+:root[data-skin='ai-manager'] #main h1:not(.sr-only) {
+  font-weight: 700;
+  letter-spacing: -0.035em;
+}
+:root[data-skin='ai-manager'] #main > section:not([data-testid='flow-editor']) > header {
+  padding-block: 4px 8px;
+}
+:root[data-skin='ai-manager'] :where(.bg-card) {
+  box-shadow: var(--am-shadow);
+}
+:root[data-skin='ai-manager'] :where([role='dialog'], [role='alertdialog']) {
+  border-color: var(--am-border-strong);
+  border-radius: 16px;
+  box-shadow: var(--am-shadow-lg);
+}
+:root[data-skin='ai-manager'] :where([role='menu'], [role='listbox']) {
+  border-radius: 10px;
+  box-shadow: var(--am-shadow-lg);
+}
+:root[data-skin='ai-manager'] [role='tablist'] {
+  gap: 4px;
+}
+:root[data-skin='ai-manager'] [role='tab'] {
+  border-radius: 8px;
+  transition: background-color 150ms ease;
+}
+:root[data-skin='ai-manager'] [role='tab'][aria-selected='true'] {
+  background-color: var(--am-accent-soft);
+  color: var(--primary);
+  box-shadow: inset 0 -2px var(--primary);
+}
+:root[data-skin='ai-manager'] table {
+  border-collapse: separate;
+  border-spacing: 0;
+}
+:root[data-skin='ai-manager'] th {
+  background: var(--muted);
+  color: var(--muted-foreground);
+  font-size: 11px;
+  letter-spacing: 0.06em;
+  font-weight: 650;
+  text-transform: uppercase;
+  padding-block: 13px;
+  border-bottom: 1px solid var(--border);
+}
+:root[data-skin='ai-manager'] td {
