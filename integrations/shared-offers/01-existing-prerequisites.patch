+export function paymentReceipt(charge: { id: string; status: string; paidAmountCents: number | null; currency: string; paidAt: Date | null; transactionId: string }) {
+  if (charge.status !== 'approved' || !charge.paidAt || !Number.isSafeInteger(charge.paidAmountCents) || charge.paidAmountCents! <= 0) return null
+  return {
+    id: `payment-${charge.id}`, amount_cents: charge.paidAmountCents!, currency: charge.currency,
+    paid_at: charge.paidAt.toISOString(), transaction_id: charge.transactionId,
+    text: `Confirmación de pago — NO fiscal\nMonto: ${(charge.paidAmountCents! / 100).toFixed(2)} ${charge.currency}\nFecha: ${charge.paidAt.toISOString()}\nTransacción: ${charge.transactionId}\nComprobante: payment-${charge.id}\nEste comprobante no es una factura fiscal.`,
+  }
+}
