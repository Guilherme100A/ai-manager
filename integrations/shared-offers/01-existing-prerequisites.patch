index 0000000..dae569f
--- /dev/null
+++ b/packages/shared/src/flows/variables.ts
@@ -0,0 +1,7 @@
+import type { FlowDefinition } from './definition'
+
+/** Definition defaults are fallback values only. Explicit run keys (including null/empty/0) win. */
+export function mergeFlowVariables(definition: Pick<FlowDefinition, 'variables'>, vars: Record<string, unknown> = {}): Record<string, unknown> {
+  const defaults = Object.fromEntries(definition.variables.filter(v => v.default !== undefined).map(v => [v.name, v.default]))
+  return { ...defaults, ...vars }
+}
diff --git a/tests/acceptance/T125/independent-pixel-review.test.ts b/tests/acceptance/T125/independent-pixel-review.test.ts
