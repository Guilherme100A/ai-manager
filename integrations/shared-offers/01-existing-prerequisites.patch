+            </select>
+          </label>
+          <label>
+            Oferta
+            <select aria-label="Oferta" value={manual} onChange={(e) => setManual(e.target.value)}>
+              <option value="">Selecione</option>
+              {offers
+                .filter((o) => o.active)
+                .map((x) => (
+                  <option key={x.id} value={x.id}>
+                    {x.name}
+                  </option>
+                ))}
+            </select>
+          </label>
+        </div>
+        <button
+          disabled={!chat || !manual}
+          onClick={() =>
+            void run(async () => {
+              await api.post('/api/chats/' + chat + '/offer', { offer_id: manual, replace_active: true })
+              setNotice('Oferta selecionada; execução iniciada sem atribuição inventada')
+            })
+          }
+        >
+          Substituir contexto e iniciar oferta
+        </button>
+      </section>
+      <section>
+        <h2>Resultados por responsável e oferta</h2>
+        <div className="offer-fields">
+          <label>
+            Filtrar responsável
+            <select aria-label="Filtrar responsável" value={owner} onChange={(e) => setOwner(e.target.value)}>
+              <option value="">Todos</option>
+              {resources?.members?.map((x) => (
+                <option key={x.id} value={x.id}>
+                  {x.name}
+                </option>
+              ))}
+            </select>
+          </label>
+          <label>
+            Filtrar oferta
+            <select aria-label="Filtrar oferta" value={filterOffer} onChange={(e) => setFilterOffer(e.target.value)}>
+              <option value="">Todas</option>
+              {offers.map((x) => (
+                <option key={x.id} value={x.id}>
+                  {x.name}
+                </option>
+              ))}
+            </select>
+          </label>
+        </div>
+        <p>
+          Moedas separadas. Filtros não restringem o acesso compartilhado dos administradores. Estimativa considera
+          somente custos declarados por venda; custos operacionais e de mídia podem estar incompletos.
+        </p>
+        <div className="offer-table">
+          <table>
+            <thead>
+              <tr>
+                <th>Oferta</th>
+                <th>Responsável</th>
+                <th>Moeda</th>
+                <th>Vendas</th>
+                <th>Receita</th>
+                <th>Lucro estimado dos custos declarados</th>
+              </tr>
+            </thead>
+            <tbody>
+              {results.map((r, i) => (
+                <tr key={i}>
+                  <td>{r.offer_name}</td>
+                  <td>{resources?.members?.find((m) => m.id === r.owner_user_id)?.name ?? r.owner_user_id}</td>
+                  <td>{r.currency}</td>
+                  <td>{r.sales}</td>
+                  <td>{money(r.revenue_cents, r.currency)}</td>
+                  <td>
+                    {r.estimated_profit_cents === null
+                      ? 'Custos não informados'
+                      : money(r.estimated_profit_cents, r.currency)}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+        {!results.length && <p>Nenhuma venda aprovada neste filtro.</p>}
+      </section>
+    </section>
+  )
+}
diff --git a/apps/web/src/features/offers/style.css b/apps/web/src/features/offers/style.css
new file mode 100644
index 0000000..9770378
--- /dev/null
+++ b/apps/web/src/features/offers/style.css
@@ -0,0 +1,138 @@
+.offers-page {
+  max-width: 1250px;
+  margin: 0 auto;
+  padding: 24px;
+  color: var(--foreground, #263246);
+}
+.offers-page h1 {
+  font-size: 26px;
+  font-weight: 650;
+}
+.offers-page h2 {
+  font-size: 19px;
+  font-weight: 600;
+  margin-bottom: 12px;
+}
+.offers-page p {
+  color: var(--muted-foreground, #64748b);
+  margin: 8px 0 16px;
+  line-height: 1.5;
+}
+.offers-page header {
+  display: flex;
+  justify-content: space-between;
+  gap: 16px;
+}
+.offers-page button {
+  border: 1px solid #cbd5e1;
+  border-radius: 7px;
+  padding: 9px 13px;
+  background: var(--card, #fff);
+  cursor: pointer;
+}
+.offers-page button[type='submit'] {
+  background: #146ef5;
+  color: white;
+  border-color: #146ef5;
+}
+.offers-page button:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+.offers-page section,
+.offers-page details,
+.offers-page form,
+.offers-page aside {
+  padding: 20px;
+  background: var(--card, #fff);
+  border: 1px solid #e2e8f0;
+  border-radius: 12px;
+  margin-top: 18px;
+}
+.offer-columns {
+  display: grid;
+  grid-template-columns: 220px 1fr;
+  gap: 18px;
+}
+.offer-columns aside button {
+  display: block;
+  width: 100%;
+  text-align: left;
+  margin: 8px 0;
+}
+.offer-fields {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px;
+}
+.offers-page label {
+  display: flex;
+  flex-direction: column;
+  gap: 7px;
+  font-size: 14px;
+}
+.offers-page input:not([type='checkbox']),
+.offers-page select {
+  width: 100%;
+  min-width: 0;
+  border: 1px solid #cbd5e1;
+  border-radius: 6px;
+  padding: 9px;
+  background: var(--background, #fff);
+  color: inherit;
+}
+.offers-page .check {
+  flex-direction: row;
+  align-items: center;
+  margin: 10px 0;
+}
+.offers-page fieldset {
+  border-top: 1px solid #e2e8f0;
+  padding-top: 14px;
+  margin: 20px 0;
+}
+.offers-page legend {
+  font-weight: 600;
+}
+.origin-row {
+  display: grid;
+  grid-template-columns: 1fr 1fr auto;
+  gap: 8px;
+  margin: 10px 0;
+}
+.offers-page [role='alert'] {
+  color: #b91c1c;
+  background: #fef2f2;
+  padding: 12px;
+  border-radius: 8px;
+}
+.offers-page [role='status'] {
+  color: #166534;
+  padding: 12px;
+}
+.offer-table {
+  overflow: auto;
+}
+.offers-page table {
+  width: 100%;
+  text-align: left;
+  font-size: 14px;
+  border-collapse: collapse;
+}
+.offers-page th,
+.offers-page td {
+  padding: 12px;
+  border-bottom: 1px solid #e2e8f0;
+}
+@media (max-width: 800px) {
+  .offer-columns,
+  .offer-fields {
+    grid-template-columns: 1fr;
+  }
+  .origin-row {
+    grid-template-columns: 1fr;
+  }
+  .offers-page {
+    padding: 12px;
+  }
+}
