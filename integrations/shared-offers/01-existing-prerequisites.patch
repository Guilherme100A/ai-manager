+import { expect, it } from 'vitest'
+import { handleMcpRequest } from './server'
+
+it('MCP accepts a local PDF payload larger than default transport limit and calls private API', async () => {
+  const data_base64 = Buffer.alloc(9 * 1024 * 1024, 65).toString('base64')
+  const calls: unknown[] = []
+  const response = await handleMcpRequest(new Request('http://test/api/mcp', {
+    method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json, text/event-stream' },
+    body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'upload_media', arguments: { file_name: 'guia.pdf', mime: 'application/pdf', data_base64 } } }),
+  }), { db: {} as never, companyId: 'A', api: { access: 'write', perms: new Set(['flows.edit']), api: { request: async (method, path, req) => { calls.push([method, path, req?.write, (req?.body as {data_base64: string}).data_base64.length]); return { status: 201, body: { media: { id: 'signed' } } } } } } })
+  expect(response.status).toBe(200)
+  expect(((await response.json()) as { result: { isError?: boolean } }).result.isError).not.toBe(true)
+  expect(calls).toEqual([['POST', '/api/media/base64', true, data_base64.length]])
+})
