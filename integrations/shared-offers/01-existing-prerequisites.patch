@@ -0,0 +1,65 @@
+import { describe, expect, it, vi } from 'vitest'
+import { Hono } from 'hono'
+import type { AppEnv, ResolvedDeps } from '../../lib/types'
+import { onError } from '../../lib/errors'
+
+vi.mock('@crm/core', async importActual => ({ ...await importActual<object>(), UsageGuard: class {}, meterTts: (p: unknown) => p }))
+const upload = vi.hoisted(() => vi.fn(async () => ({ id: 'media-id', sha256: 'abc', mime: 'audio/mpeg', size: 8 })))
+vi.mock('../media/index', () => ({ mediaServiceFor: () => ({ upload }), mediaApiError: (e: unknown) => e }))
+import { generateSpeechRoutes } from './generate'
+
+const keyId = '00000000-0000-4000-8000-000000000001'
+function harness(permission = true, provider = 'elevenlabs', status = 200, errorBody = 'not authorized') {
+  const fetch = vi.fn(async () => new Response(status === 200 ? 'MP3audio' : errorBody, { status }))
+  const credentialsForKey = vi.fn(async () => ({ apiKey: 'private-test-secret', provider }))
+  const app = new Hono<AppEnv>()
+  app.use('*', async (c, next) => { c.set('ctx', { companyId: 'company-A', user: { id: 'user' }, perms: new Set(permission ? ['flows.edit'] : []) } as never); await next() })
+  app.onError(onError)
+  app.route('/', generateSpeechRoutes({ aiKeys: { credentialsForKey }, aiVoicesFetch: fetch } as unknown as ResolvedDeps))
+  const call = (body: unknown) => app.request('/api/ai-voices/generate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
+  return { call, fetch, credentialsForKey }
+}
+const body = { key_id: keyId, voice_id: 'voice1', text: 'Hola, aquí está tu material.' }
+describe('generated funnel audio', () => {
+  it('persists generated bytes for this company and returns usable flow action without secret', async () => {
+    const h = harness()
+    const r = await h.call(body)
+    expect(r.status).toBe(201)
+    const data = await r.json() as { action: unknown }
+    expect(data.action).toMatchObject({ type: 'send_multi_media', config: { media_type: 'audio', media_url: 'blob:abc' } })
+    expect(JSON.stringify(data)).not.toContain('private-test-secret')
+    expect(h.credentialsForKey).toHaveBeenCalledWith('company-A', keyId)
+    expect(upload).toHaveBeenCalledWith('company-A', expect.any(Uint8Array), 'audio/mpeg', 'audio-funil.mp3')
+    const request = h.fetch.mock.calls[0] as unknown as [URL, RequestInit]
+    expect(JSON.parse(request[1].body as string)).toMatchObject({ text: body.text, model_id: 'eleven_multilingual_v2' })
+  })
+  it('rejects missing permission, wrong provider and invalid input before generation', async () => {
+    const noPermission = harness(false)
+    expect((await noPermission.call(body)).status).toBe(403)
+    expect(noPermission.fetch).not.toHaveBeenCalled()
+    const wrong = harness(true, 'openai')
+    expect((await wrong.call(body)).status).toBe(422)
+    expect(wrong.fetch).not.toHaveBeenCalled()
+    expect((await harness().call({ ...body, text: '' })).status).toBe(422)
+  })
+  it('provider rejection never returns the secret or a usable audio action', async () => {
+    const h = harness(true, 'elevenlabs', 401)
+    const r = await h.call(body)
+    expect(r.status).toBe(502)
+    const text = await r.text()
+    expect(text).not.toContain('private-test-secret')
+    expect(text).toContain('credencial recusada')
+  })
+  it('preserves non-retryable provider 402 without uploading media or retrying generation', async () => {
+    upload.mockClear()
+    const h = harness(true, 'elevenlabs', 402, JSON.stringify({ detail: { status: 'payment_required', message: 'private-test-secret untrusted details' } }))
+    const r = await h.call(body)
+    expect(r.status).toBe(502)
+    const data = await r.json()
+    expect(data).toMatchObject({ error: { code: 'UPSTREAM_ERROR', details: { provider: 'elevenlabs', status: 402, provider_code: 'payment_required', retryable: false } } })
+    expect(JSON.stringify(data)).not.toContain('private-test-secret')
+    expect(data).not.toHaveProperty('action')
+    expect(h.fetch).toHaveBeenCalledTimes(1)
+    expect(upload).not.toHaveBeenCalled()
+  })
+})
