+  border-bottom: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
+}
+:root[data-skin='ai-manager'] tbody tr:last-child td {
+  border-bottom: 0;
+}
+:root[data-skin='ai-manager'] tbody tr:hover {
+  background: var(--am-accent-soft);
+}
+:root[data-skin='ai-manager'] :where([class~='border-dashed']) {
+  border-color: var(--am-border-strong);
+}
+
+/* Dashboard: distinct metrics, calm filter surface, readable chart panels. */
+:root[data-skin='ai-manager'] .crm-stat {
+  position: relative;
+  padding: 18px;
+  gap: 8px;
+  border-radius: 14px;
+  border-top: 2px solid color-mix(in srgb, var(--primary) 65%, var(--border));
+  background-image: linear-gradient(135deg, var(--am-accent-soft), transparent 70%);
+}
+:root[data-skin='ai-manager'] .crm-stat[data-negative='true'] {
+  border-top-color: var(--destructive);
+}
+:root[data-skin='ai-manager'] .crm-stat > p:nth-child(2) {
+  font-size: clamp(20px, 1.8vw, 28px);
+  line-height: 1.2;
+  letter-spacing: -0.04em;
+}
+:root[data-skin='ai-manager'] .crm-stat > p:first-child {
+  font-size: 12px;
+  font-weight: 550;
+}
+:root[data-skin='ai-manager'] .crm-chart {
+  padding: 18px;
+  border-radius: 14px;
+  gap: 16px;
+}
+:root[data-skin='ai-manager'] .crm-filterbar {
+  padding: 16px;
+  gap: 12px;
+}
+:root[data-skin='ai-manager'] [data-testid='dashboard'] > [role='tablist'] {
+  align-self: flex-start;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  background: var(--card);
+  padding: 4px;
+}
+
+/* Conversation workspace and empty states. No message bubble or status overrides. */
+:root[data-skin='ai-manager'] [data-testid='chat-list-panel'] {
+  padding: 14px;
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  background: var(--card);
+}
+:root[data-skin='ai-manager'] :is([data-testid='chat-conversation'], [data-testid='chat-panel-slot']) {
+  border-radius: 14px;
+}
+:root[data-skin='ai-manager'] [data-testid='chat-conversation-empty'] {
+  border-style: solid;
+  border-radius: 14px;
+  background: radial-gradient(circle at center, var(--am-accent-soft), transparent 65%), var(--card);
+}
+:root[data-skin='ai-manager'] [data-testid='chat-conversation-empty'] > svg {
+  color: var(--primary);
+  width: 48px;
+  height: 48px;
+  margin-bottom: 12px;
+}
+:root[data-skin='ai-manager'] [data-testid='chat-conversation'] > header {
+  padding: 14px 16px;
+  background: var(--muted);
+  border-radius: 13px 13px 0 0;
+}
+
+/* Cards throughout the operational lists and settings hub. */
+:root[data-skin='ai-manager'] :is([data-testid='crms-grid'], [data-testid='flows-cards']) > li {
+  border-radius: 14px;
+  box-shadow: var(--am-shadow);
+  transition:
+    border-color 150ms ease,
+    box-shadow 150ms ease;
+}
+:root[data-skin='ai-manager'] :is([data-testid='crms-grid'], [data-testid='flows-cards']) > li:hover {
+  border-color: var(--primary);
+}
+:root[data-skin='ai-manager'] [data-testid='connections-counts'] > * {
+  border-radius: 12px;
+  padding-block: 12px;
+}
+:root[data-skin='ai-manager'] section[data-column-id] {
+  border-radius: 14px;
+  background: var(--muted);
+}
+:root[data-skin='ai-manager'] section[data-column-id] > header {
+  padding-block: 12px;
+}
+:root[data-skin='ai-manager'] [data-testid='page-settings'] > div > nav {
+  align-self: flex-start;
+  padding: 6px;
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  background: var(--card);
+}
+:root[data-skin='ai-manager'] [data-testid^='settings-tab-'].bg-accent {
+  color: var(--primary);
+  background: var(--am-accent-soft);
+  box-shadow: inset 3px 0 var(--primary);
+}
+:root[data-skin='ai-manager'] [data-testid='chat-list-panel'] [role='tab'] .truncate {
+  white-space: nowrap;
+  text-overflow: clip;
+  line-height: 1.2;
+}
+:root[data-skin='ai-manager'] [data-testid='chat-list-panel'] [role='tab'] {
+  flex-direction: column;
+  padding-inline: 2px;
+  font-size: 11px;
+}
+:root[data-skin='ai-manager'] .flow-workspace {
+  background-image: radial-gradient(circle at 50% 35%, var(--am-accent-soft), transparent 75%);
+}
+
+@media (max-width: 639px) {
+  :root[data-skin='ai-manager'] .crm-stat {
+    padding: 12px;
+  }
+  :root[data-skin='ai-manager'] .crm-filterbar {
+    padding: 12px;
+  }
+  :root[data-skin='ai-manager'] .crm-chart {
+    padding: 14px;
+  }
+}
+/* The composer uses the available panel width, even on a desktop with three panes. */
+:root[data-skin='ai-manager'] [data-testid='chat-page'][data-layout='desktop']:has([data-testid='chat-panel-slot']) {
+  grid-template-columns: minmax(13rem, 0.85fr) minmax(0, 1.4fr) minmax(12rem, 0.75fr);
+}
+:root[data-skin='ai-manager'] .crm-composer-row {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 8px;
+}
+:root[data-skin='ai-manager'] .crm-composer-row > div:first-child {
+  order: 0;
+  width: auto;
+  flex-wrap: wrap;
+}
+:root[data-skin='ai-manager'] .crm-composer-row > div:nth-child(2) {
+  order: -1;
+  grid-column: 1 / -1;
+}
+@media (prefers-reduced-motion: reduce) {
+  :root[data-skin='ai-manager'] :where(button, a, input, textarea, select) {
+    transition: none;
+  }
+}
