+  app = createApp({ db, redis, blobStore: blobs, mailer: new MemoryMailer(), logger: createLogger({ level: 'silent' }) })
+}, 120000)
+afterAll(async () => { redis?.disconnect(); await db?.$client.end(); await temp?.drop(); if (dir) await rm(dir, { recursive: true, force: true }); vi.unstubAllEnvs() })
+
+async function tenant() {
+  const [company] = await db.insert(companies).values({ name: 'Media fixture', slug: randomUUID() }).returning()
+  const [connection] = await db.insert(connections).values({ companyId: company!.id, sessionId: randomUUID(), name: 'Private fixture', connectionState: 'open' }).returning()
+  return { companyId: company!.id, sessionId: connection!.sessionId, connectionId: connection!.id }
+}
+const read = (session: string, sha: string, token: string | null = TOKEN, metadata = false) => app.request('/internal/wa-media', {
+  method: 'POST', headers: { 'content-type': 'application/json', ...(token ? { authorization: 'Bearer ' + token } : {}) },
+  body: JSON.stringify({ session_id: session, sha256: sha, ...(metadata ? { metadata_only: true } : {}) }),
+})
+
+describe('private CRM media endpoint, no public media URL', () => {
+  it.each(['image/png', 'audio/mpeg', 'application/pdf', 'video/mp4'])('%s has authenticated metadata and exact bytes for its own session', async mime => {
+    const t = await tenant(), bytes = Buffer.from('private ' + mime)
+    const asset = await media.upload(t.companyId, bytes, mime)
+    const meta = await read(t.sessionId, asset.sha256, TOKEN, true)
+    expect(meta.status).toBe(200)
+    expect(await meta.json()).toEqual({ sha256: asset.sha256, size: bytes.length, mime })
+    const response = await read(t.sessionId, asset.sha256)
+    expect(response.status).toBe(200)
+    expect(response.headers.get('cache-control')).toBe('no-store')
+    expect(response.headers.get('content-type')).toBe(mime)
+    expect(Buffer.from(await response.arrayBuffer())).toEqual(bytes)
+  })
+
+  it('foreign company/session cannot read or preflight a guessed existing hash', async () => {
+    const a = await tenant(), b = await tenant(), asset = await media.upload(a.companyId, Buffer.from('only company A'), 'image/png')
+    expect((await read(b.sessionId, asset.sha256)).status).toBe(404)
+    expect((await read(b.sessionId, asset.sha256, TOKEN, true)).status).toBe(404)
+    expect((await read(randomUUID(), asset.sha256)).status).toBe(404)
+    expect((await read(a.sessionId, asset.sha256, null)).status).toBe(401)
+    expect((await read(a.sessionId, asset.sha256, 'invalid')).status).toBe(401)
+    expect((await read(a.sessionId, '../path')).status).toBe(422)
+  })
+
+  it('unlinked, deleting and disabled-company sessions are denied without publishing bytes', async () => {
+    const t = await tenant(), asset = await media.upload(t.companyId, Buffer.from('blocked fixture'), 'application/pdf')
+    await db.update(connections).set({ unlinkedAt: new Date() }).where(eq(connections.id, t.connectionId))
+    expect((await read(t.sessionId, asset.sha256)).status).toBe(404)
+    await db.update(connections).set({ unlinkedAt: null, scheduledForDeletionAt: new Date() }).where(eq(connections.id, t.connectionId))
+    expect((await read(t.sessionId, asset.sha256)).status).toBe(404)
+    await db.update(connections).set({ scheduledForDeletionAt: null }).where(eq(connections.id, t.connectionId))
+    await db.update(companies).set({ active: false }).where(eq(companies.id, t.companyId))
+    expect((await read(t.sessionId, asset.sha256)).status).toBe(404)
+  })
+
+  it('legacy audited upload is accepted, disk presence or a flow reference alone never grant ownership', async () => {
+    const t = await tenant(), stored = await blobs.put(Buffer.from('legacy uploaded file'), 'image/png')
+    expect((await read(t.sessionId, stored.sha256)).status).toBe(404)
+    await db.insert(auditLogs).values({ companyId: t.companyId, action: 'flows.update', targetType: 'flow', targetId: stored.sha256 })
+    expect((await read(t.sessionId, stored.sha256)).status).toBe(404)
+    await db.insert(auditLogs).values({ companyId: t.companyId, action: 'media.upload', targetType: 'media', targetId: stored.sha256 })
+    expect((await read(t.sessionId, stored.sha256)).status).toBe(200)
+  })
+})
