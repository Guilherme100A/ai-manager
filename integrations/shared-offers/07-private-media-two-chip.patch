@@ -0,0 +1,35 @@
+import { timingSafeEqual } from 'node:crypto'
+import { Hono } from 'hono'
+import { bodyLimit } from 'hono/body-limit'
+import { and, eq, isNull } from 'drizzle-orm'
+import { companies, connections } from '@crm/db'
+import { DEFAULT_MEDIA_LIMITS, mediaKindOf, ownsPrivateMedia } from '@crm/core'
+import { FsBlobStore } from '@crm/node-kit'
+import type { AppEnv, ResolvedDeps } from '../../lib/types'
+import { ApiError } from '../../lib/errors'
+
+/** Leitura privada worker -> CRM. Sem URL publica, token na query ou mount compartilhado. */
+export function internalWaMediaRoutes(deps: ResolvedDeps) {
+  const app = new Hono<AppEnv>()
+  app.post('/internal/wa-media', bodyLimit({ maxSize: 2048 }), async c => {
+    const expected = Buffer.from(process.env.INTERNAL_TOKEN?.trim() ?? '')
+    const given = Buffer.from(c.req.header('authorization')?.replace(/^Bearer\s+/i, '').trim() ?? '')
+    if (!expected.length || expected.length !== given.length || !timingSafeEqual(expected, given)) throw new ApiError('UNAUTHORIZED', 'Acesso interno necessario')
+    const input = await c.req.json<{ session_id?: unknown; sha256?: unknown; metadata_only?: unknown }>().catch(() => null)
+    if (typeof input?.session_id !== 'string' || input.session_id.length > 100 || typeof input.sha256 !== 'string' || !/^[a-f0-9]{64}$/.test(input.sha256))
+      throw new ApiError('VALIDATION_ERROR', 'Referencia de midia invalida')
+    const [conn] = await deps.db.select({ companyId: connections.companyId }).from(connections)
+      .innerJoin(companies, and(eq(companies.id, connections.companyId), eq(companies.active, true)))
+      .where(and(eq(connections.sessionId, input.session_id), isNull(connections.unlinkedAt), isNull(connections.scheduledForDeletionAt))).limit(1)
+    if (!conn || !await ownsPrivateMedia(deps.db, conn.companyId, input.sha256)) throw new ApiError('NOT_FOUND', 'Midia indisponivel para esta conexao')
+    const blobs = deps.blobStore ?? new FsBlobStore()
+    const info = await blobs.head(input.sha256)
+    const kind = info && mediaKindOf(info.mime)
+    if (!info || !kind || info.size > DEFAULT_MEDIA_LIMITS[kind]) throw new ApiError('NOT_FOUND', 'Midia indisponivel para esta conexao')
+    if (input.metadata_only === true) { c.header('cache-control', 'no-store'); return c.json({ sha256: input.sha256, size: info.size, mime: info.mime }, 200) }
+    const data = await blobs.get(input.sha256)
+    if (!data || data.length > DEFAULT_MEDIA_LIMITS[kind]) throw new ApiError('NOT_FOUND', 'Midia indisponivel para esta conexao')
+    return new Response(new Uint8Array(data), { headers: { 'content-type': info.mime, 'cache-control': 'no-store', 'x-content-sha256': input.sha256 } })
+  })
+  return app
+}
