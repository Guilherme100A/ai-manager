@@ -0,0 +1,45 @@
+-- O mesmo ID WhatsApp pode existir na saida de um chip e entrada de outro.
+-- Dentro de uma conexao continua unico, inclusive antes/depois de mapear PN/LID.
+ALTER TABLE crm.messages ADD COLUMN connection_id uuid;
+--> statement-breakpoint
+UPDATE crm.messages AS m SET connection_id = c.connection_id
+FROM crm.chats AS c JOIN crm.connections AS co ON co.id = c.connection_id AND co.company_id = c.company_id
+WHERE c.id = m.chat_id AND c.company_id = m.company_id;
+--> statement-breakpoint
+DO $$ BEGIN
+  IF EXISTS (SELECT 1 FROM crm.messages WHERE connection_id IS NULL) THEN
+    RAISE EXCEPTION 'message company/chat identity drift; migration aborted';
+  END IF;
+END $$;
+--> statement-breakpoint
+ALTER TABLE crm.messages ALTER COLUMN connection_id SET NOT NULL;
+--> statement-breakpoint
+CREATE UNIQUE INDEX chats_company_id_connection_uq ON crm.chats(company_id,id,connection_id);
+--> statement-breakpoint
+ALTER TABLE crm.messages ADD CONSTRAINT messages_chat_connection_fk
+  FOREIGN KEY(company_id,chat_id,connection_id) REFERENCES crm.chats(company_id,id,connection_id) ON DELETE CASCADE;
+--> statement-breakpoint
+CREATE FUNCTION crm.bind_message_connection() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE expected uuid;
+BEGIN
+  SELECT c.connection_id INTO expected FROM crm.chats AS c
+    JOIN crm.connections AS co ON co.id = c.connection_id AND co.company_id = c.company_id
+    WHERE c.company_id = NEW.company_id AND c.id = NEW.chat_id;
+  IF NOT FOUND THEN RAISE EXCEPTION 'message company/chat identity mismatch' USING ERRCODE='23503'; END IF;
+  IF NEW.connection_id IS NOT NULL AND NEW.connection_id IS DISTINCT FROM expected THEN
+    RAISE EXCEPTION 'message connection mismatch' USING ERRCODE='23503';
+  END IF;
+  IF TG_OP = 'UPDATE' AND expected IS DISTINCT FROM OLD.connection_id THEN
+    RAISE EXCEPTION 'message cannot change connection' USING ERRCODE='23503';
+  END IF;
+  NEW.connection_id := expected;
+  RETURN NEW;
+END $$;
+--> statement-breakpoint
+CREATE TRIGGER bind_message_connection BEFORE INSERT OR UPDATE OF company_id,chat_id,connection_id
+  ON crm.messages FOR EACH ROW EXECUTE FUNCTION crm.bind_message_connection();
+--> statement-breakpoint
+CREATE UNIQUE INDEX messages_company_connection_wa_id_uq
+  ON crm.messages(company_id,connection_id,wa_message_id) WHERE wa_message_id IS NOT NULL;
+--> statement-breakpoint
+DROP INDEX crm.messages_company_wa_id_uq;
