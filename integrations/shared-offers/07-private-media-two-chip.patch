+let temp: TempDatabase, db: Database, redis: RedisClient, dir: string, blobs: FsBlobStore, media: MediaService, app: ReturnType<typeof createApp>
+const TOKEN = 'synthetic-internal-media-token'
+beforeAll(async () => {
+  vi.stubEnv('INTERNAL_TOKEN', TOKEN)
+  temp = await createTempDatabase({ migrate: true })
