@@ -0,0 +1,18 @@
+// Prova persistente de que o blob privado foi gravado para a empresa.
+// Nunca autoriza pela mera presenca de um hash em texto de fluxo/chat.
+import { and, eq, inArray } from 'drizzle-orm'
+import { auditLogs, type Database } from '@crm/db'
+
+const ACTIONS = ['media.upload', 'ai_voices.generate', 'media.private_store']
+export async function ownsPrivateMedia(db: Database, companyId: string, sha256: string): Promise<boolean> {
+  const [row] = await db.select({ id: auditLogs.id }).from(auditLogs)
+    .where(and(eq(auditLogs.companyId, companyId), eq(auditLogs.targetType, 'media'), eq(auditLogs.targetId, sha256), inArray(auditLogs.action, ACTIONS))).limit(1)
+  return !!row
+}
+
+export function privateMediaOwnershipRecorder(db: Database) {
+  return async (companyId: string, media: { sha256: string }) => {
+    if (await ownsPrivateMedia(db, companyId, media.sha256)) return
+    await db.insert(auditLogs).values({ companyId, action: 'media.private_store', targetType: 'media', targetId: media.sha256 })
+  }
+}
