+// Disposable PostgreSQL/Redis and fake providers, executed on CI only.
+// CRM-003: Ofertas saíram do catálogo MCP. Garante ausência na descoberta e na chamada; o resto do MCP segue funcionando.
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { startSystem, tenant, type System, type Tenant } from './setup'
+let sys: System, t: Tenant, other: Tenant, writer: string, reader: string
+const priorGate = process.env.SHARED_OFFERS_COMPANY_ID
+let sequence = 0
+const REMOVED = ['list_offers', 'get_offer', 'get_offer_resources', 'get_offer_results', 'create_offer', 'update_offer', 'set_offer_connection_mode', 'list_conversation_offer_opportunities', 'adopt_offer_business_area']
+async function rpc(token: string, method: string, params: Record<string, unknown> = {}) {
+  const response = await sys.app.request('/api/mcp', { method: 'POST', headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json', accept: 'application/json, text/event-stream', 'mcp-protocol-version': '2025-06-18' }, body: JSON.stringify({ jsonrpc: '2.0', id: ++sequence, method, params }) })
+  return { status: response.status, body: await response.json() as any }
+}
+async function invoke(token: string, name: string, args: Record<string, unknown> = {}) {
+  const response = await rpc(token, 'tools/call', { name, arguments: args })
+  return { ...response, error: Boolean(response.body.error || response.body.result?.isError) }
+}
+const names = async (token: string): Promise<string[]> => (await rpc(token, 'tools/list')).body.result.tools.map((tool: any) => tool.name)
+beforeAll(async () => {
+  sys = await startSystem(); t = await tenant(sys); other = await tenant(sys)
+  process.env.SHARED_OFFERS_COMPANY_ID = t.companyId
+  const write = await t.c.post('/api/mcp_credentials', { name: 'MCP writer', access: 'write' })
+  const read = await t.c.post('/api/mcp_credentials', { name: 'MCP reader', access: 'read' })
+  expect(write.status).toBe(201); expect(read.status).toBe(201)
+  writer = write.body.token; reader = read.body.token
+}, 180_000)
+afterAll(async () => {
+  if (priorGate === undefined) delete process.env.SHARED_OFFERS_COMPANY_ID
+  else process.env.SHARED_OFFERS_COMPANY_ID = priorGate
+  await sys?.close()
+}, 120_000)
+
+it('discovery never lists Offers tools, for any credential, company or gate value', async () => {
+  const foreign = (await other.c.post('/api/mcp_credentials', { name: 'Foreign MCP', access: 'write' })).body.token
+  for (const gate of [t.companyId, '', 'invalid', other.companyId]) {
+    process.env.SHARED_OFFERS_COMPANY_ID = gate
+    for (const token of [writer, reader, foreign]) expect((await names(token)).filter(n => REMOVED.includes(n))).toEqual([])
+  }
+  process.env.SHARED_OFFERS_COMPANY_ID = t.companyId
+})
+it('calling a removed Offers tool fails and does not change data', async () => {
+  const before = await sys.q('select id from crm.offers where company_id=$1', [t.companyId])
+  for (const name of REMOVED) {
+    expect((await invoke(writer, name, { id: '00000000-0000-4000-8000-000000000000', offer_id: '00000000-0000-4000-8000-000000000000', name: 'x', config: {}, confirm: true, enabled: true })).error, name).toBe(true)
+  }
+  expect(await sys.q('select id from crm.offers where company_id=$1', [t.companyId])).toEqual(before)
+})
+it('the remaining MCP works without Offers: protocol, reads, writes and permissions', async () => {
+  expect((await rpc(reader, 'initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'no-offers-test', version: '1' } })).status).toBe(200)
+  const read = await names(reader), write = await names(writer)
+  expect(read).toEqual(expect.arrayContaining(['list_flows', 'list_conversations', 'list_connections']))
+  expect(write).toEqual(expect.arrayContaining(['list_flows', 'create_flow']))
+  expect(read).not.toContain('create_flow')
+  expect((await invoke(reader, 'list_conversations')).error).toBe(false)
+  expect((await invoke(reader, 'create_flow', { name: 'forbidden' })).error).toBe(true)
+})
+it('revoked MCP credentials are refused immediately', async () => {
+  const made = await other.c.post('/api/mcp_credentials', { name: 'revocation', access: 'read' })
+  expect((await rpc(made.body.token, 'tools/list')).status).toBe(200)
+  expect((await other.c.delete('/api/mcp_credentials/' + made.body.mcp_credential.id)).status).toBe(200)
+  expect((await rpc(made.body.token, 'tools/list')).status).toBe(401)
+})
