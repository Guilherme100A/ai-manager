index 0000000000000000000000000000000000000000..01b6ce449ea51d91b53cc5bb46ede3a4c3a68df9
--- /dev/null
+++ b/packages/core/src/mcp/tools/catalog-sem-ofertas.unit.test.ts
@@ -0,0 +1,92 @@
+import { Client } from '@modelcontextprotocol/sdk/client/index.js'
+import { InMemoryTransport } from '@modelcontextprotocol/sdk/inMemory.js'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { PermissionKey } from '@crm/shared'
+import type { Database } from '@crm/db'
+import { createMcpServer } from '../server'
+import type { McpApiRequest } from './shared'
+
+const COMPANY = '3f1b2c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d'
+const ID = '4f1b2c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d'
+const REMOVED = ['list_offers', 'get_offer', 'get_offer_resources', 'get_offer_results', 'create_offer', 'update_offer', 'set_offer_connection_mode', 'list_conversation_offer_opportunities', 'adopt_offer_business_area']
+const AREAS = ['list_business_areas', 'initialize_business_areas', 'configure_business_area', 'get_business_area_resource_catalog', 'share_workspace_flow']
+const ALL: PermissionKey[] = ['settings.products.view', 'settings.products.edit', 'chat.view', 'flows.view', 'flows.edit']
+const closers: (() => Promise<void>)[] = []
+afterEach(async () => { await Promise.all(closers.splice(0).map(close => close())); vi.unstubAllEnvs() })
+
+async function connect(opts: { gate?: boolean; admin?: boolean; access?: 'read' | 'write'; perms?: PermissionKey[] } = {}) {
+  const { gate = true, admin = true, access = 'write', perms = ALL } = opts
+  vi.stubEnv('SHARED_OFFERS_COMPANY_ID', gate ? COMPANY : '')
+  const calls: { method: string; path: string; req?: McpApiRequest }[] = []
+  const api = { request: async (method: string, path: string, req?: McpApiRequest) => { calls.push({ method, path, req }); return { status: 200, body: { ok: true } as unknown } } }
+  const server = createMcpServer({ db: {} as Database, companyId: COMPANY, api: { access, perms: new Set(perms), api: api as never, businessAreasAdmin: admin } })
+  const client = new Client({ name: 'client', version: '1' }), [a, b] = InMemoryTransport.createLinkedPair()
+  await Promise.all([server.connect(a), client.connect(b)])
+  closers.push(async () => { await client.close(); await server.close() })
+  return { client, calls, names: async () => (await client.listTools()).tools.map(t => t.name), call: (name: string, args: Record<string, unknown> = {}) => client.callTool({ name, arguments: args }) }
+}
+
+describe('catálogo MCP sem Ofertas', () => {
+  it.each([
+    ['empresa de áreas + dono, escrita', { gate: true, admin: true, access: 'write' as const }],
+    ['empresa de áreas + dono, leitura', { gate: true, admin: true, access: 'read' as const }],
+    ['empresa de áreas sem vínculo do dono', { gate: true, admin: false }],
+    ['empresa fora do gate', { gate: false, admin: false }],
+  ])('descoberta (tools/list) não anuncia nenhuma ferramenta de oferta: %s', async (_, opts) => {
+    const { names } = await connect(opts)
+    const found = await names()
+    expect(found.filter(n => REMOVED.includes(n))).toEqual([])
+    expect(found.filter(n => /offer/.test(n) && !n.includes('spy'))).toEqual([])
+    for (const keep of ['list_contacts', 'list_flows', 'list_conversations', 'get_conversation', 'list_spy_offers']) expect(found).toContain(keep)
+    if (!('access' in opts && opts.access === 'read')) expect(found).toContain('capture_spy_offer')
+  })
+
+  it('instruções e esquemas não citam Ofertas compartilhadas nem ferramentas removidas', async () => {
+    for (const access of ['write', 'read'] as const) {
+      const { client } = await connect({ access })
+      const text = (client.getInstructions() ?? '') + JSON.stringify((await client.listTools()).tools)
+      expect(client.getInstructions()).toBeTruthy()
+      for (const name of REMOVED) expect(text).not.toContain(name)
+      expect(text).not.toMatch(/Ofertas compartilhadas|ofertas de chip|modalidade de ofertas/i)
+      expect(text).not.toMatch(/ferramentas de ofertas/i)
+    }
+  })
+
+  it('MCP de áreas continua só para a empresa de áreas com o dono vinculado', async () => {
+    expect((await (await connect({ gate: true, admin: true })).names())).toEqual(expect.arrayContaining(AREAS))
+    for (const opts of [{ gate: true, admin: false }, { gate: false, admin: true }, { gate: false, admin: false }]) {
+      const names = await (await connect(opts)).names()
+      expect(names.filter(n => AREAS.includes(n) && n !== 'share_workspace_flow')).toEqual([])
+    }
+    const { client } = await connect()
+    const flows = (await client.listTools()).tools.find(t => t.name === 'get_flow')!
+    expect(Object.keys(flows.inputSchema.properties ?? {})).toContain('business_area_id')
+  })
+
+  it.each(REMOVED)('chamar %s diretamente falha sem tocar a API', async name => {
+    const { call, calls } = await connect()
+    const outcome = await call(name, { id: ID, offer_id: ID, confirm: true, connection_id: ID, enabled: true, conversation_id: ID }).then(r => r.isError === true, () => true)
+    expect(outcome).toBe(true)
+    expect(calls).toHaveLength(0)
+  })
+
+  it('fluxo normal sem Ofertas: conversas, áreas e Sonda chamam a API autenticada', async () => {
+    const { call, calls } = await connect()
+    expect((await call('get_conversation', { id: ID })).isError).toBeFalsy()
+    expect((await call('list_business_areas')).isError).toBeFalsy()
+    expect((await call('initialize_business_areas')).isError).toBeFalsy()
+    expect((await call('get_business_area_resource_catalog')).isError).toBeFalsy()
+    expect((await call('list_spy_offers')).isError).toBeFalsy()
+    expect(calls.map(c => [c.method, c.path])).toEqual(expect.arrayContaining([
+      ['GET', `/api/chats/${ID}`], ['GET', '/api/business-areas'], ['POST', '/api/business-areas/initialize'], ['GET', '/api/business-areas/catalog'],
+    ]))
+    expect(calls.some(c => c.path.includes('/api/offers') || c.path.includes('/offers') && !c.path.includes('spy-bridge'))).toBe(false)
+  })
+
