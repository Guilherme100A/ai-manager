+    vars, wa, llm, store, contact: null, repo: { companyId: 'company', db: null, dryRun: false }, log: { info() {}, warn() {}, error() {}, debug() {} } })
+  const registry = productionNodeRegistry({ resolveTarget: async () => ({ sessionId: 's', phone: '+5511999990001' }), sleep: async () => undefined })
+  return { definition, wa, vars, context, registry, llm }
