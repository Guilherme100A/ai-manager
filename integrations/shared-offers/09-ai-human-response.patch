+    expect(f.wa.sent).toHaveLength(0)
+    expect(f.vars.resposta).toBe('¿Hay mensualidad?')
+    expect(await f.registry.get('ai')!.execute(f.context(ai, 18))).toEqual({ next: 'output:RESPONDER' })
+    expect(await f.registry.get('wait_response')!.execute(f.context(reply, 19))).toHaveProperty('wait')
+    expect(f.wa.sent).toHaveLength(1)
+    expect(f.wa.sent[0]!.content).toEqual({ text: 'Sí, es un pago único; no hay mensualidad.' })
