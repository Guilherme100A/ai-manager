+    expect(await externalHandlers({ messaging: { resolveTarget: async () => ({ sessionId: 's', phone: '+5511999990001' }), sleep: async () => undefined } }).ai.execute(f.context(ai))).toEqual({ next: 'success' })
+    expect(f.vars['ai.response']).toBe('Hola, ¿en qué te ayudo?')
+    expect(f.wa.sent).toHaveLength(1)
