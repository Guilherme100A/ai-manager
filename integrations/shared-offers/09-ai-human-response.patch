+import type { FlowDefinition } from '@crm/shared'
+
+/** Routing metadata is never a customer reply, including legacy/provider text envelopes. */
+export function classifiedResponse(value: unknown, keys: readonly string[]): string | null {
+  if (typeof value !== 'string') return null
+  const text = value.trim()
+  if (!text || keys.includes(text)) return null
+  const candidate = /^```(?:json)?\s*([\s\S]*?)\s*```$/i.exec(text)?.[1] ?? text
+  try {
+    const parsed: unknown = JSON.parse(candidate)
+    if (parsed && typeof parsed === 'object' && ('output_key' in parsed || 'response' in parsed)) return null
+  } catch { /* A normal conversational reply is not JSON. */ }
+  return text
+}
+
+/** An existing snapshot can explicitly consume the response in the very next message. */
+export function nextMessageNeedsResponse(definition: FlowDefinition, nodeId: string, output: string, variable?: string): boolean {
+  const variables = ['ai.response', ...(variable?.trim() ? [variable.trim()] : [])]
+  const tokens = variables.map(v => new RegExp('\\{\\{?\\s*' + v.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*\\}\\}?'))
+  const targets = new Set(definition.edges.filter(e => e.from === nodeId && e.handle === `output:${output}`).map(e => e.to))
+  return definition.nodes.some(n => targets.has(n.id) && n.actions.some(a =>
+    ['send_message', 'send_interactive_menu', 'send_carousel'].includes(a.type) && tokens.some(t => t.test(JSON.stringify(a.config)))))
+}
