+    const f = setup([ai, reply], reply.id, new FakeLlm([output({ output_key: 'RESPONDER', response: 'Sí, es un pago único; no hay mensualidad.' })]))
+    f.vars.__await = { node: 'N28R', seq: 16 }
+    f.vars.__replies = [{ text: '¿Hay mensualidad?' }]
