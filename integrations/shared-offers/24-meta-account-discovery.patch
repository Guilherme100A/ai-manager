+function WorkspaceAccounts({
+  profile,
+  companyId,
+  manager,
+  busy,
+  onLinked,
+}: {
+  profile: MetaProfile
+  companyId: string | undefined
+  manager: boolean
+  busy: boolean
+  onLinked: () => Promise<void>
+}) {
+  const t = useT(NS)
+  const qc = useQueryClient()
+  const area = activeBusinessArea()
+  const key = workspaceAccountsKey(companyId, profile.id)
+  const list = useQuery({ queryKey: key, queryFn: () => fetchWorkspaceAccounts(profile.id), retry: false })
+  const [selected, setSelected] = useState<WorkspaceAdAccount | null>(null)
+  const [pending, setPending] = useState(false)
+  const [error, setError] = useState(false)
+  const lock = useRef(false)
+  const mounted = useRef(true)
+  useEffect(() => {
+    mounted.current = true
+    return () => {
+      mounted.current = false
+    }
+  }, [])
+  const current = () => mounted.current && activeCompany() === companyId && activeBusinessArea() === area
+  const confirm = async () => {
+    if (!selected || lock.current || !current()) return
+    lock.current = true
+    setPending(true)
+    setError(false)
+    try {
+      await linkWorkspaceAccount(profile.id, selected.fb_account_id)
+      if (!current()) return
+      await onLinked()
+      if (!current()) return
+      await qc.invalidateQueries({ queryKey: key })
+      setSelected(null)
+    } catch {
+      if (current()) setError(true)
+    } finally {
+      lock.current = false
+      if (current()) setPending(false)
+    }
+  }
+  return (
+    <section
+      className="mb-4 flex flex-col gap-2"
+      data-testid={`facebook-candidates-${profile.id}`}
+      aria-busy={list.isFetching || pending}
+    >
+      <p className="text-sm font-medium">{t('profiles.discovery.available')}</p>
+      <p className="text-sm text-muted-foreground">{t('profiles.discovery.hint')}</p>
+      {list.isError ? (
+        <div role="alert">
+          <p>{t('profiles.discovery.loadError')}</p>
+          <Button variant="outline" disabled={list.isFetching || pending || busy} onClick={() => void list.refetch()}>
+            {t('common.retry')}
+          </Button>
+        </div>
+      ) : list.isPending ? (
+        <p>{t('profiles.discovery.loading')}</p>
+      ) : list.data.length === 0 ? (
+        <p data-testid="facebook-candidates-empty">{t('profiles.discovery.empty')}</p>
+      ) : (
+        <ul className="flex flex-col gap-2">
+          {list.data.map((a) => {
+            const linked = profile.ad_accounts.some((account) => account.fb_account_id === a.fb_account_id)
+            return (
+              <li
+                key={a.fb_account_id}
+                className="flex flex-wrap items-center gap-3 rounded-md border p-2"
+                data-testid="facebook-candidate"
+              >
+                <span className="min-w-0 flex-1 text-sm">
+                  <span className="block font-medium">{a.name || maskedAccountId(a.fb_account_id)}</span>
+                  <span>
+                    {maskedAccountId(a.fb_account_id)} · {a.currency ?? '—'} ·{' '}
+                    {t('profiles.discovery.status', { status: a.account_status ?? '—' })}
+                  </span>
+                </span>
+                {linked ? (
+                  <span>{t('profiles.discovery.linked')}</span>
+                ) : manager ? (
+                  <Button
+                    variant="outline"
+                    disabled={pending || busy || list.isFetching}
+                    onClick={() => {
+                      setError(false)
+                      setSelected(a)
+                    }}
+                  >
+                    {t('profiles.discovery.link')}
+                  </Button>
+                ) : null}
+              </li>
+            )
+          })}
+        </ul>
+      )}
+      {selected ? (
+        <div className="rounded-md border p-3" role="group" aria-label={t('profiles.discovery.confirmTitle')}>
+          <p>
+            {t('profiles.discovery.confirm', {
+              name: selected.name || maskedAccountId(selected.fb_account_id),
+              id: maskedAccountId(selected.fb_account_id),
+            })}
+          </p>
+          {error ? <p role="alert">{t('profiles.discovery.linkError')}</p> : null}
+          <Button disabled={pending || busy} onClick={() => void confirm()}>
+            {t(error ? 'common.retry' : 'profiles.discovery.link')}
+          </Button>
+          <Button variant="ghost" disabled={pending} onClick={() => setSelected(null)}>
+            {t('common.cancel')}
+          </Button>
+        </div>
+      ) : null}
+    </section>
+  )
+}
