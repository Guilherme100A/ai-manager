+++ b/tests/acceptance/T005-R4/graph.test.ts
@@ -0,0 +1,37 @@
+﻿import { afterAll, beforeAll, expect, it } from 'vitest'
+import { GraphClient } from '../../../packages/core/src/meta-ads/client/graph'
+import { FakeMetaGraph } from '../../../packages/core/src/meta-ads/client/testing/fake-graph'
+const fake = new FakeMetaGraph({ appSecret: 'r4-synthetic-secret', pageSize: 50 })
+let graph: GraphClient
+beforeAll(async () => {
+  const { url } = await fake.start()
+  fake.addUser({
+    id: 'r4',
+    name: 'Synthetic R4',
+    adAccounts: Array.from({ length: 101 }, (_, i) => ({ id: `act_${3000 + i}`, currency: 'BRL', account_status: 1 })),
+  })
+  graph = new GraphClient({ graphUrl: url, appSecret: 'r4-synthetic-secret', accessToken: fake.issueToken('r4') })
+})
+afterAll(async () => {
+  await fake.close()
+})
+it('the existing Graph client follows page 2 with limit100 and more than100 authorized accounts', async () => {
+  fake.requests.length = 0
+  const items = await graph.getAll<{ id: string }>('me/adaccounts', {
+    fields: 'id,account_id,name,currency,account_status',
+    limit: 100,
+  })
+  expect(items).toHaveLength(101)
+  expect(items.at(-1)?.id).toBe('act_3100')
+  expect(fake.requests).toHaveLength(2)
+  expect(fake.requests[1]?.query.after).toBeTruthy()
+  expect(fake.requests.every((r) => r.method === 'GET' && r.endpoint === '/me/adaccounts')).toBe(true)
+})
+it('a legitimate empty response is successful, while token/scope/provider errors reject', async () => {
+  fake.addUser({ id: 'empty', name: 'Empty', adAccounts: [] })
+  expect(await graph.getAll('me/adaccounts', {}, { accessToken: fake.issueToken('empty') })).toEqual([])
+  for (const code of [190, 200, 2]) {
+    fake.failNext(400, { code, type: 'OAuthException', message: 'Synthetic provider failure' })
+    await expect(graph.getAll('me/adaccounts')).rejects.toMatchObject({ code })
+  }
+})
diff --git a/tests/acceptance/T005-R4/playwright.config.ts b/tests/acceptance/T005-R4/playwright.config.ts
