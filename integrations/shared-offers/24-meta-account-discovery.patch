@@ -0,0 +1,9 @@
+﻿import { defineConfig } from '@playwright/test'
+// This suite deliberately does not inherit the shared DB-backed webServer harness.
+export default defineConfig({
+  testDir: '.',
+  testMatch: 'candidates.e2e.ts',
+  workers: 1,
+  retries: 0,
+  projects: [{ name: 'desktop' }],
+})
