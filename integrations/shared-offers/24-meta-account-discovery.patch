diff --git a/tests/acceptance/T005-R4/browser-discovery.mjs b/tests/acceptance/T005-R4/browser-discovery.mjs
new file mode 100644
index 0000000..d912fe5
--- /dev/null
+++ b/tests/acceptance/T005-R4/browser-discovery.mjs
@@ -0,0 +1,321 @@
+/* global document, location */
+import assert from 'node:assert/strict'
+import { createServer } from 'node:http'
+import { mkdir, writeFile } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import { pathToFileURL } from 'node:url'
+const root = resolve(import.meta.dirname, '../../..'),
+  web = resolve(root, 'apps/web')
+const { build } = await import(pathToFileURL(resolve(web, 'node_modules/vite/dist/node/index.js')))
+const { chromium } = await import(pathToFileURL(resolve(root, 'node_modules/@playwright/test/index.mjs')))
+process.env.VITE_BASE_PATH = '/crm/'
+process.env.VITE_API_BASE = '/crm/api'
+const evidence = resolve(root, 'test-results/T005-R4')
+await mkdir(evidence, { recursive: true })
+const result = await build({
+  root: web,
+  configLoader: 'native',
+  cacheDir: resolve(evidence, 'vite-cache'),
+  build: { write: false, sourcemap: false },
+  logLevel: 'warn',
+})
+const assets = new Map(
+  (Array.isArray(result) ? result : [result])
+    .flatMap((r) => r.output)
+    .map((o) => ['/crm/' + o.fileName, o.type === 'chunk' ? o.code : o.source]),
+)
+const server = createServer((req, res) => {
+  const path = new URL(req.url, 'http://localhost').pathname
+  res.writeHead(200, {
+    'Content-Type': path.endsWith('.js') ? 'text/javascript' : path.endsWith('.css') ? 'text/css' : 'text/html',
+  })
+  res.end(assets.get(path) ?? assets.get('/crm/index.html'))
+})
+await new Promise((r) => server.listen(0, '127.0.0.1', r))
+const origin = `http://127.0.0.1:${server.address().port}`
+const browser = await chromium.launch({ headless: true })
+const page = await browser.newPage({ viewport: { width: 1440, height: 1000 } })
+const company = {
+  id: '11111111-1111-4111-8111-111111111111',
+  name: 'R4 fixture',
+  slug: 'r4',
+  role: 'owner',
+  effective_permissions: ['facebook.profiles', 'profile.view', 'flows.view'],
+}
+const areaA = '22222222-2222-4222-8222-222222222222',
+  areaB = '33333333-3333-4333-8333-333333333333'
+const pid = '44444444-4444-4444-8444-444444444444'
+const auth = {
+  user: {
+    id: '55555555-5555-4555-8555-555555555555',
+    name: 'R4',
+    email: 'r4@example.invalid',
+    locale: 'pt-BR',
+    system_role: 'user',
+    last_company_id: company.id,
+  },
+  companies: [company],
+}
+const profile = {
+  id: pid,
+  fb_user_id: '100',
+  fb_user_name: 'Synthetic profile',
+  active: true,
+  picture_url: null,
+  token_expires_at: null,
+  ad_accounts: [],
+  ad_accounts_count: 0,
+  ad_accounts_included_count: 0,
+}
+const accounts = Array.from({ length: 101 }, (_, i) => ({
+  fb_account_id: 'act_' + (9000000000303n + BigInt(i)).toString(),
+  name: `Authorized ${i + 1}`,
+  currency: 'BRL',
+  account_status: 1,
+}))
+let mode = 'success',
+  links = 0,
+  refreshes = 0,
+  gets = 0,
+  delayResolve,
+  postResolve,
+  postFail = false
+const requests = [],
+  errors = []
+page.on('pageerror', (e) => errors.push(e.message))
+await page.addInitScript(
+  ({ company, areaA }) => {
+    if (!sessionStorage.getItem('crm.business-area.' + company))
+      sessionStorage.setItem('crm.business-area.' + company, areaA)
+  },
+  { company: company.id, areaA },
+)
+await page.route('**/crm/api/**', async (route) => {
+  const request = route.request(),
+    url = new URL(request.url()),
+    path = url.pathname.replace('/crm/api', '')
+  const area = request.headers()['x-business-area-id']
+  requests.push({ path, method: request.method(), area })
+  let body
+  if (path === '/auth/profile') body = auth
+  else if (path === '/business-areas')
+    body = {
+      items: [
+        { id: areaA, slot: 1, name: 'Admin 1', bm_id: null },
+        { id: areaB, slot: 2, name: 'Admin 2', bm_id: null },
+      ],
+    }
+  else if (path === '/meta/profiles')
+    body = {
+      items: [
+        area === areaB
+          ? {
+              ...profile,
+              id: '66666666-6666-4666-8666-666666666666',
+              fb_user_name: 'Other workspace',
+              ad_accounts: [],
+              ad_accounts_count: 0,
+              ad_accounts_included_count: 0,
+            }
+          : profile,
+      ],
+    }
+  else if (path.endsWith('/refresh-ad-accounts')) {
+    refreshes++
+    body = { profile }
+  } else if (path === '/meta/workspace/ad-accounts' && request.method() === 'GET') {
+    gets++
+    assert.equal(url.searchParams.has('profile_id'), true)
+    if (mode === 'late' && area === areaA)
+      await new Promise((r) => {
+        delayResolve = r
+      })
+    if (mode === 'network') return route.abort('failed')
+    if (['token', 'scope', 'failure'].includes(mode))
+      return route.fulfill({
+        status: mode === 'token' ? 409 : 502,
+        json: {
+          error: {
+            code: mode === 'token' ? 'CONFLICT' : 'UPSTREAM_ERROR',
+            message: 'Synthetic provider error',
+            details: { error_code: mode === 'token' ? 'meta_token_invalid' : 'meta_upstream' },
+          },
+        },
+      })
+    body = { items: mode === 'empty' || area === areaB ? [] : accounts, provider_access_verified: true }
+  } else if (path === '/meta/workspace/ad-accounts' && request.method() === 'POST') {
+    links++
+    const input = request.postDataJSON()
+    assert.equal(input.profile_id, pid)
+    assert.equal(input.fb_account_id, accounts.at(-1).fb_account_id)
+    assert.equal(area, areaA)
+    if (postResolve === 'hold')
+      await new Promise((r) => {
+        postResolve = r
+      })
+    if (postFail)
+      return route.fulfill({ status: 409, json: { error: { code: 'CONFLICT', message: 'Synthetic conflict' } } })
+    const account = {
+      ...accounts.at(-1),
+      id: '77777777-7777-4777-8777-777777777777',
+      account_id: accounts.at(-1).fb_account_id.slice(4),
+      included_in_dashboard: true,
+    }
+    profile.ad_accounts = [account]
+    profile.ad_accounts_count = 1
+    profile.ad_accounts_included_count = 1
+    body = { ad_account: account }
+  } else if (path === '/app-config') body = { support_widget: { provider: 'none' } }
+  else if (path.includes('/events'))
+    return route.fulfill({ status: 200, contentType: 'text/event-stream', body: ': fixture\n\n' })
+  else body = { items: [], page: { page: 1, limit: 20, has_more: false }, announcements: [] }
+  await route.fulfill({ json: body })
+})
+page.setDefaultTimeout(15000)
+console.log('Built packaged SPA; starting browser checks')
+const candidates = page.getByTestId('facebook-candidate')
+const refresh = async (wait = true) => {
+  await page.getByTestId(`facebook-profile-refresh-${pid}`).click()
+  if (wait)
+    await page.waitForFunction(
+      (pid) =>
+        !document.querySelector(`[data-testid="facebook-profile-refresh-${pid}"]`)?.disabled &&
+        document.querySelector(`[data-testid="facebook-candidates-${pid}"]`)?.getAttribute('aria-busy') === 'false',
+      pid,
+    )
+}
+try {
+  await page.goto(origin + '/crm/facebook/profiles?meta_oauth=success')
+  await candidates.nth(100).waitFor()
+  await page.waitForTimeout(2700) // settle the existing delayed OAuth reload before failure injection
+  await candidates.nth(100).waitFor()
+  assert.equal(await candidates.count(), 101)
+  assert.equal(links, 0)
+  assert.match(await page.getByTestId(`facebook-profile-count-${pid}`).innerText(), /0/)
+  assert.match(await candidates.nth(100).innerText(), /\*\*\*0403/)
+  assert.match(await candidates.nth(100).innerText(), /BRL/)
+  assert.equal((await page.locator('body').innerText()).includes(accounts.at(-1).fb_account_id), false)
+  await candidates.nth(100).getByRole('button').click()
+  assert.equal(links, 0)
+  postFail = true
+  await page
+    .getByRole('group', { name: 'Confirmar vínculo' })
+    .getByRole('button', { name: 'Vincular', exact: true })
+    .click()
+  await page.getByRole('group').getByRole('alert').waitFor()
+  postFail = false
+  postResolve = 'hold'
+  await page
+    .getByRole('group')
+    .getByRole('button', { name: 'Tentar novamente' })
+    .evaluate((button) => {
+      button.click()
+      button.click()
+    })
+  await page.waitForFunction(() => document.querySelector('[role=group] button')?.disabled)
+  assert.equal(links, 2)
+  while (typeof postResolve !== 'function') await new Promise((r) => setTimeout(r, 10))
+  postResolve()
+  await page.getByTestId('facebook-account-77777777-7777-4777-8777-777777777777').waitFor()
+  assert.equal(await page.getByTestId('facebook-account-toggle-77777777-7777-4777-8777-777777777777').isChecked(), true)
+  await page.reload()
+  await page.getByTestId('facebook-account-77777777-7777-4777-8777-777777777777').waitFor()
+  assert.equal(links, 2)
+  // Successful refresh may still report zero links; candidates must remain visible.
+  profile.ad_accounts = []
+  profile.ad_accounts_count = 0
+  profile.ad_accounts_included_count = 0
+  await refresh()
+  await candidates.nth(100).waitFor()
+  for (const failure of ['token', 'scope', 'failure', 'network']) {
+    mode = failure
+    await refresh()
+    await page.getByTestId(`facebook-candidates-${pid}`).getByRole('alert').waitFor()
+    assert.equal(await page.getByTestId('facebook-candidates-empty').count(), 0)
+    mode = 'success'
+    await page.getByTestId(`facebook-candidates-${pid}`).getByRole('button', { name: 'Tentar novamente' }).click()
+    await candidates.nth(100).waitFor()
+    await page.waitForFunction(
+      (pid) =>
+        document.querySelector(`[data-testid="facebook-candidates-${pid}"]`)?.getAttribute('aria-busy') === 'false',
+      pid,
+    )
+  }
+  mode = 'empty'
+  await refresh()
+  await page.getByTestId('facebook-candidates-empty').waitFor()
+  assert.equal(await page.getByTestId(`facebook-candidates-${pid}`).getByRole('alert').count(), 0)
+  mode = 'success'
+  await refresh()
+  await candidates.nth(100).waitFor()
+  await page.screenshot({ path: resolve(evidence, 'candidates.png') })
+  const paint = await candidates.first().evaluate((el) => {
+    const r = el.getBoundingClientRect()
+    return el.contains(document.elementFromPoint(r.x + 10, r.y + 10))
+  })
+  assert.equal(paint, true)
+  mode = 'late'
+  await refresh(false)
+  while (!delayResolve) await new Promise((r) => setTimeout(r, 10))
+  await page.evaluate(
+    ({ company, areaB }) => {
+      sessionStorage.setItem('crm.business-area.' + company, areaB)
+      location.assign('/crm/facebook/profiles')
+    },
+    { company: company.id, areaB },
+  )
+  // Resolve A only after navigation has selected B; old candidates must never paint in B.
+  delayResolve()
+  await page.waitForLoadState('domcontentloaded')
+  await page.getByText('Other workspace', { exact: true }).waitFor()
+  await page.getByTestId('facebook-candidates-empty').waitFor()
+  assert.equal(await candidates.count(), 0)
+  assert.equal(links, 2)
+  assert.equal(
+    requests.some((r) => /campaign|adset|structure|oauth\/start/.test(r.path)),
+    false,
+  )
+  // Permission checks are still enforced by the server; readers get no linking action.
+  company.role = 'member'
+  mode = 'success'
+  await page.evaluate(
+    ({ company, areaA }) => {
+      sessionStorage.setItem('crm.business-area.' + company, areaA)
+      location.assign('/crm/facebook/profiles')
+    },
+    { company: company.id, areaA },
+  )
+  await candidates.nth(100).waitFor()
+  assert.equal(await candidates.getByRole('button').count(), 0)
+  assert.equal(links, 2)
+  company.role = 'owner'
+  await page.reload()
+  await candidates.nth(100).waitFor()
+  await candidates.nth(100).getByRole('button').click()
+  postResolve = 'hold'
+  await page.getByRole('group').getByRole('button', { name: 'Vincular', exact: true }).click()
+  while (typeof postResolve !== 'function') await new Promise((r) => setTimeout(r, 10))
+  await page.evaluate(
+    ({ company, areaB }) => {
+      sessionStorage.setItem('crm.business-area.' + company, areaB)
+      location.assign('/crm/facebook/profiles')
+    },
+    { company: company.id, areaB },
+  )
+  await page.getByText('Other workspace', { exact: true }).waitFor()
+  postResolve()
+  await page.getByTestId('facebook-candidates-empty').waitFor()
+  assert.equal(await candidates.count(), 0)
+  assert.equal(await page.getByTestId('facebook-account-77777777-7777-4777-8777-777777777777').count(), 0)
+  assert.equal(links, 3)
+  assert.deepEqual(errors, [])
+  await writeFile(
+    resolve(evidence, 'checks.json'),
+    JSON.stringify({ links, refreshes, gets, candidates: 101, requests, errors }, null, 2),
+  )
+  console.log('T005-R4 browser acceptance passed')
+} finally {
+  await browser.close()
+  server.closeAllConnections()
+  await new Promise((r) => server.close(r))
+}
