@@ -0,0 +1,197 @@
+// CRM-003 R1. Disposable PostgreSQL/Redis, synthetic tenants and fake providers only.
+/* eslint-disable @typescript-eslint/no-explicit-any -- acceptance JSON fixtures */
+import { randomUUID } from 'node:crypto'
+import { createServer, type Server } from 'node:http'
+import type { AddressInfo } from 'node:net'
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { FakeXPag } from '../../../packages/core/src/payments/xpag/fake'
+import { chatOf, history, messageFlow, phone, receive, sentTexts, tenant, waitFor, type System, type Tenant } from './setup'
+import { startUpgradeSystem } from './crm003-upgrade-system'
+
+let sys: System, user: Tenant, other: Tenant, readToken: string, writeToken: string
+let legacyPixel: string, legacyIntegration: string, legacyOpportunity: string
+const gateway = new FakeXPag({ clientId: 'crm003-test', clientSecret: 'synthetic-local-only' })
+const old = { gate: process.env.SHARED_OFFERS_COMPANY_ID, xpag: process.env.XPAG_API_URL, public: process.env.API_PUBLIC_URL, spyUrl: process.env.SPY_API_URL, spyToken: process.env.SPY_API_TOKEN, spyCompany: process.env.CRM_SPY_COMPANY_ID }
+// Local fake Spy upstream: the spy bridge is outside CRM-003; this only keeps list_spy_offers reachable.
+let spyServer: Server | undefined
+let sequence = 0
+const removed = ['list_offers', 'get_offer', 'get_offer_resources', 'get_offer_results', 'create_offer', 'update_offer', 'set_offer_connection_mode', 'list_conversation_offer_opportunities', 'adopt_offer_business_area']
+
+async function rpc(token: string, method: string, params: Record<string, unknown> = {}) {
+  const response = await sys.app.request('/api/mcp', { method: 'POST', headers: {
+    authorization: `Bearer ${token}`, 'content-type': 'application/json', accept: 'application/json, text/event-stream', 'mcp-protocol-version': '2025-06-18',
+  }, body: JSON.stringify({ jsonrpc: '2.0', id: ++sequence, method, params }) })
+  return { status: response.status, body: await response.json() as any }
+}
+
+beforeAll(async () => {
+  for (const key of ['DATABASE_URL', 'REDIS_URL']) {
+    const value = process.env[key]
+    if (value && !['localhost', '127.0.0.1', '::1', '[::1]'].includes(new URL(value).hostname) && process.env.CRM003_DISPOSABLE_INFRA !== '1') throw new Error(`${key} must be local, or CRM003_DISPOSABLE_INFRA=1 must explicitly designate an isolated CI service`)
+  }
+  await gateway.start()
+  process.env.XPAG_API_URL = gateway.url
+  process.env.API_PUBLIC_URL = 'http://crm003.invalid'
+  const upgradeSystem = await startUpgradeSystem()
+  sys = upgradeSystem
+  user = await tenant(sys); other = await tenant(sys)
+  process.env.SHARED_OFFERS_COMPANY_ID = user.companyId
+  spyServer = createServer((req, res) => {
+    res.writeHead(req.method === 'GET' ? 200 : 405, { 'content-type': 'application/json' })
+    res.end(req.method === 'GET' ? JSON.stringify({ items: [] }) : '{}')
+  })
+  await new Promise<void>(resolve => spyServer!.listen(0, '127.0.0.1', resolve))
+  process.env.SPY_API_URL = `http://127.0.0.1:${(spyServer.address() as AddressInfo).port}`
+  process.env.SPY_API_TOKEN = 'crm003-fake'
+  process.env.CRM_SPY_COMPANY_ID = user.companyId
+  const reader = await user.c.post('/api/mcp_credentials', { name: 'CRM003 reader', access: 'read' })
+  const writer = await user.c.post('/api/mcp_credentials', { name: 'CRM003 writer', access: 'write' })
+  expect(reader.status).toBe(201); expect(writer.status).toBe(201)
+  readToken = reader.body.token; writeToken = writer.body.token
+  // Historical row, not a newly activated feature: reproduces an already managed chip after upgrade.
+  await sys.q('insert into crm.offer_connections(company_id,connection_id) values($1,$2)', [user.companyId, user.connectionId])
+  const pixel = await user.c.post('/api/meta/pixels', { name: 'CRM003 legacy pixel', pixel_id: '123456789101', access_token: 'EAABsyntheticLegacyToken123456789', auto_send_sales: false })
+  expect(pixel.status, pixel.text).toBe(201); legacyPixel = pixel.body.pixel.id
+  const integration = await user.c.post('/api/payment-integrations', { label: 'CRM003 legacy XPag', gateway: 'xpag', client_id: 'crm003-legacy', client_secret: 'synthetic-old-secret' })
+  expect(integration.status, integration.text).toBe(201); legacyIntegration = integration.body.integration.id
+  const [offer] = await sys.q("insert into crm.offers(company_id,name,config) values($1,'CRM003 historic offer',$2::jsonb) returning id", [user.companyId, JSON.stringify({ pixel_id: legacyPixel, integration_id: legacyIntegration })])
+  const [contact] = await sys.q("insert into crm.contacts(company_id,name) values($1,'CRM003 synthetic historical contact') returning id", [user.companyId])
+  const [chat] = await sys.q('insert into crm.chats(company_id,contact_id,connection_id) values($1,$2,$3) returning id', [user.companyId, contact.id, user.connectionId])
+  const [opportunity] = await sys.q('insert into crm.offer_opportunities(company_id,offer_id,contact_id,chat_id,snapshot,evidence) values($1,$2,$3,$4,$5::jsonb,$6::jsonb) returning id', [user.companyId, offer.id, contact.id, chat.id, JSON.stringify({ pixel_id: legacyPixel, integration_id: legacyIntegration }), '{}'])
+  legacyOpportunity = opportunity.id
+  await expect(sys.q("update crm.pixel_configs set pixel_id='987654321009' where id=$1", [legacyPixel])).rejects.toThrow(/offer_destination_locked/)
+  await expect(sys.q("update crm.payment_integrations set client_id='crm003-rotated-client' where id=$1", [legacyIntegration])).rejects.toThrow(/offer_destination_locked/)
+  await upgradeSystem.upgrade()
+  // The actual 0049 must preserve the row, install its guard, and be idempotent.
+  await upgradeSystem.upgrade()
+  expect(await sys.q('select connection_id from crm.offer_connections where company_id=$1', [user.companyId])).toEqual([{ connection_id: user.connectionId }])
+  await expect(sys.q('update crm.offer_connections set connection_id=connection_id where company_id=$1', [user.companyId])).rejects.toThrow(/offer_legacy_frozen/)
+  expect(await sys.q('select connection_id from crm.offer_connections where company_id=$1', [user.companyId])).toEqual([{ connection_id: user.connectionId }])
+}, 180_000)
+
+afterAll(async () => {
+  await sys?.close(); await gateway.stop()
+  if (spyServer) await new Promise<void>(resolve => spyServer!.close(() => resolve()))
+  for (const [key, value] of Object.entries({ SHARED_OFFERS_COMPANY_ID: old.gate, XPAG_API_URL: old.xpag, API_PUBLIC_URL: old.public, SPY_API_URL: old.spyUrl, SPY_API_TOKEN: old.spyToken, CRM_SPY_COMPANY_ID: old.spyCompany })) {
+    if (value === undefined) delete process.env[key]; else process.env[key] = value
+  }
+}, 120_000)
+
+it('removes commercial offer tools and calls while keeping areas and spy', async () => {
+  for (const token of [readToken, writeToken]) {
+    const listing = await rpc(token, 'tools/list')
+    expect(listing.status).toBe(200)
+    const names: string[] = listing.body.result.tools.map((tool: any) => tool.name)
+    for (const name of removed) expect(names, name).not.toContain(name)
+    expect(names).toContain('list_business_areas')
+    expect(names).toContain('list_spy_offers')
+    for (const name of removed) {
+      const result = await rpc(token, 'tools/call', { name, arguments: {} })
+      expect(Boolean(result.body.error || result.body.result?.isError), name).toBe(true)
+    }
+    expect((await rpc(token, 'tools/call', { name: 'list_business_areas', arguments: {} })).body.result?.isError).not.toBe(true)
+    expect((await rpc(token, 'tools/call', { name: 'list_spy_offers', arguments: {} })).body.result?.isError).not.toBe(true)
+  }
+})
+
+it('returns 404 for legacy API even with an authenticated enabled tenant', async () => {
+  for (const path of ['/api/offers', '/api/offers/resources', `/api/offers/${randomUUID()}`]) {
+    expect((await user.c.get(path)).status, path).toBe(404)
+    expect((await other.c.get(path)).status, path).toBe(404)
+  }
+})
+
+it('an inbound keyword on the previously managed chip triggers the ordinary flow', async () => {
+  const marker = `CRM003 keyword ${randomUUID()}`
+  const flow = await messageFlow(user, marker)
+  const config = await user.c.put(`/api/connection-flow-configs/${user.connectionId}`, { keyword_triggers: [{ flow_id: flow, conditions: [{ keyword: 'crm003', match_type: 'equals' }] }] })
+  expect(config.status, config.text).toBe(200)
+  const lead = phone(); await receive(sys, user, lead, 'crm003')
+  const chat = await chatOf(sys, user, lead)
+  await waitFor(async () => (await sentTexts(sys, user)).includes(marker), 45000, 'keyword response delivered to fake transport')
+  const persisted = await waitFor(async () => (await history(user, chat)).find((m: any) => (m.body ?? m.text) === marker), 20000, 'keyword response persisted')
+  expect(persisted.sender_type).toBe('flow')
+})
+
+it('runs a normal message and fake payment-to-sale flow on an originally managed chip without an opportunity', async () => {
+  const integration = await user.c.post('/api/payment-integrations', { label: 'CRM003 fake', gateway: 'xpag', client_id: 'crm003-test', client_secret: 'synthetic-local-only' })
+  expect(integration.status, integration.text).toBe(201)
+  const product = await user.c.post('/api/products', { name: 'CRM003 synthetic', currency: 'MXN', price_min_cents: 1, price_max_cents: 100000, price_fallback_cents: 12345 })
+  expect(product.status, product.text).toBe(201)
+  const flow = await user.c.post('/api/flows', { name: 'CRM003 ordinary flow' })
+  expect(flow.status, flow.text).toBe(201)
+  const id = flow.body.flow.id
+  const node = (id: string, type: string, action?: string, config?: object) => ({ id, type, name: id, position: { x: 0, y: 0 }, actions: action ? [{ id: `a-${id}`, type: action, order: 0, config }] : [] })
+  const edge = (from: string, handle: string, to: string) => ({ id: `${from}-${to}`, from, handle, to })
+  const marker = `CRM003 message ${randomUUID()}`
+  const definition = { schema: 'crm.flow/v1', entry: 'start', nodes: [
+    node('start', 'start'), node('message', 'message', 'send_message', { message_text: marker }),
+    node('payment', 'payment', 'create_payment_charge', { gateway: 'xpag', payment_integration_id: integration.body.integration.id, currency: 'MXN', method: 'SPEI', amount: '123.45', listener_ttl_value: 1, listener_ttl_unit: 'hours' }),
+    node('sale', 'approved_sale', 'register_approved_sale', { product_public_id: product.body.product.public_id, amount_template: '{gateway.value}', currency_template: 'MXN' }),
+  ], edges: [edge('start', 'source', 'message'), edge('message', 'source', 'payment'), edge('payment', 'output:payment_approved', 'sale')], variables: [], refs: {} }
+  const saved = await user.c.put(`/api/flows/${id}/definition`, definition)
+  expect(saved.status, saved.text).toBe(200)
+  const active = await user.c.post(`/api/flows/${id}/activate`, {})
+  expect(active.status, active.text).toBe(200)
+  const lead = phone(); await receive(sys, user, lead, 'CRM003 synthetic inbound')
+  const chat = await chatOf(sys, user, lead)
+  const triggered = await user.c.post(`/api/flows/${id}/trigger`, { chat_id: chat })
+  expect(triggered.status, triggered.text).toBeLessThan(300)
+  await waitFor(async () => (await sentTexts(sys, user)).includes(marker), 45000, 'fake transport delivered message')
+  const charge = await waitFor(async () => (await sys.q('select * from crm.payment_charges where company_id=$1', [user.companyId]))[0], 45000, 'fake charge persisted')
+  expect(charge.opportunity_id).toBeNull()
+  expect(Number(charge.amount_cents)).toBe(12345)
+  const hook = gateway.webhookFor(charge.transaction_id, { amount: 123.45 }); const url = new URL(hook.url!)
+  expect((await sys.app.request(url.pathname + url.search, { method: 'POST', headers: hook.headers, body: hook.rawBody })).status).toBe(202)
+  const sale = await waitFor(async () => (await sys.q('select * from crm.sales where company_id=$1', [user.companyId]))[0], 45000, 'approved sale persisted')
+  expect(sale).toMatchObject({ status: 'approved', currency: 'MXN', opportunity_id: null })
+  expect(Number(sale.amount_cents)).toBe(12345)
+  expect(await sys.q('select id from crm.sales where company_id=$1', [other.companyId])).toHaveLength(0)
+  expect((await sentTexts(sys, user)).filter(text => text === marker)).toHaveLength(1)
+})
+
+it('A5 allows editing, rotating and deleting historic pixel and XPag resources after upgrade', async () => {
+  const [pixelBefore] = await sys.q('select access_token_enc from crm.pixel_configs where id=$1', [legacyPixel])
+  const [paymentBefore] = await sys.q('select client_secret_enc from crm.payment_integrations where id=$1', [legacyIntegration])
+  const pixelUpdate = await user.c.put(`/api/meta/pixels/${legacyPixel}`, { name: 'CRM003 edited pixel', pixel_id: '987654321009', access_token: 'EAABsyntheticRotatedToken987654321' })
+  expect(pixelUpdate.status, pixelUpdate.text).toBe(200)
+  const pixelRead = await user.c.get(`/api/meta/pixels/${legacyPixel}`)
+  expect(pixelRead.status).toBe(200)
+  expect(pixelRead.body.pixel).toMatchObject({ name: 'CRM003 edited pixel' })
+  const paymentUpdate = await user.c.put(`/api/payment-integrations/${legacyIntegration}`, { label: 'CRM003 edited XPag', client_id: 'crm003-rotated-client', client_secret: 'synthetic-rotated-secret' })
+  expect(paymentUpdate.status, paymentUpdate.text).toBe(200)
+  const paymentRead = await user.c.get(`/api/payment-integrations/${legacyIntegration}`)
+  expect(paymentRead.status).toBe(200)
+  expect(paymentRead.body.integration).toMatchObject({ label: 'CRM003 edited XPag', client_id: 'crm003-rotated-client' })
+  const [pixelAfter] = await sys.q('select pixel_id, access_token_enc from crm.pixel_configs where id=$1', [legacyPixel])
+  const [paymentAfter] = await sys.q('select client_secret_enc from crm.payment_integrations where id=$1', [legacyIntegration])
+  expect(pixelAfter.access_token_enc).not.toBe(pixelBefore.access_token_enc)
+  expect(pixelAfter.pixel_id).toBe('987654321009')
+  expect(paymentAfter.client_secret_enc).not.toBe(paymentBefore.client_secret_enc)
+  expect((await user.c.delete(`/api/meta/pixels/${legacyPixel}`)).status).toBe(204)
+  expect((await user.c.delete(`/api/payment-integrations/${legacyIntegration}`)).status).toBe(200)
+  expect((await user.c.get(`/api/meta/pixels/${legacyPixel}`)).status).toBe(404)
+  expect((await user.c.get(`/api/payment-integrations/${legacyIntegration}`)).status).toBe(404)
+  const history = await sys.q('select snapshot from crm.offer_opportunities where id=$1', [legacyOpportunity])
+  expect(history).toEqual([{ snapshot: { pixel_id: legacyPixel, integration_id: legacyIntegration } }])
+})
+
+it('keeps private flows isolated between workspaces after removal of offers', async () => {
+  const initialized = await user.c.post('/api/business-areas/initialize', {})
+  expect(initialized.status, initialized.text).toBe(201)
+  const areas = initialized.body.items
+  expect(areas.map((area: any) => area.slot)).toEqual([1, 2, 3])
+  const a = { 'x-business-area-id': areas[0].id }, b = { 'x-business-area-id': areas[1].id }
+  const created = await user.c.post('/api/flows', { name: 'CRM003 private synthetic flow' }, a)
+  expect(created.status, created.text).toBe(201)
+  const id = created.body.flow.id
+  expect((await user.c.get(`/api/flows/${id}`, a)).status).toBe(200)
+  expect((await user.c.get(`/api/flows/${id}`, b)).status).toBe(404)
+  expect((await other.c.get(`/api/flows/${id}`)).status).toBe(404)
+  const list = await rpc(readToken, 'tools/call', { name: 'list_flows', arguments: { business_area_id: areas[1].id } })
+  expect(list.body.error).toBeUndefined()
+  expect(list.body.result?.isError).not.toBe(true)
+  const data = JSON.parse(list.body.result.content[0].text)
+  expect(data.flows.map((flow: any) => flow.id)).not.toContain(id)
+  expect((await user.c.get(`/api/flows/${id}`, a)).status).toBe(200)
+})
diff --git a/tests/acceptance/T125/crm003-upgrade-system.ts b/tests/acceptance/T125/crm003-upgrade-system.ts
