+  expect(triggered.status, triggered.text).toBeLessThan(300)
+  await waitFor(async () => (await sentTexts(sys, user)).includes(marker), 45000, 'fake transport delivered message')
+  const charge = await waitFor(async () => (await sys.q('select * from crm.payment_charges where company_id=$1', [user.companyId]))[0], 45000, 'fake charge persisted')
+  expect(charge.opportunity_id).toBeNull()
+  expect(Number(charge.amount_cents)).toBe(12345)
+  const hook = gateway.webhookFor(charge.transaction_id, { amount: 123.45 }); const url = new URL(hook.url!)
+  expect((await sys.app.request(url.pathname + url.search, { method: 'POST', headers: hook.headers, body: hook.rawBody })).status).toBe(202)
+  const sale = await waitFor(async () => (await sys.q('select * from crm.sales where company_id=$1', [user.companyId]))[0], 45000, 'approved sale persisted')
