+// Build with VITE_BASE_PATH=/crm/ and VITE_API_BASE=/crm/api; use a disposable CI database and fake providers.
+// Browser against the built checkout and isolated in-process API, never a published server.
+/* eslint-disable @typescript-eslint/no-explicit-any -- HTTP adapter and server address */
+import { createServer, type Server } from 'node:http'
+import { existsSync, readFileSync, statSync } from 'node:fs'
+import { extname, resolve, sep } from 'node:path'
+import { chromium, type Browser } from '@playwright/test'
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { startSystem, tenant, type System, type Tenant } from './setup'
+
+let sys: System, user: Tenant, browser: Browser, server: Server, base: string
+const oldGate = process.env.SHARED_OFFERS_COMPANY_ID
+beforeAll(async () => {
+  for (const key of ['DATABASE_URL', 'REDIS_URL']) {
+    const value = process.env[key]
+    if (value && !['localhost', '127.0.0.1', '::1', '[::1]'].includes(new URL(value).hostname) && process.env.CRM003_DISPOSABLE_INFRA !== '1') throw new Error(`${key} must be local, or CRM003_DISPOSABLE_INFRA=1 must explicitly designate an isolated CI service`)
+  }
+  const root = resolve(process.env.CRM_EMBEDDED_DIST ?? 'apps/web/dist')
+  if (!existsSync(resolve(root, 'index.html'))) throw new Error('Build the web checkout first and set CRM_EMBEDDED_DIST to its dist')
+  sys = await startSystem(); user = await tenant(sys); process.env.SHARED_OFFERS_COMPANY_ID = user.companyId
+  server = createServer(async (req, res) => {
+    try {
+      const pathname = new URL(req.url!, 'http://localhost').pathname
+      if (pathname.startsWith('/crm/api/')) {
+        const chunks: Buffer[] = []; for await (const chunk of req) chunks.push(Buffer.from(chunk))
+        const abort = new AbortController(); res.on('close', () => abort.abort())
+        const response = await sys.app.request(req.url!.slice(4), { method: req.method, headers: req.headers as any, signal: abort.signal, ...(!['GET', 'HEAD'].includes(req.method!) ? { body: Buffer.concat(chunks) } : {}) })
+        res.writeHead(response.status, Object.fromEntries(response.headers.entries()))
+        if (response.headers.get('content-type')?.includes('text/event-stream')) {
+          const reader = response.body!.getReader(); res.on('close', () => void reader.cancel().catch(() => {}))
+          for (;;) { const item = await reader.read(); if (item.done) break; res.write(Buffer.from(item.value)) }
+          res.end(); return
+        }
+        res.end(Buffer.from(await response.arrayBuffer())); return
+      }
+      const asset = resolve(root, '.' + pathname.replace(/^\/crm/, ''))
+      const file = asset.startsWith(root + sep) && existsSync(asset) && statSync(asset).isFile() ? asset : resolve(root, 'index.html')
+      const mime: Record<string, string> = { '.js': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml', '.woff2': 'font/woff2', '.png': 'image/png' }
+      res.setHeader('content-type', mime[extname(file)] ?? 'text/html'); res.end(readFileSync(file))
+    } catch { if (!res.headersSent) res.statusCode = 500; res.end() }
+  })
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve))
+  base = `http://127.0.0.1:${(server.address() as any).port}`
+  browser = await chromium.launch({ headless: true })
+}, 180000)
+afterAll(async () => {
+  await browser?.close()
+  if (server) { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())) }
+  await sys?.close()
+  if (oldGate === undefined) delete process.env.SHARED_OFFERS_COMPANY_ID; else process.env.SHARED_OFFERS_COMPANY_ID = oldGate
+}, 120000)
+
+it.each([1440, 390])('direct authenticated legacy URL is not found and navigation hides offers at %i px', async width => {
+  const context = await browser.newContext({ viewport: { width, height: 900 }, locale: 'pt-BR' })
+  try {
+    await context.addCookies([{ name: 'crm_session', value: user.token, url: base, httpOnly: true, sameSite: 'Lax' }])
+    const page = await context.newPage()
+    await page.goto(base + '/crm/flows')
+    await expect.poll(async () => (await page.getByTestId('workspace-entry').count()) + (await page.getByTestId('page-flows').count()), { timeout: 20000 }).toBeGreaterThan(0)
+    await page.goto(base + '/crm/offers')
+    await expect.poll(async () => page.getByRole('heading', { name: /Página não encontrada|Page not found/i }).count(), { timeout: 20000 }).toBe(1)
+    expect(new URL(page.url()).pathname).toBe('/crm/offers')
+    await page.reload()
+    await expect.poll(async () => page.getByRole('heading', { name: /Página não encontrada|Page not found/i }).count(), { timeout: 20000 }).toBe(1)
+    await page.goto(base + '/crm/flows')
+    await expect.poll(async () => (await page.getByTestId('workspace-entry').count()) + (await page.getByTestId('page-flows').count()), { timeout: 20000 }).toBeGreaterThan(0)
+    expect(await page.getByTestId('nav-item-offers').count()).toBe(0)
+    expect(await page.getByRole('link', { name: /^ofertas$/i }).count()).toBe(0)
+  } finally { await context.close() }
+})
