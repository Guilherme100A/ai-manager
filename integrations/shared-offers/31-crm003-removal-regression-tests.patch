+    node('sale', 'approved_sale', 'register_approved_sale', { product_public_id: product.body.product.public_id, amount_template: '{gateway.value}', currency_template: 'MXN' }),
+  ], edges: [edge('start', 'source', 'message'), edge('message', 'source', 'payment'), edge('payment', 'output:payment_approved', 'sale')], variables: [], refs: {} }
+  const saved = await user.c.put(`/api/flows/${id}/definition`, definition)
