+  process.env.SPY_API_URL = `http://127.0.0.1:${(spyServer.address() as AddressInfo).port}`
+  process.env.SPY_API_TOKEN = 'crm003-fake'
+  process.env.CRM_SPY_COMPANY_ID = user.companyId
+  const reader = await user.c.post('/api/mcp_credentials', { name: 'CRM003 reader', access: 'read' })
+  const writer = await user.c.post('/api/mcp_credentials', { name: 'CRM003 writer', access: 'write' })
+  expect(reader.status).toBe(201); expect(writer.status).toBe(201)
