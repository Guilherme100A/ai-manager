+import { randomUUID } from 'node:crypto'
+import { eq } from 'drizzle-orm'
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest'
+import { auditLogs, connections, createDb, type Database } from '@crm/db'
+import { createTempDatabase, type TempDatabase } from '@crm/db/testing'
+import { createLogger, MemoryMailer, redisConnection } from '@crm/node-kit'
+import { FakeWaGateway } from '@crm/wa-port/testing'
+import { createApp, type RedisClient } from '../../app'
+
+type Session = { cookie: string; companyId: string }
+type RpcResponse = {
+  error?: { code: number; message: string }
+  result?: { isError?: boolean; content?: { text: string }[]; tools?: { name: string }[] }
+}
+
+const headers = { 'content-type': 'application/json', 'x-requested-with': 'crm' }
+const upstreamUrl = 'http://wsm.example.test'
+const upstreamToken = 'wsm-bridge-token-test'
+const offerId = randomUUID()
+const sessionId = randomUUID()
+const probeId = randomUUID()
+const startArgs = { offer_id: offerId, session_id: sessionId, branch: 'objecao', start_in_minutes: 25 }
+
+
+
+
+let temp: TempDatabase
+let db: Database
+let redis: RedisClient
+let app: ReturnType<typeof createApp>
+let owner: Session
+let other: Session
+let requestId = 0
+const upstream = vi.fn(async (_url: string, _init?: RequestInit) => new Response(null, { status: 500 }))
+
+async function signUp(index: number): Promise<Session> {
+  const email = `spy-${randomUUID()}@example.test`
+  const ip = { 'x-forwarded-for': `10.97.0.${index}` }
+  const password = '12345678'
+  const registered = await app.request('/api/auth/register', {
+    method: 'POST', headers: { ...headers, ...ip },
+    body: JSON.stringify({ name: 'Spy owner', email, password, password_confirmation: password }),
+  })
+  expect(registered.status).toBe(201)
+  const { user } = await registered.json() as { user: { last_company_id: string } }
+  const loggedIn = await app.request('/api/auth/login', {
+    method: 'POST', headers: { ...headers, ...ip }, body: JSON.stringify({ email, password }),
+  })
+  expect(loggedIn.status).toBe(200)
+  const cookie = /crm_session=[^;]+/.exec(loggedIn.headers.get('set-cookie') ?? '')
+  expect(cookie).not.toBeNull()
+  return { cookie: cookie![0], companyId: user.last_company_id }
+}
+
+function bridge(s: Session, method: string, path: string, body?: string) {
+  return app.request(path, { method, headers: { ...headers, cookie: s.cookie }, ...(body === undefined ? {} : { body }) })
+}
+
+async function credential(s: Session, access: 'read' | 'write') {
+  const res = await app.request('/api/mcp_credentials', {
+    method: 'POST', headers: { ...headers, cookie: s.cookie }, body: JSON.stringify({ name: `spy-${access}`, access }),
+  })
+  expect(res.status).toBe(201)
+  return await res.json() as { token: string; mcp_credential: { id: string } }
+}
+
+async function rpc(token: string, method: string, params: unknown = {}) {
+  const res = await app.request('/api/mcp', {
+    method: 'POST',
+    headers: {
+      'content-type': 'application/json', accept: 'application/json, text/event-stream',
+      'mcp-protocol-version': '2025-06-18', authorization: `Bearer ${token}`,
+    },
+    body: JSON.stringify({ jsonrpc: '2.0', id: ++requestId, method, params }),
+  })
+  expect(res.status).toBe(200)
+  return await res.json() as RpcResponse
+}
+
+const invoke = (token: string, name: string, args: unknown) => rpc(token, 'tools/call', { name, arguments: args })
+const content = (response: RpcResponse): unknown => JSON.parse(response.result!.content![0]!.text)
+const failed = (response: RpcResponse) => Boolean(response.error || response.result?.isError)
+
+beforeAll(async () => {
+  temp = await createTempDatabase({ migrate: true })
+  db = createDb(temp.url, { max: 8 })
+  redis = redisConnection({ url: process.env.REDIS_URL ?? 'redis://127.0.0.1:6379/1' })
+  app = createApp({
+    db, redis, waGateway: new FakeWaGateway(), waProfile: 'ai-manager', mailer: new MemoryMailer(),
+    trustProxy: true, logger: createLogger({ level: 'silent' }), mcpEnv: { API_PUBLIC_URL: 'https://api.example.test' },
+  })
+  owner = await signUp(1)
+  other = await signUp(2)
+}, 120000)
+
+beforeEach(() => {
+  vi.stubEnv('CRM_SPY_COMPANY_ID', owner.companyId)
+  vi.stubEnv('SPY_API_URL', upstreamUrl)
+  vi.stubEnv('SPY_API_TOKEN', upstreamToken)
+  upstream.mockReset()
+  vi.stubGlobal('fetch', upstream)
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  vi.unstubAllEnvs()
+})
+
+afterAll(async () => {
+  redis?.disconnect()
+  await db?.$client.end()
+  await temp?.drop()
+})
+
+const captureId = randomUUID()
+const fixtureLink = 'https://api.whatsapp.com/send/?phone=5511999900011&token=SANITIZED_LINK_TOKEN&utm_source=fixture'
+const capture = (status = 'na_fila', found: string | null = null) => ({ capture_id: captureId, status, offer_id: found,
+  attempts: status === 'na_fila' ? 0 : 1, retry_at: null, reason: null, offer_ids: found ? [found] : [],
+  capture_only: true, manual_start_required: true, requires_offer_choice: false, finished: Boolean(found), children: [], skipped_existing: 0 })
+
+describe('MCP link capture before explicit probe start', () => {
+  it('registers, reuses and polls to offer_id without sending; only explicit chip start reaches fake transport', async () => {
+    const { token } = await credential(owner, 'write')
+    const transport = vi.fn(async (_chip: string) => undefined)
+    let registrations = 0, polls = 0
+    const calls: string[] = []
+    upstream.mockImplementation(async (url, init) => {
+      calls.push(url)
+      if (url.endsWith('/api/spy/captures')) {
+        expect(JSON.parse(String(init?.body))).toEqual({ url: fixtureLink })
+        expect(init?.method).toBe('POST')
+        return Response.json({ ...capture(), created: registrations++ === 0, private: upstreamToken }, { status: registrations === 1 ? 201 : 200 })
+      }
+      if (url.endsWith('/api/spy/captures/' + captureId)) return Response.json(++polls === 1 ? capture('lendo') : capture('achado', offerId))
+      if (url.endsWith('/api/spy/chips')) return Response.json({ items: [
+        { session_id: randomUUID(), name: 'Other chip', phone: null, status: 'STABLE', sendable: true },
+        { session_id: sessionId, name: 'Chosen chip', phone: null, status: 'STABLE', sendable: true },
+      ] })
+      if (url.endsWith(`/api/spy/offers/${offerId}/probes`)) {
+        const body = JSON.parse(String(init?.body))
+        expect(body.sessionId).toBe(sessionId)
+        await transport(body.sessionId)
+        return Response.json({ id: probeId, offerId, sessionId, branch: 'objecao', status: 'ativa' }, { status: 201 })
+      }
+      if (url.endsWith(`/api/spy/probes/${probeId}/stop`)) return Response.json({ id: probeId, offerId, sessionId, branch: 'objecao', status: 'parada' })
+      throw new Error('Unexpected fake upstream operation')
+    })
+    const first = content(await invoke(token, 'capture_spy_offer', { url: fixtureLink }))
+    expect(first).toMatchObject({ capture_id: captureId, created: true, offer_id: null, capture_only: true })
+    expect(content(await invoke(token, 'capture_spy_offer', { url: fixtureLink }))).toMatchObject({ capture_id: captureId, created: false })
+    expect(content(await invoke(token, 'get_spy_capture', { capture_id: captureId }))).toMatchObject({ status: 'lendo', offer_id: null })
+    expect(content(await invoke(token, 'get_spy_capture', { capture_id: captureId }))).toMatchObject({ status: 'achado', offer_id: offerId, finished: true })
+    await invoke(token, 'list_spy_chips', {})
+    expect(transport).not.toHaveBeenCalled()
+    expect(calls.some(url => url.endsWith('/probes'))).toBe(false)
+    expect(failed(await invoke(token, 'start_spy_probe', { offer_id: offerId }))).toBe(true)
+    expect(transport).not.toHaveBeenCalled()
+    expect(content(await invoke(token, 'start_spy_probe', startArgs))).toMatchObject({ id: probeId, sessionId })
+    expect(transport).toHaveBeenCalledExactlyOnceWith(sessionId)
+    expect(content(await invoke(token, 'stop_spy_probe', { id: probeId }))).toMatchObject({ status: 'parada' })
+    expect(await db.select().from(connections).where(eq(connections.companyId, owner.companyId))).toEqual([])
+    const audits = await db.select().from(auditLogs).where(eq(auditLogs.companyId, owner.companyId))
+    expect(audits.some(a => a.action === 'spy.capture.create')).toBe(true)
+    expect(JSON.stringify([first, audits])).not.toContain('SANITIZED_LINK_TOKEN')
+    expect(JSON.stringify([first, audits])).not.toContain(upstreamToken)
+  })
+
+  it('read credential can poll but cannot register; another company cannot access either operation', async () => {
+    const read = await credential(owner, 'read'), foreign = await credential(other, 'write')
+    upstream.mockResolvedValueOnce(Response.json(capture('lendo')))
+    expect(content(await invoke(read.token, 'get_spy_capture', { capture_id: captureId }))).toMatchObject({ status: 'lendo' })
+    upstream.mockClear()
+    expect(failed(await invoke(read.token, 'capture_spy_offer', { url: fixtureLink }))).toBe(true)
+    for (const [name, args] of [['capture_spy_offer', { url: fixtureLink }], ['get_spy_capture', { capture_id: captureId }]] as const) {
+      expect(content(await invoke(foreign.token, name, args))).toMatchObject({ status: 403 })
+    }
+    expect(upstream).not.toHaveBeenCalled()
+  })
+
+  it('validates URL/host, methods and strict capture body before upstream', async () => {
+    for (const url of ['not a URL', 'https://evil.test/?next=https://wa.me/5511999900011', 'https://user:SANITIZED_LINK_TOKEN@facebook.com/page/posts/1'])
+      expect((await bridge(owner, 'POST', '/api/spy-bridge/capture_offer', JSON.stringify({ url }))).status).toBe(422)
+    expect((await bridge(owner, 'POST', '/api/spy-bridge/capture_offer', JSON.stringify({ url: fixtureLink, sessionId, autoProbe: true }))).status).toBe(422)
+    expect((await bridge(owner, 'GET', '/api/spy-bridge/capture_offer')).status).toBe(404)
+    expect((await bridge(owner, 'GET', '/api/spy-bridge/capture_status?id=bad')).status).toBe(422)
+    expect(upstream).not.toHaveBeenCalled()
+  })
+
+  it('rejects unsafe or mismatched capture responses and returns safe not-found/legacy conflicts', async () => {
+    const { token } = await credential(owner, 'write')
+    upstream.mockResolvedValueOnce(Response.json({ ...capture(), capture_only: false }))
+    upstream.mockResolvedValueOnce(Response.json({ ...capture(), capture_id: randomUUID() }))
+    upstream.mockResolvedValueOnce(Response.json({ private: upstreamToken }, { status: 404 }))
+    upstream.mockResolvedValueOnce(Response.json({ private: upstreamToken }, { status: 409 }))
+    expect(content(await invoke(token, 'capture_spy_offer', { url: fixtureLink }))).toMatchObject({ status: 502 })
+    expect(content(await invoke(token, 'get_spy_capture', { capture_id: captureId }))).toMatchObject({ status: 502 })
+    expect(content(await invoke(token, 'get_spy_capture', { capture_id: captureId }))).toMatchObject({ status: 404 })
+    const result = await invoke(token, 'capture_spy_offer', { url: fixtureLink })
+    expect(content(result)).toMatchObject({ status: 409 })
+    expect(JSON.stringify(result)).not.toContain(upstreamToken)
+    expect(upstream).toHaveBeenCalledTimes(4)
+  })
+})
