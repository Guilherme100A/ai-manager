+
+async function connectSpy(
+  access: McpApiContext['access'],
+  perms: McpApiContext['perms'],
+  reply: McpApiResponse = { status: 200, body: {} },
+) {
+  const request = vi.fn<McpApi['request']>().mockResolvedValue(reply)
+  const server = new McpServer({ name: 'spy-test', version: '1' })
+  registerApiTools(server, { api: { request }, access, perms, businessAreasAdmin: true }, spyTools)
+  const client = new Client({ name: 'spy-client', version: '1' })
+  const [serverTransport, clientTransport] = InMemoryTransport.createLinkedPair()
+  await Promise.all([server.connect(serverTransport), client.connect(clientTransport)])
+  onTestFinished(async () => {
+    await client.close()
+    await server.close()
+  })
+  const call = (name: string, args: Record<string, unknown> = {}) => client.callTool({ name, arguments: args })
+  return { client, request, call }
+}
