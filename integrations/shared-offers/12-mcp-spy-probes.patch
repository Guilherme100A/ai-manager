+    expect((await bridge(owner, 'POST', '/api/spy-bridge/start_probe?id=' + '-'.repeat(36), JSON.stringify({ sessionId }))).status).toBe(422)
+    expect((await bridge(owner, 'POST', '/api/spy-bridge/stop_probe?id=bad-id', '{}')).status).toBe(422)
+    for (const invalid of [
+      {}, { sessionId: 'bad-id' }, { sessionId, branch: 'other' }, { sessionId, startInMinutes: -1 },
