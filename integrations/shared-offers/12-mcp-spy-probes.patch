+import { randomUUID } from 'node:crypto'
+import { eq } from 'drizzle-orm'
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest'
+import { auditLogs, connections, createDb, type Database } from '@crm/db'
+import { createTempDatabase, type TempDatabase } from '@crm/db/testing'
+import { createLogger, MemoryMailer, redisConnection } from '@crm/node-kit'
+import { FakeWaGateway } from '@crm/wa-port/testing'
+import { createApp, type RedisClient } from '../../app'
+
+type Session = { cookie: string; companyId: string }
+type RpcResponse = {
+  error?: { code: number; message: string }
+  result?: { isError?: boolean; content?: { text: string }[]; tools?: { name: string }[] }
+}
+
+const headers = { 'content-type': 'application/json', 'x-requested-with': 'crm' }
+const upstreamUrl = 'http://wsm.example.test'
+const upstreamToken = 'wsm-bridge-token-test'
+const offerId = randomUUID()
+const sessionId = randomUUID()
+const probeId = randomUUID()
+const startArgs = { offer_id: offerId, session_id: sessionId, branch: 'objecao', start_in_minutes: 25 }
+const startPath = `/api/spy-bridge/start_probe?id=${offerId}`
+const stopPath = `/api/spy-bridge/stop_probe?id=${probeId}`
+const chipsPath = '/api/spy-bridge/chips'
+
+let temp: TempDatabase
+let db: Database
+let redis: RedisClient
+let app: ReturnType<typeof createApp>
+let owner: Session
+let other: Session
+let requestId = 0
+const upstream = vi.fn(async (_url: string, _init?: RequestInit) => new Response(null, { status: 500 }))
+
+async function signUp(index: number): Promise<Session> {
+  const email = `spy-${randomUUID()}@example.test`
+  const ip = { 'x-forwarded-for': `10.96.0.${index}` }
+  const password = '12345678'
+  const registered = await app.request('/api/auth/register', {
+    method: 'POST', headers: { ...headers, ...ip },
+    body: JSON.stringify({ name: 'Spy owner', email, password, password_confirmation: password }),
+  })
+  expect(registered.status).toBe(201)
+  const { user } = await registered.json() as { user: { last_company_id: string } }
+  const loggedIn = await app.request('/api/auth/login', {
+    method: 'POST', headers: { ...headers, ...ip }, body: JSON.stringify({ email, password }),
+  })
+  expect(loggedIn.status).toBe(200)
+  const cookie = /crm_session=[^;]+/.exec(loggedIn.headers.get('set-cookie') ?? '')
+  expect(cookie).not.toBeNull()
+  return { cookie: cookie![0], companyId: user.last_company_id }
+}
+
+function bridge(s: Session, method: string, path: string, body?: string) {
+  return app.request(path, { method, headers: { ...headers, cookie: s.cookie }, ...(body === undefined ? {} : { body }) })
+}
+
+async function credential(s: Session, access: 'read' | 'write') {
+  const res = await app.request('/api/mcp_credentials', {
+    method: 'POST', headers: { ...headers, cookie: s.cookie }, body: JSON.stringify({ name: `spy-${access}`, access }),
+  })
+  expect(res.status).toBe(201)
+  return await res.json() as { token: string; mcp_credential: { id: string } }
+}
+
+async function rpc(token: string, method: string, params: unknown = {}) {
+  const res = await app.request('/api/mcp', {
+    method: 'POST',
+    headers: {
+      'content-type': 'application/json', accept: 'application/json, text/event-stream',
+      'mcp-protocol-version': '2025-06-18', authorization: `Bearer ${token}`,
+    },
+    body: JSON.stringify({ jsonrpc: '2.0', id: ++requestId, method, params }),
+  })
+  expect(res.status).toBe(200)
+  return await res.json() as RpcResponse
+}
+
+const invoke = (token: string, name: string, args: unknown) => rpc(token, 'tools/call', { name, arguments: args })
+const content = (response: RpcResponse): unknown => JSON.parse(response.result!.content![0]!.text)
+const failed = (response: RpcResponse) => Boolean(response.error || response.result?.isError)
+
+beforeAll(async () => {
+  temp = await createTempDatabase({ migrate: true })
+  db = createDb(temp.url, { max: 8 })
+  redis = redisConnection({ url: process.env.REDIS_URL ?? 'redis://127.0.0.1:6379/1' })
+  app = createApp({
+    db, redis, waGateway: new FakeWaGateway(), waProfile: 'ai-manager', mailer: new MemoryMailer(),
+    trustProxy: true, logger: createLogger({ level: 'silent' }), mcpEnv: { API_PUBLIC_URL: 'https://api.example.test' },
+  })
+  owner = await signUp(1)
+  other = await signUp(2)
+}, 120000)
+
+beforeEach(() => {
+  vi.stubEnv('CRM_SPY_COMPANY_ID', owner.companyId)
+  vi.stubEnv('SPY_API_URL', upstreamUrl)
+  vi.stubEnv('SPY_API_TOKEN', upstreamToken)
+  upstream.mockReset()
+  vi.stubGlobal('fetch', upstream)
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  vi.unstubAllEnvs()
+})
+
+afterAll(async () => {
+  redis?.disconnect()
+  await db?.$client.end()
+  await temp?.drop()
+})
+
+describe('MCP Sondas na API autenticada com upstream WSM simulado', () => {
+  it('encaminha a oferta, o chip e as opções exatas, para a sonda e audita sem tokens', async () => {
+    const { token, mcp_credential } = await credential(owner, 'write')
+    const started = { id: probeId, offerId, sessionId, branch: 'objecao', status: 'ativa' }
+    const stopped = { ...started, status: 'parada' }
+    upstream.mockResolvedValueOnce(Response.json(started, { status: 201 }))
+    upstream.mockResolvedValueOnce(Response.json(stopped))
+
+    expect(content(await invoke(token, 'start_spy_probe', startArgs))).toEqual(started)
+    expect(content(await invoke(token, 'stop_spy_probe', { id: probeId }))).toEqual(stopped)
+    expect(upstream).toHaveBeenCalledTimes(2)
+    expect(upstream).toHaveBeenNthCalledWith(1, `${upstreamUrl}/api/spy/offers/${offerId}/probes`, expect.objectContaining({
+      method: 'POST', redirect: 'error',
+      headers: { authorization: `Bearer ${upstreamToken}`, 'content-type': 'application/json' },
+      body: JSON.stringify({ sessionId, branch: 'objecao', startInMinutes: 25 }),
+    }))
+    expect(upstream).toHaveBeenNthCalledWith(2, `${upstreamUrl}/api/spy/probes/${probeId}/stop`, expect.objectContaining({
+      method: 'POST', headers: { authorization: `Bearer ${upstreamToken}`, 'content-type': 'application/json' }, body: '{}',
+    }))
+
+    const audits = await db.select().from(auditLogs).where(eq(auditLogs.companyId, owner.companyId))
+    expect(audits).toEqual(expect.arrayContaining([
+      expect.objectContaining({ action: 'spy.probe.start', targetType: 'spy_offer', targetId: offerId, detail: expect.objectContaining({ mcp_credential_id: mcp_credential.id }) }),
+      expect.objectContaining({ action: 'spy.probe.stop', targetType: 'spy_probe', targetId: probeId, detail: expect.objectContaining({ mcp_credential_id: mcp_credential.id }) }),
+    ]))
+    expect(JSON.stringify(audits)).not.toContain(token)
+    expect(JSON.stringify(audits)).not.toContain(upstreamToken)
+  })
+
+  it('lista chips com token read e remove campos privados do upstream sem adotar chips no CRM', async () => {
+    const { token } = await credential(owner, 'read')
+    const chip = { session_id: sessionId, name: 'Chip QA', phone: null, status: 'STABLE', sendable: true }
+    upstream.mockResolvedValueOnce(Response.json({
+      items: [{ ...chip, proxy: 'private-proxy-password', profile: 'private-profile', token: upstreamToken }],
+      token: upstreamToken,
+    }))
+    const result = await invoke(token, 'list_spy_chips', {})
+    expect(failed(result)).toBe(false)
+    expect(content(result)).toEqual({ items: [chip] })
+    expect(upstream).toHaveBeenCalledExactlyOnceWith(`${upstreamUrl}/api/spy/chips`, expect.objectContaining({
+      method: 'GET', headers: { authorization: `Bearer ${upstreamToken}` },
+    }))
+    expect(await db.select().from(connections).where(eq(connections.companyId, owner.companyId))).toHaveLength(0)
+  })
+
+  it('nega as duas escritas para token read sem chamar o WSM', async () => {
+    const { token } = await credential(owner, 'read')
+    const listed = await rpc(token, 'tools/list')
+    const names = listed.result!.tools!.map((tool) => tool.name)
+    expect(names).toContain('list_spy_chips')
+    expect(names).not.toContain('start_spy_probe')
+    expect(names).not.toContain('stop_spy_probe')
+    expect(failed(await invoke(token, 'start_spy_probe', startArgs))).toBe(true)
+    expect(failed(await invoke(token, 'stop_spy_probe', { id: probeId }))).toBe(true)
+    expect(upstream).not.toHaveBeenCalled()
+  })
+
+  it('nega leitura e escrita de outra empresa sem chamar o WSM', async () => {
+    const { token } = await credential(other, 'write')
+    for (const [name, args] of [
