+    }
+    expect((await bridge(owner, 'POST', stopPath, '{"unexpected":true}')).status).toBe(422)
+    expect((await bridge(owner, 'POST', stopPath, '{')).status).toBe(400)
+    expect(upstream).not.toHaveBeenCalled()
+  })
+
+  it('retorna falhas de upstream sem divulgar o corpo remoto nem repetir a mutação', async () => {
+    const { token } = await credential(owner, 'write')
+    upstream.mockResolvedValueOnce(Response.json({ error: { message: upstreamToken } }, { status: 409 }))
+    upstream.mockRejectedValueOnce(new Error(upstreamToken))
+    const httpError = await invoke(token, 'start_spy_probe', startArgs)
+    const networkError = await invoke(token, 'stop_spy_probe', { id: probeId })
+    expect(failed(httpError)).toBe(true)
+    expect(content(httpError)).toMatchObject({ status: 409 })
+    expect(failed(networkError)).toBe(true)
+    expect(content(networkError)).toMatchObject({ status: 502, error: { code: 'UPSTREAM_ERROR' } })
+    expect(JSON.stringify([httpError, networkError])).not.toContain(upstreamToken)
+    expect(upstream).toHaveBeenCalledTimes(2)
+  })
+})
