@@ -0,0 +1,21 @@
+ALTER TABLE crm.flow_runs ADD COLUMN offer_scoped boolean NOT NULL DEFAULT false;
+UPDATE crm.flow_runs SET offer_scoped=true WHERE EXISTS (
+ SELECT 1 FROM crm.offer_opportunities o WHERE o.id::text=flow_runs.trigger->>'opportunity_id'
+ AND o.company_id=flow_runs.company_id AND o.chat_id=flow_runs.chat_id AND o.contact_id=flow_runs.contact_id);
+DROP INDEX crm.flow_runs_active_contact_uq;
+DROP INDEX crm.flow_runs_active_chat_uq;
+CREATE UNIQUE INDEX flow_runs_active_contact_uq ON crm.flow_runs(company_id,contact_id)
+ WHERE status IN ('running','waiting') AND NOT offer_scoped;
+CREATE UNIQUE INDEX flow_runs_active_chat_uq ON crm.flow_runs(company_id,chat_id)
+ WHERE status IN ('running','waiting') AND chat_id IS NOT NULL;
+CREATE FUNCTION crm.validate_offer_run_scope() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF NEW.offer_scoped AND NOT EXISTS(SELECT 1 FROM crm.offer_opportunities o
+ WHERE o.id::text=NEW.trigger->>'opportunity_id' AND o.company_id=NEW.company_id
+ AND o.chat_id=NEW.chat_id AND o.contact_id=NEW.contact_id) THEN
+ RAISE EXCEPTION 'invalid offer run scope';
+ END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER validate_offer_run_scope BEFORE INSERT OR UPDATE ON crm.flow_runs
+ FOR EACH ROW EXECUTE FUNCTION crm.validate_offer_run_scope();
