@@ -0,0 +1,15 @@
+/** Server-only opt-in. Names, login claims and client headers never authorize this feature. */
+export function sharedOffersCompany(env: Record<string,string|undefined> = process.env): string | null {
+ const id=env.SHARED_OFFERS_COMPANY_ID;
+ return id && /^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(id) ? id.toLowerCase() : null
+}
+export function isSharedOffersCompany(company: string, env: Record<string,string|undefined> = process.env): boolean {
+ return sharedOffersCompany(env) === company.toLowerCase()
+}
+/** Decorate server-produced company summaries consistently, before any auth response is cached. */
+export function withCompanyCapabilities<T extends { id: string }>(companies: T[]): (T & { shared_offers: boolean })[] {
+ return companies.map(company => ({ ...company, shared_offers: isSharedOffersCompany(company.id) }))
+}
+export function requireSharedOffersCompany(company: string) {
+ if (!isSharedOffersCompany(company)) throw new Error('Shared offers unavailable for this company')
+}
