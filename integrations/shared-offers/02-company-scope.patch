diff --git a/packages/core/src/flows/engine/offer-scope.db.unit.test.ts b/packages/core/src/flows/engine/offer-scope.db.unit.test.ts
new file mode 100644
index 0000000..6f406ec
--- /dev/null
+++ b/packages/core/src/flows/engine/offer-scope.db.unit.test.ts
@@ -0,0 +1,83 @@
+import { randomUUID } from 'node:crypto'
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { companies, contacts, connections, chats, createDb, type Database } from '@crm/db'
+import { createTempDatabase, type TempDatabase } from '@crm/db/testing'
+import { sql } from 'drizzle-orm'
+import { FlowStore } from '../store/store'
+import { FlowEngine } from './runner'
+
+let tmp: TempDatabase, db: Database
+const originalGate = process.env.SHARED_OFFERS_COMPANY_ID
+beforeAll(async () => {
+  tmp = await createTempDatabase({ migrate: true })
+  db = createDb(tmp.url, { max: 10 })
+})
+afterAll(async () => {
+  if (originalGate === undefined) delete process.env.SHARED_OFFERS_COMPANY_ID
+  else process.env.SHARED_OFFERS_COMPANY_ID = originalGate
+  await db?.$client.end()
+  await tmp?.drop()
+})
+
+async function fixture() {
+  const [company] = await db.insert(companies).values({ name: 'Scope fixture', slug: randomUUID() }).returning()
+  process.env.SHARED_OFFERS_COMPANY_ID = company!.id
+  const [contact] = await db.insert(contacts).values({ companyId: company!.id, name: 'Scope contact' }).returning()
+  const conversationIds: string[] = []
+  for (let i = 0; i < 3; i++) {
+    const [connection] = await db.insert(connections).values({ companyId: company!.id, sessionId: randomUUID(), name: `Chip ${i}` }).returning()
+    const [chat] = await db.insert(chats).values({ companyId: company!.id, contactId: contact!.id, connectionId: connection!.id }).returning()
+    conversationIds.push(chat!.id)
+  }
+  const ctx = { companyId: company!.id }, store = new FlowStore(db)
+  const flow = await store.createFlow(ctx, { name: 'Scope flow' })
+  await store.fromDefinition(ctx, flow.id, {
+    schema: 'crm.flow/v1', entry: 'start', nodes: [{ id: 'start', type: 'start', name: 'Start', position: { x: 0, y: 0 }, actions: [] }],
+    edges: [], variables: [], refs: {},
+  })
+  await store.publish(ctx, flow.id)
+  const offer = (await db.execute(sql`insert into crm.offers(company_id,name,config) values(${ctx.companyId},'Scope offer','{}') returning id`)).rows[0]!
+  const ops: string[] = []
+  for (const chat of conversationIds.slice(0, 2)) {
+    const op = (await db.execute(sql`insert into crm.offer_opportunities(company_id,offer_id,contact_id,chat_id,snapshot,evidence)
+      values(${ctx.companyId},${offer.id},${contact!.id},${chat},'{}','{}') returning id`)).rows[0]!
+    ops.push(String(op.id))
+  }
+  // No enqueue: no worker can consume or finish the active runs under test.
+  const engine = new FlowEngine({ db, wa: {} as never })
+  const common = { flowId: flow.id, contactId: contact!.id }
+  const startOffer = (index = 0) => engine.startRun(ctx, { ...common, chatId: conversationIds[index], trigger: { opportunity_id: ops[index] } })
+  const startLegacy = (withChat: boolean) => engine.startRun(ctx, { ...common, ...(withChat ? { chatId: conversationIds[2] } : {}) })
+  const active = async () => (await db.execute(sql`select id,offer_scoped,chat_id from crm.flow_runs where company_id=${ctx.companyId} and status in ('running','waiting')`)).rows
+  return { startOffer, startLegacy, active }
+}
+
+for (const withChat of [true, false]) {
+  it(`offer then legacy (${withChat ? 'chat' : 'no chat'}): second start conflicts by contact`, async () => {
+    const f = await fixture()
+    await f.startOffer()
+    await expect(f.startLegacy(withChat)).rejects.toMatchObject({ code: 'run_active' })
+    expect(await f.active()).toHaveLength(1)
+  })
+  it(`legacy (${withChat ? 'chat' : 'no chat'}) then offer: second start conflicts`, async () => {
+    const f = await fixture()
+    await f.startLegacy(withChat)
+    await expect(f.startOffer()).rejects.toMatchObject({ code: 'run_active' })
+    expect(await f.active()).toHaveLength(1)
+  })
+  it(`concurrent legacy (${withChat ? 'chat' : 'no chat'}) and offer: exactly one running`, async () => {
+    for (let attempt = 0; attempt < 5; attempt++) {
+      const f = await fixture()
+      const result = await Promise.allSettled([f.startOffer(), f.startLegacy(withChat)])
+      expect(result.filter(r => r.status === 'fulfilled')).toHaveLength(1)
+      expect(result.filter(r => r.status === 'rejected')).toHaveLength(1)
+      expect(await f.active()).toHaveLength(1)
+    }
+  })
+}
+it('two offers in different chats can start concurrently; another in the same chat conflicts', async () => {
+  const f = await fixture()
+  await Promise.all([f.startOffer(0), f.startOffer(1)])
+  expect(await f.active()).toHaveLength(2)
+  await expect(f.startOffer(0)).rejects.toMatchObject({ code: 'run_active' })
+})
