+++ b/apps/api/src/routes/auth/shared-offers-profile.db.unit.test.ts
@@ -0,0 +1,128 @@
+import { randomUUID } from 'node:crypto'
+import { createServer } from 'node:http'
+import { readFileSync, existsSync } from 'node:fs'
+import { resolve, extname } from 'node:path'
+import { afterAll, beforeAll, expect, it } from 'vitest'
+import { chromium } from '@playwright/test'
+import { companies, createDb, type Database } from '@crm/db'
+import { createTempDatabase, type TempDatabase } from '@crm/db/testing'
+import { signSsoToken } from '@crm/core'
+import { createLogger, MemoryMailer, redisConnection } from '@crm/node-kit'
+import { createApp, type RedisClient } from '../../app'
+
+let temp: TempDatabase, db: Database, redis: RedisClient, app: ReturnType<typeof createApp>
+let ssoCompany: string
+const previous = process.env.SHARED_OFFERS_COMPANY_ID
+const secret = 'local-only-profile-contract-secret-123456789'
+const headers = { 'content-type': 'application/json', 'x-requested-with': 'crm' }
+const post = (path: string, body: unknown, cookie?: string) => app.request(path, { method: 'POST', headers: { ...headers, ...(cookie ? { cookie } : {}) }, body: JSON.stringify(body) })
+const cookieOf = (res: Response) => res.headers.get('set-cookie')!.split(';')[0]!
+const token = () => {
+  const now = Math.floor(Date.now() / 1000), id = randomUUID()
+  return signSsoToken({ iss: 'ai-manager', aud: 'crm', sub: `ai-manager:${id}`, email: `${id}@example.test`, name: 'SSO fixture', iat: now, exp: now + 120, jti: randomUUID() }, secret)
+}
+const profile = async (cookie: string) => {
+  const res = await app.request('/api/auth/profile', { headers: { cookie } })
+  expect(res.status).toBe(200)
+  return res.json() as Promise<any>
+}
+beforeAll(async () => {
+  temp = await createTempDatabase({ migrate: true })
+  db = createDb(temp.url, { max: 4 })
+  redis = redisConnection({ url: process.env.REDIS_URL ?? 'redis://127.0.0.1:6379/1' })
+  app = createApp({ db, redis, ssoSecret: secret, cookieSecure: false, mailer: new MemoryMailer(), logger: createLogger({ level: 'silent' }) })
+  const [company] = await db.insert(companies).values({ name: 'SSO test company', slug: 'ai-manager' }).returning()
+  ssoCompany = company!.id
+}, 60_000)
+afterAll(async () => {
+  if (previous === undefined) delete process.env.SHARED_OFFERS_COMPANY_ID
+  else process.env.SHARED_OFFERS_COMPANY_ID = previous
+  redis?.disconnect()
+  await db?.$client.end()
+  await temp?.drop()
+})
+
+it('register contract, login, profile and company switch agree on capabilities without changing permissions', async () => {
+  const email = `${randomUUID()}@example.test`, password = 'fixture-password-123'
+  const registered = await post('/api/auth/register', { name: 'Profile fixture', email, password, password_confirmation: password })
+  expect(registered.status).toBe(201)
+  const registration = await registered.json() as any
+  expect(registration.companies).toBeUndefined() // Existing register contract returns user + message.
+  process.env.SHARED_OFFERS_COMPANY_ID = registration.user.last_company_id
+  const loggedIn = await post('/api/auth/login', { email, password })
+  expect(loggedIn.status).toBe(200)
+  const login = await loggedIn.json() as any, cookie = cookieOf(loggedIn)
+  expect(login.companies[0].shared_offers).toBe(true)
+  expect((await profile(cookie)).companies).toEqual(login.companies)
+  const created = await post('/api/companies', { name: 'Other fixture company' }, cookie)
+  expect(created.status).toBe(201)
+  const other = (await created.json() as any).company
+  expect((await post(`/api/companies/${other.id}/switch`, {}, cookie)).status).toBe(200)
+  const switched = await profile(cookie)
+  expect(switched.user.last_company_id).toBe(other.id)
+  expect(switched.companies.find((c: any) => c.id === other.id).shared_offers).toBe(false)
+  expect(switched.companies.find((c: any) => c.id === registration.user.last_company_id).shared_offers).toBe(true)
+  const loggedInAgain = await post('/api/auth/login', { email, password })
+  expect((await loggedInAgain.json() as any).companies).toEqual(switched.companies)
+})
+
+it('first SSO response already matches profile; disabled and invalid configuration return explicit false', async () => {
+  for (const setting of [ssoCompany, '', 'invalid']) {
+    process.env.SHARED_OFFERS_COMPANY_ID = setting
+    const response = await post('/api/auth/sso', { token: token() })
+    expect(response.status).toBe(200)
+    const sso = await response.json() as any
+    expect(sso.companies[0].shared_offers).toBe(setting === ssoCompany)
+    expect((await profile(cookieOf(response))).companies).toEqual(sso.companies)
+    expect(sso.companies[0].effective_permissions).toContain('settings.products.view')
+  }
+})
+
+it('browser first SSO shows offers immediately for the target and denies a different target without forced refetch', async () => {
+  const root = resolve('../web/dist')
+  const server = createServer(async (req, res) => {
+    try {
+      if (req.url?.startsWith('/api/')) {
+        const chunks: Buffer[] = []
+        for await (const chunk of req) chunks.push(Buffer.from(chunk))
+        const response = await app.request(req.url, { method: req.method, headers: req.headers as Record<string, string>, ...(!['GET', 'HEAD'].includes(req.method!) ? { body: Buffer.concat(chunks) } : {}) })
+        res.writeHead(response.status, Object.fromEntries(response.headers.entries()))
+        res.end(Buffer.from(await response.arrayBuffer()))
+        return
+      }
+      const path = resolve(root, '.' + new URL(req.url!, 'http://local').pathname)
+      const file = path.startsWith(root) && existsSync(path) && extname(path) ? path : resolve(root, 'index.html')
+      res.setHeader('content-type', extname(file) === '.js' ? 'text/javascript' : extname(file) === '.css' ? 'text/css' : 'text/html')
+      res.end(readFileSync(file))
+    } catch { res.statusCode = 500; res.end('test server failure') }
+  })
+  await new Promise<void>(r => server.listen(0, '127.0.0.1', r))
+  const base = `http://127.0.0.1:${(server.address() as { port: number }).port}`
+  const browser = await chromium.launch({ headless: true })
+  try {
+    for (const authorized of [true, false]) {
+      process.env.SHARED_OFFERS_COMPANY_ID = authorized ? ssoCompany : randomUUID()
+      const context = await browser.newContext()
+      const page = await context.newPage()
+      const ssoResponse = page.waitForResponse(r => r.url().endsWith('/api/auth/sso'))
+      await page.goto(`${base}/auth/sso#token=${token()}`)
+      const response = await ssoResponse
+      expect(response.status()).toBe(200)
+      expect((await response.json()).companies[0].shared_offers).toBe(authorized)
+      await page.getByTestId('nav-item-chats').waitFor()
+      if (authorized) {
+        await page.getByTestId('nav-item-offers').click()
+        await page.getByRole('heading', { name: 'Ofertas compartilhadas' }).waitFor()
+      } else {
+        expect(await page.getByTestId('nav-item-offers').count()).toBe(0)
+        await page.goto(`${base}/offers`)
+        await page.getByRole('alert').filter({ hasText: 'Ofertas indispon' }).waitFor()
+      }
+      await context.close()
+    }
+  } finally {
+    await browser.close()
+    server.closeAllConnections()
+    await new Promise<void>(r => server.close(() => r()))
+  }
+}, 60_000)
